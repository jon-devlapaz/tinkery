with_origin(a, context, None)\n    }\n\n    /// Bind an already owned staging session; never choose a replacement destination.\n    pub(super) fn at(root: PathBuf, session: PathBuf) -> Self {\n        Self {\n            root: Ok(root),\n            session: Arc::new(Mutex::new(Some(session))),\n        }\n    }\n\n    /// Save confirmation and optional checked creation evidence in the same ledger publication.\n    pub(super) fn confirm_with_origin(\n        &self,\n        a: Affirmed,\n        context: &crate::think_record::GoalConfirmation,\n        creation: Option<&super::connection::Origin>,\n    ) -> Result<Receipt, String> {\n        if let Some(origin) = creation {\n            origin.validate(&a.goal)?;\n        }\n        let actor = crate::think_record::Actor::authorize(Some(context))?;\n        let delegation = actor.delegation();\n        let root = self.root.as_ref().map_err(Clone::clone)?;\n        let stamp = super::answering::now();\n        let mut retained = self\n            .session\n            .lock()\n            .map_err(|_| \"The save state is unavailable. Reopen Think.\")?;\n        if retained.is_none() {\n            *retained = Some(super::ledger::initialize_for(root, &stamp, actor)?);\n        }\n        let session = retained\n            .as_ref()\n            .ok_or(\"The session was not created. Retry saving.\")?;\n        let current = super::ledger::load(session).map_err(\n            |_| \"The session could not be read. Inspect the recovery session before retrying.\",\n        )?;\n        if current[\"status\"].string() != Some(\"active\")\n            || current[\"operator\"].string() != Some(actor.session_operator())\n        {\n            return Err(\"Session is not active for this actor; nothing overwritten.\".into());\n        }\n        if session.join(\"seed-contract.md\").exists() {\n            return Err(\"A seed file already exists; reopen this session in Shape.\".into());\n        }\n        if current[\"origin\"] == super::ledger::Value::Null {\n            let mut evidence = a.originals.iter().map(|s| json!({\"checked\":s.label(),\"at\":stamp,\"observed\":s.text}))\n                .chain(std::iter::once(json!({\"checked\":\"Tinkery answer/question context; questions remain provisional, not settled decisions\",\"at\":stamp,\"observed\":a.context}))).collect::<Vec<_>>();\n            if let Some(creation) = creation {\n                evidence.push(json!({\"artifact\":creation.artifact(),\n                    \"checked\":\"Created from a Tend connection; interpretation remains provisional\",\n                    \"at\":stamp,\"observed\":serde_json::to_string(creation).map_err(|e| e.to_string())?}));\n            }\n            let mut state = json!({\"status\":\"active\", \"draft\":{\"goal\":a.goal,\"outcome\":a.outcome,\n                \"options\":a.options.iter().map(|o|format!(\"{} — benefit: {}; cost: {}; undo cost: {}\",o.label,o.benefit,o.cost,o.undo_cost)).collect::<Vec<_>>()},\n                \"goal\":a.goal,\"origin\":\"goal\",\"current_question\":null,\"nodes\":[{\"id\":\"goal\",\"kind\":\"decision\",\"status\":\"settled\",\n                \"prerequisites\":[],\"evidence\":evidence,\"owner\":\"User\",\"gate\":\"Explicit affirmation of the complete displayed goal; not seed or implementation approval\",\n                \"answer\":a.goal,\"authority\":\"user\",\"authority_source\":a.source}],\"assumed\":[],\"operator\":actor.session_operator()});\n            let origin = &mut state[\"nodes\"][0];\n            origin[\"authority\"] = actor.authority().into();\n            if let Some(delegation) = &delegation {\n                origin[\"owner\"] = delegation[\"agent\"].clone();\n                origin[\"delegation\"] = delegation.clone();\n            }\n            super::ledger::publish(session, &super::ledger::Value::from(state), &current[\"version\"],\n                &actor.reason(\"confirmed the displayed goal in Tinkery.\").as_str().into(), None, &stamp)\n                .map_err(|_| \"The goal save could not be verified. Inspect the recovery session before retrying.\")?;\n        }\n        let read = super::ledger::load(session).map_err(|_| {\n            \"The saved goal could not be read back. Inspect the recovery session before retrying.\"\n        })?;\n        let origin = read[\"nodes\"]\n            .array()\n            .unwrap_or(&[])\n            .iter()\n            .find(|n| n[\"id\"] == read[\"origin\"])\n            .ok_or(\"The saved goal has no origin. Inspect the recovery session.\")?;\n        if read[\"goal\"].string() != Some(a.goal.as_str())\n            || origin[\"answer\"].string() != Some(a.goal.as_str())\n            || origin[\"authority\"].string() != Some(actor.authority())\n            || origin.get(\"delegation\")\n                != delegation\n                    .as_ref()\n                    .map(|d| super::ledger::Value::from(d.clone()))\n                    .as_ref()\n            || origin[\"status\"].string() != Some(\"settled\")\n            || origin[\"authority_source\"].string() != Some(a.source.as_str())\n        {\n            return Err(\"This session already pins another goal. No origin was replaced.\".into());\n        }\n        for original in &a.originals {\n            if !origin[\"evidence\"]\n                .array()\n                .unwrap_or(&[])\n\n[86 more lines in file. Use offset=270 to continue.]"}],"isError":false,"durationMs":2,"timestamp":1794732080109},{"role":"assistant","content":[{"type":"thinking","thinking":"**Updating goal extraction**\n\n**Fixing goal extraction**","thinkingSignature":"{\"type\":\"reasoning\",\"id\":\"rs_0df587760909a640016af97031b45887d1a9809165f50b6dfe\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"**Updating goal extraction**\"},{\"type\":\"summary_text\",\"text\":\"**Fixing goal extraction**\"}],\"content\":[],\"encrypted_content\":\"gAAAAABq-XBB9pmwvSZrfiV5k6S1TU0vTN6_K1yJR_BzjLhv22VoSI4rezC_0FCbnNrPbbAaZMQ05CHCfpqv