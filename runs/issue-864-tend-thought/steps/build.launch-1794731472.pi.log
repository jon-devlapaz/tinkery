rts work.\\n\\nmod place;\\nmod retry;\\nmod worker;\\n\\npub use place::{PLACES, Place};\\n\\nuse std::{\\n    path::{Path, PathBuf},\\n    sync::Arc,\\n    time::{Duration, Instant},\\n};\\n\\nuse crate::{\\n    Palette, approve, measure, seed_me,\\n    shape::{Leave, Shape},\\n    taste::Taste,\\n    tend::{self, Discovery, Source, Tend},\\n    think::brain_dump::{self, BrainDump, Exit},\\n    watch::Watch,\\n};\\nuse crossterm::event::{\\n    KeyCode, KeyEvent, KeyEventKind, KeyModifiers, MouseButton, MouseEvent, MouseEventKind,\\n};\\nuse ratatui::{\\n    Frame,\\n    layout::Rect,\\n    text::{Line, Span},\\n    widgets::{Block, Borders, Clear, Padding, Paragraph, Wrap},\\n};\\n\\nconst FIRST_ROW: u16 = 4;\\nconst ROW_GAP: u16 = 2;\\n\\n/// The menu and whichever place is open in it. It routes input to the open place and owns what\\n/// outlives a visit: the key bar preference, receipts to print on exit, and the one session\\n/// scan tend reads from. A place returns here by its own exit; nothing opens by itself.\\npub struct Home {\\n    /// The operator chose to leave Tinkery; the terminal loop stops after this tick.\\n    pub quit: bool,\\n    make_dump: Box<dyn Fn() -> BrainDump>,\\n    sessions_root: Option<PathBuf>,\\n    link_root: Result<PathBuf, String>,\\n    selected: Place,\\n    view: View,\\n    help: bool,\\n    /// The muted key bar preference lasts the session, across visits to think.\\n    key_bar: bool,\\n    receipts: Vec<seed_me::ExitReceipt>,\\n    discovery: Discovery,\\n    record_root: Result<PathBuf, String>,\\n    history_reader: tend::history::Reader,\\n    repo: Option<crate::repo::Repo>,\\n    shape_agent: Option<Arc<crate::shape::Agent>>,\\n    sdlc_root: Option<PathBuf>,\\n    codex_report: Option<crate::watch::CodexReport>,\\n    /// An agent launch without --shape-pi: Shape only reads.\\n    shape_held: bool,\\n    /// Launched with `--operator agent`; Taste then refuses the operator's labels.\\n    agent: bool,\\n    approve_reader: approve::Reader,\\n    approve_origin: Option<ApproveOrigin>,\\n    /// `m` on the menu asked for the Model panel, which the launch owns.\\n    model_request: bool,\\n    worker_config: Option<crate::worker::Config>,\\n    worker_authorization: Result<Option<crate::worker::Relay>, String>,\\n    worker_panel: Option<worker::Panel>,\\n    quit_after_worker: bool,\\n    connection: Option<tend::connection::Panel>,\\n}\\n\\nenum View {\\n    Menu,\\n    Think(Box<BrainDump>),\\n    Tend(Box<Tend>),\\n    /// Shape, and the tend it was opened from, restored as it was when Shape is left.\\n    Shape(Box<Shape>, Option<Box<Tend>>),\\n    Approve(Box<approve::Approve>),\\n    Worker,\\n    Measure(Box<measure::Measure>),\\n    Watch(Box<Watch>),\\n    Taste(Box<Taste>),\\n    Retry(Box<retry::Review>, Box<Taste>),\\n}\\n\\n/// Only the deliberate Shape-to-Approve visit returns here; F10 discards it for Home.\\nstruct ApproveOrigin {\\n    shape: Box<Shape>,\\n    tend: Option<Box<Tend>>,\\n    selected: Place,\\n}\\n\\nimpl Home {\\n    /// A menu on its first row. `make_dump` makes a fresh think each time think is opened;\\n    /// tend reads the selected sessions root or shows its refusal without scanning. Links use\\n    /// the separate captured `link_root` (or its refusal).\\n    pub fn new(\\n        make_dump: Box<dyn Fn() -> BrainDump>,\\n        sessions_root: Result<PathBuf, String>,\\n        link_root: Result<PathBuf, String>,\\n    ) -> Self {\\n        let (sessions_root, discovery) = match sessions_root {\\n            Ok(root) => (Some(root), Discovery::new(Arc::new(tend::scan))),\\n            Err(reason) => (None, Discovery::unavailable(reason)),\\n        };\\n        Self {\\n            quit: false,\\n            make_dump,\\n            sessions_root,\\n            link_root,\\n            selected: Place::Think,\\n            view: View::Menu,\\n            help: false,\\n            key_bar: true,\\n            receipts: Vec::new(),\\n            discovery,\\n            record_root: crate::think_record::default_root(std::env::var_os(\\\"HOME\\\").as_deref()),\\n            history_reader: tend::history::Reader::default(),\\n            repo: None,\\n            shape_agent: None,\\n            sdlc_root: None,\\n            codex_report: None,\\n            shape_held: false,\\n            agent: false,\\n            approve_reader: approve::Reader::default(),\\n            approve_origin: None,\\n            model_request: false,\\n            worker_config: None,\\n            worker_authorization: Ok(None),\\n            worker_panel: None,\\n            quit_after_worker: false,\\n            connection: None,\\n        }\\n    }\\n\\n    /// The model Shape answers and drafts through; without one, Shape only reads. Starts nothing.\\n    pub fn with_shape_agent(mut self, agent: Option<Arc<crate::shape::Agent>>) -> Self {\\n        self.shape_agent = agent;\\n        self\\n    }\\n\\n    /// The one tink-sdlc checkout the read-only run views use; absent roots explain configuration.\\n    pub fn with_sdlc_root(mut self, root: Option<PathBuf>) -> Self {\\n        self.sdlc_root = root;\\n        self\\n    }\\n\\n    /// Show one explicitly bound saved Codex report in Watch; it grants no execution authority.\\n    pub fn with_codex_report(mut self, report: Option<crate::watch::CodexReport>) -> Self {\\n        self.codex_report = report;\\n        self\\n    }\\n\\n    /// An agent launch without named context only reads; see [`Shape::held`].\\n    pub fn with_shape_held(mut self, held: bool) -> Self {\\n        self.shape_held = held;\\n\\n[2033 more lines in file. Use offset=161 to continue.]\"}\n==> text 2/11 <==\n{\"p\":\"src/menu.rs\",\"content\":\"            && self.discovery.fresh()\\n            && let Some(landed) = self.discovery.landed()\\n        {\\n            let (sessions, unavailable, reasons) = match &landed.outcome {\\n                Ok(found) => (\\n                    Ok(found.sessions.clone()),\\n                    found.unreadable,\\n                    found\\n                        .failures\\n                        .iter()\\n                        .map(|f| format!(\\\"{}: {}\\\", f.path.display(), f.reason))\\n                        .collect(),\\n                ),\\n                Err(reason) => (Err(reason.clone()), 0, Vec::new()),\\n            };\\n            view.offer(\\n                sessions,\\n                unavailable,\\n                reasons,\\n                &mut self.approve_reader,\\n                self.record_root.clone(),\\n                self.worker_config.as_ref().map(|config| config.responses),\\n            );\\n        }\\n    }\\n\\n    /// Let tend say when the read it waits on is taking a while. A check on the tick that\\n    /// already runs: no timer, no new worker.\\n    fn update_stall(&mut self, now: Instant) {\\n        if let View::Tend(tend) = &mut self.view {\\n            tend.note_wait(\\n                self.discovery\\n                    .running_since()\\n                    .map(|since| now.saturating_duration_since(since)),\\n            );\\n        }\\n    }\\n\\n    /// Read once and wait a bounded time, for the non-interactive `--snapshot` view only.\\n    pub fn discover_for_snapshot(&mut self, wait: Duration) {\\n        if self.sessions_root.is_none() {\\n            return;\\n        }\\n        self.request_sessions();\\n        let deadline = Instant::now() + wait;\\n        while !self.discovery.poll() && Instant::now() < deadline {\\n            std::thread::sleep(Duration::from_millis(1));\\n        }\\n    }\\n\\n    fn request_sessions(&mut self) {\\n        self.discovery.scope_to_repo(\\n            self.repo.as_ref().map(|repo| repo.root().to_path_buf()),\\n            self.record_root.clone(),\\n        );\\n        if let Some(root) = &self.sessions_root {\\n            self.discovery.request(root);\\n        }\\n    }\\n\\n    fn open_tend_session(&mut self, path: &Path) {\\n        self.open(Place::Tend);\\n        if let View::Tend(tend) = &mut self.view {\\n            // One stat of a path the handoff just wrote; matching is otherwise by identity.\\n            tend.want = Some((path.to_path_buf(), path.canonicalize().ok()));\\n            tend.seen = 0;\\n        }\\n        self.sync_tend();\\n    }\\n\\n    /// Receipts from confirmed goals, printed after the terminal is restored.\\n    pub fn finish(&mut self) -> Option<String> {\\n        if let View::Think(dump) = &mut self.view\\n            && let Some(receipt) = dump.finish_handoff()\\n        {\\n            self.receipts.push(receipt);\\n        }\\n        (!self.receipts.is_empty()).then(|| {\\n            self.receipts\\n                .iter()\\n                .map(seed_me::ExitReceipt::text)\\n                .collect::<Vec<_>>()\\n                .join(\\\"\\\\n\\\")\\n        })\\n    }\\n\\n    /// Paste literal words into the active editor. Pasting never submits, saves or launches.\\n    pub fn paste(&mut self, text: &str) {\\n        if let Some(panel) = &mut self.connection {\\n            panel.paste(text);\\n            return;\\n        }\\n        match &mut self.view {\\n            View::Think(dump) => dump.paste(text),\\n            View::Shape(shape, _) if !self.help => shape.paste(text),\\n            View::Taste(taste) if !self.help => taste.paste(text),\\n            _ => {}\\n        }\\n    }\\n\\n    /// Text the open place asked to copy, taken once. The terminal loop does the copying and\\n    /// reports back through [`Home::copy_result`].\\n    pub fn take_copy_request(&mut self) -> Option<String> {\\n        match &mut self.view {\\n            View::Think(dump) => dump.take_copy_request(),\\n            View::Approve(view) => view.take_copy_request(),\\n            View::Taste(view) => view.take_copy_request(),\\n            _ => None,\\n        }\\n    }\\n\\n[1734 more lines in file. Use offset=460 to continue.]\"}\n==> text 3/11 <==\n{\"p\":\"src/menu.rs\",\"content\":\"                    worker::Destination::Taste(root) => {\\n                        View::Taste(Box::new(Taste::open(Some(root), self.agent)))\\n                    }\\n                };\\n            }\\n            return;\\n        }\\n        if !self.help\\n            && key.kind == KeyEventKind::Press\\n            && key.modifiers == KeyModifiers::NONE\\n            && key.code == KeyCode::Char('b')\\n            && let View::Watch(watch) = &self.view\\n            && let Some(run) = watch.worker_run()\\n        {\\n            if !self.worker_busy() {\\n                self.worker_panel = Some(worker::Panel::existing(run, self.worker_gate()));\\n            }\\n            self.view = View::Worker;\\n            return;\\n        }\\n        if let Some(panel) = &mut self.connection {\\n            if panel.key(key) {\\n                self.connection = None;\\n            }\\n            return;\\n        }\\n        if key.kind == KeyEventKind::Press\\n            && key.modifiers == KeyModifiers::NONE\\n            && key.code == KeyCode::Char('f')\\n            && let View::Tend(tend) = &mut self.view\\n            && !tend.detail\\n            && !self.help\\n        {\\n            if !tend.connection_scope() {\\n                tend.notice =\\n                    \\\"Find connections is available only in this repository's garden.\\\".into();\\n                return;\\n            }\\n            let context = (|| {\\n                let sessions = self\\n                    .sessions_root\\n                    .clone()\\n                    .ok_or(\\\"The sessions folder is unavailable.\\\")?;\\n                let records = self.record_root.clone()?;\\n                let store = self.link_root.clone()?;\\n                let repo = self\\n                    .repo\\n                    .as_ref()\\n                    .ok_or(\\\"Open Tinkery inside a repository first.\\\")?\\n                    .root()\\n                    .to_path_buf();\\n                let drafting = self.shape_agent.as_ref().map(|agent| agent.drafting());\\n                let mut actor = drafting\\n                    .as_ref()\\n                    .and_then(|(_, _, actor)| actor.clone())\\n                    .unwrap_or_else(|| crate::think_record::GoalConfirmation::Terminal {\\n                        declaration: if self.agent {\\n                            \\\"declared: agent\\\"\\n                        } else {\\n                            \\\"not declared\\\"\\n                        }\\n                        .into(),\\n                        action: \\\"pressed F2 to save the displayed Tend goal\\\".into(),\\n                        identity: \\\"declaration is not verified identity\\\".into(),\\n                    });\\n                if let crate::think_record::GoalConfirmation::Terminal { action, .. } = &mut actor {\\n                    *action = \\\"pressed F2 to save the displayed Tend goal\\\".into();\\n                }\\n                Ok::<_, String>(tend::connection::Context {\\n                    sessions,\\n                    records,\\n                    store,\\n                    repo,\\n                    call: drafting.map(|(call, budget, _)| (call, budget)),\\n                    actor,\\n                })\\n            })();\\n            match context {\\n                Ok(context) => self.connection = Some(tend::connection::Panel::open(context)),\\n                Err(reason) => tend.notice = reason,\\n            }\\n            return;\\n        }\\n        if let View::Think(dump) = &mut self.view {\\n            dump.handle_key(key);\\n            return;\\n        }\\n        if matches!(self.view, View::Tend(_)) {\\n            let shifted_view_key = key.modifiers == KeyModifiers::SHIFT\\n                && matches!(\\n                    key.code,\\n                    KeyCode::Char('H' | 'J' | 'K' | 'L' | '+' | '=' | '-')\\n                );\\n            if key.modifiers != KeyModifiers::NONE && !shifted_view_key\\n                || key.kind == KeyEventKind::Repeat\\n                    && matches!(\\n                        key.code,\\n                        KeyCode::Char('a' | 'c' | 'r' | 'l' | 's')\\n                            | KeyCode::F(1)\\n                            | KeyCode::F(10)\\n\\n[1504 more lines in file. Use offset=690 to continue.]\"}\n==> text 4/11 <==\n{\"p\":\"src/menu.rs\",\"content\":\"                KeyCode::Char('b')\\n                    if self.worker_panel.is_some()\\n                        && key.kind == KeyEventKind::Press\\n                        && key.modifiers == KeyModifiers::NONE =>\\n                {\\n                    self.view = View::Worker;\\n                }\\n                _ => {}\\n            },\\n            View::Tend(tend) => match key.code {\\n                KeyCode::Char('a') => tend.toggle_scope(),\\n                KeyCode::Char('l') => tend.start_link(),\\n                KeyCode::Esc if tend.is_linking() => tend.cancel_link(),\\n                KeyCode::Enter if tend.is_linking() => tend.commit_link(),\\n                KeyCode::Esc if tend.detail => {\\n                    tend.detail = false;\\n                    tend.want = None;\\n                    tend.scroll = 0;\\n                    tend.notice.clear();\\n                }\\n                KeyCode::Esc => self.view = View::Menu,\\n                KeyCode::Char('s')\\n                    if tend.detail && tend.current().is_some_and(|s| s.stage.can_shape()) =>\\n                {\\n                    let shape = Shape::session(&tend.current().unwrap().path)\\n                        .with_agent(self.shape_agent.clone())\\n                        .held(self.shape_held);\\n                    let View::Tend(tend) = std::mem::replace(&mut self.view, View::Menu) else {\\n                        unreachable!()\\n                    };\\n                    self.view = View::Shape(Box::new(shape), Some(tend));\\n                }\\n                KeyCode::Down | KeyCode::Char('j') if tend.detail => {\\n                    tend.scroll = tend.scroll.saturating_add(1)\\n                }\\n                KeyCode::Up | KeyCode::Char('k') if tend.detail => {\\n                    tend.scroll = tend.scroll.saturating_sub(1)\\n                }\\n                KeyCode::PageDown if tend.detail => {\\n                    tend.scroll = tend.scroll.saturating_add(crate::page(tend.page))\\n                }\\n                KeyCode::PageUp if tend.detail => {\\n                    tend.scroll = tend.scroll.saturating_sub(crate::page(tend.page))\\n                }\\n                KeyCode::Right | KeyCode::Down | KeyCode::Char('j') if tend.garden_showing() => {\\n                    tend.step_selection(true)\\n                }\\n                KeyCode::Left | KeyCode::Up | KeyCode::Char('k') if tend.garden_showing() => {\\n                    tend.step_selection(false)\\n                }\\n                KeyCode::Char(c @ ('+' | '=' | '-' | 'H' | 'J' | 'K' | 'L'))\\n                    if tend.garden_showing() =>\\n                {\\n                    tend.adjust_view(c);\\n                }\\n                KeyCode::Enter if tend.garden_showing() => {\\n                    tend.detail = true;\\n                    tend.scroll = 0;\\n                    tend.notice.clear();\\n                }\\n                _ => {}\\n            },\\n            View::Measure(measure) => {\\n                if self.help {\\n                    if key.code == KeyCode::Char('q') {\\n\\n[1259 more lines in file. Use offset=935 to continue.]\"}\n==> text 5/11 <==\n{\"p\":\"src/menu.rs\",\"content\":\"    }\\n\\n    /// Opens a place. Opening tend asks for a fresh scan; opening never starts an agent.\\n    pub fn open(&mut self, place: Place) {\\n        if self.quit {\\n            return;\\n        }\\n        self.history_reader.cancel();\\n        self.approve_reader.cancel();\\n        self.approve_origin = None;\\n        self.selected = place;\\n        self.help = false;\\n        self.view = match place {\\n            Place::Think => View::Think(Box::new((self.make_dump)().with_key_bar(self.key_bar))),\\n            Place::Tend => {\\n                // Deliberate reopening reads again; the last result shows meanwhile.\\n                self.request_sessions();\\n                View::Tend(Box::new(Tend::new(self.link_root.clone())))\\n            }\\n            Place::Shape => {\\n                self.request_sessions();\\n                View::Shape(\\n                    Box::new(\\n                        Shape::list()\\n                            .with_agent(self.shape_agent.clone())\\n                            .held(self.shape_held),\\n                    ),\\n                    None,\\n                )\\n            }\\n            Place::Approve => {\\n                self.request_sessions();\\n                View::Approve(Box::new(approve::Approve::open(self.sdlc_root.clone())))\\n            }\\n            Place::Watch => View::Watch(Box::new(\\n\\n[1679 more lines in file. Use offset=515 to continue.]\"}\n==> text 6/11 <==\n{\"p\":\"src/tend/connection.rs\",\"content\":\"//! One explicit connection discovery and its latest durable result. Source selection is automatic,\\n//! requests have no tools, and only the shared saver creates a confirmed goal.\\n\\nmod correction;\\nmod panel;\\nuse crate::{\\n    pi::{Call, CallBudget, Request},\\n    seed_me::{\\n        self,\\n        connection::{Correction, Origin, Source, Support},\\n        connection_save::Pending,\\n    },\\n    think_record::{self, GoalConfirmation, MadeIn},\\n};\\npub(crate) use panel::Panel;\\nuse serde::{Deserialize, Serialize};\\nuse sha2::{Digest, Sha256};\\nuse std::{\\n    fs,\\n    io::{Read, Write},\\n    path::PathBuf,\\n    sync::{Arc, atomic::AtomicBool},\\n};\\n\\nconst PROMPT: &str = include_str!(\\\"connection-prompt.txt\\\");\\nconst LIMIT: usize = 32 * 1024;\\nconst RECORD_LIMIT: usize = 256 * 1024;\\n\\n/// Captured launch destinations and shared drafting allowance. No phase object crosses this boundary.\\n#[derive(Clone)]\\npub(crate) struct Context {\\n    pub(crate) sessions: PathBuf,\\n   …2012 tokens truncated…), start)..raw_offset(self.text(), end)]\\n                            .into();\\n                    }\\n                    if key.code == KeyCode::Char('c') {\\n                        return;\\n                    }\\n                }\\n                KeyCode::Char('y') => {\\n                    self.insert(&self.yank.clone());\\n                    return;\\n                }\\n                _ => {}\\n            }\\n        }\\n        let before = self.state.clone();\\n        let (start, end) = self.range();\\n        let old: Vec<char> = display(&before.raw).chars().collect();\\n        if self.state.editor.input(key) {\\n            let new: Vec<char> = self.state.editor.lines().join(\\\"\\\\n\\\").chars().collect();\\n            let cursor = self.state.editor.cursor();\\n            let cursor = self.offset((cursor.0, cursor.1));\\n            // Bound the diff by the selection/caret: identical neighbouring newlines must not\\n            // move an edit onto a different original CR or CRLF.\\n            let prefix = old\\n                .iter()\\n                .zip(&new)\\n                .take(start.min(cursor))\\n                .take_while(|(a, b)| a == b)\\n                .count();\\n            let suffix = old[prefix..]\\n                .iter()\\n                .rev()\\n                .zip(new[prefix..].iter().rev())\\n                .take((old.len() - end).min(new.len() - cursor))\\n                .take_while(|(a, b)| a == b)\\n                .count();\\n            let replacement: String = new[prefix..new.len() - suffix].iter().collect();\\n            let from = raw_offset(&before.raw, prefix);\\n            let to = raw_offset(&before.raw, old.len() - suffix);\\n            if from < to && display(&before.raw[from..to]) == self.state.editor.yank_text() {\\n                self.yank = before.raw[from..to].into();\\n            }\\n            self.state.raw.replace_range(from..to, &replacement);\\n            self.resync(from + replacement.len());\\n            self.remember(before);\\n        }\\n    }\\n\\n    // An edit can bring a CR and LF together across its boundary. Their raw bytes stay, but\\n    // they now display as one newline, so rebuild the projection and follow the raw caret.\\n    fn resync(&mut self, mut cursor: usize) {\\n        if display(self.text()) == self.state.editor.lines().join(\\\"\\\\n\\\") {\\n            return;\\n        }\\n\\n[65 more lines in file. Use offset=171 to continue.]\"}\n==> text 8/11 <==\n{\"p\":\"src/tend/connection/correction.rs\",\"content\":\"//! One explicit repository correction. Reads never repair data; replacement refuses stale views,\\n//! unsafe paths and pending goal handoffs. Stored guidance grants no execution authority.\\n\\nuse super::*;\\nuse std::os::unix::fs::{MetadataExt, OpenOptionsExt};\\n\\nconst FILE_LIMIT: usize = 16 * 1024;\\n\\n/// A bounded read and local change token. Invalid regular files can be explicitly cleared.\\n#[derive(Clone, Debug, PartialEq, Eq)]\\npub(super) struct Snapshot {\\n    digest: Option<[u8; 32]>,\\n    value: Result<Option<Correction>, String>,\\n}\\n\\nimpl Snapshot {\\n    pub(super) fn value(&self) -> Result<Option<Correction>, String> {\\n        self.value.clone()\\n    }\\n}\\n\\n#[derive(Deserialize, Serialize)]\\n#[serde(deny_unknown_fields)]\\nstruct Stored {\\n    schema: u8,\\n    repo: PathBuf,\\n    correction: serde_json::Value,\\n}\\n\\nimpl Context {\\n    fn correction_file(&self) -> PathBuf {\\n        self.file().with_extension(\\\"correction.json\\\")\\n    }\\n\\n    pub(super) fn correction(&self) -> Result<Snapshot, String> {\\n        let file = fs::OpenOptions::new()\\n            .read(true)\\n            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)\\n            .open(self.correction_file());\\n        let file = match file {\\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {\\n                return Ok(Snapshot {\\n                    digest: None,\\n                    value: Ok(None),\\n                });\\n            }\\n            Err(e) => return Err(format!(\\\"The correction cannot be read safely: {e}\\\")),\\n            Ok(file) => file,\\n        };\\n        if !file.metadata().map_err(|e| e.to_string())?.is_file() {\\n            return Err(\\\"The correction is not a regular local file.\\\".into());\\n        }\\n        // Oversized records remain clearable, without reading an unbounded file.\\n        let meta = file.metadata().map_err(|e| e.to_string())?;\\n        let mut digest = Sha256::new();\\n        let mut bytes = Vec::new();\\n        file.take(FILE_LIMIT as u64 + 1)\\n            .read_to_end(&mut bytes)\\n            .map_err(|e| e.to_string())?;\\n        digest.update(&bytes);\\n        for part in [\\n            meta.dev(),\\n            meta.ino(),\\n            meta.len(),\\n            meta.mtime() as u64,\\n            meta.mtime_nsec() as u64,\\n            meta.ctime() as u64,\\n            meta.ctime_nsec() as u64,\\n        ] {\\n            digest.update(part.to_le_bytes());\\n        }\\n        let value = (|| {\\n            if bytes.len() > FILE_LIMIT {\\n                return Err(\\n                    \\\"The correction file is oversized. Clear it explicitly or restore it.\\\".into(),\\n                );\\n            }\\n            let stored: Stored = serde_json::from_slice(&bytes)\\n                .map_err(|_| \\\"The correction is malformed. Clear it explicitly or restore it.\\\")?;\\n            if stored.schema != 1 || stored.repo != self.repo {\\n                return Err(\\\"The correction has another repository or format. Clear it explicitly or restore it.\\\".into());\\n            }\\n            if stored.correction.is_null() {\\n                return Ok(None);\\n            }\\n            let correction: Correction = serde_json::from_value(stored.correction).map_err(\\n                |_| \\\"The correction words are malformed. Clear it explicitly or restore it.\\\",\\n            )?;\\n            correction.validate()?;\\n            Ok(Some(correction))\\n        })();\\n        Ok(Snapshot {\\n            digest: Some(digest.finalize().into()),\\n            value,\\n        })\\n    }\\n\\n    pub(super) fn correct(\\n        &self,\\n        shown: &Snapshot,\\n        proposal: Option<&Record>,\\n        words: Option<&str>,\\n    ) -> Result<(), String> {\\n        let _lock = self.lock()?;\\n        if self.correction()?.digest != shown.digest {\\n            return Err(\\n                \\\"The correction changed. Reopen it before replacing or clearing it.\\\".into(),\\n            );\\n        }\\n        let current = self.read()?;\\n        if current\\n            .as_ref()\\n            .is_some_and(|r| r.pending.is_some() && r.saved.is_none())\\n        {\\n            return Err(\\n                \\\"Resume or cancel the pending goal save before changing the correction.\\\".into(),\\n            );\\n        }\\n        let correction = if let Some(words) = words {\\n            // New guidance must come from an explicitly reviewed proposal. Replacement uses its shown revision.\\n            if shown.value()?.is_none()\\n                && (proposal.is_none()\\n                    || current.as_ref() != proposal\\n                    || proposal.is_none_or(|r| r.proposal.is_none()))\\n            {\\n                return Err(\\\"Review a connection before saving a correction.\\\".into());\\n            }\\n            let mut random = [0; 24];\\n            fs::File::open(\\\"/dev/urandom\\\")\\n                .and_then(|mut f| f.read_exact(&mut random))\\n                .map_err(|e| e.to_string())?;\\n            let correction = Correction {\\n                revision: random.iter().map(|b| format!(\\\"{b:02x}\\\")).collect(),\\n                text: words.into(),\\n            };\\n            correction.validate()?;\\n            Some(correction)\\n        } else {\\n            None\\n        };\\n        let stored = Stored {\\n            schema: 1,\\n            repo: self.repo.clone(),\\n            correction: serde_json::to_value(correction).map_err(|e| e.to_string())?,\\n        };\\n        let bytes = serde_json::to_vec(&stored).map_err(|e| e.to_string())?;\\n        let mut file = tempfile::NamedTempFile::new_in(&self.store).map_err(|e| e.to_string())?;\\n        file.write_all(&bytes).map_err(|e| e.to_string())?;\\n        file.as_file().sync_all().map_err(|e| e.to_string())?;\\n        file.persist(self.correction_file())\\n\\n[5 more lines in file. Use offset=151 to continue.]\"}\n==> text 9/11 <==\n{\"p\":\"tests/tend_correction_terminal.py\",\"content\":\"\\\"\\\"\\\"Saved correction transfer and format compatibility through the public terminal flow.\\\"\\\"\\\"\\nimport fcntl\\nimport hashlib\\nimport json\\nimport os\\nfrom pathlib import Path\\nimport shutil\\nimport tempfile\\nimport time\\nimport test_launch as subprocess\\nimport tend_connection_terminal as flow\\n\\nEVIDENCE = Path(os.environ['TINKERY_CORRECTION_EVIDENCE']) if os.environ.get('TINKERY_CORRECTION_EVIDENCE') else None\\n\\ndef capture(term, name):\\n    settle(term)\\n    if EVIDENCE:\\n        EVIDENCE.mkdir(parents=True, exist_ok=True)\\n        (EVIDENCE/(name+'.txt')).write_text(term.screen.text())\\n\\nWORDS = 'For support work, preserve the failed lookup before suggesting documentation.\\\\nKeep exact words: café.'\\n\\n\\ndef exploration(root):\\n    return next(p for p in (root/'links').glob('connection-*.json') if not p.name.endswith('.correction.json'))\\n\\n\\ndef correction(root):\\n    return next((root/'links').glob('*.correction.json'))\\n\\n\\ndef settle(term):\\n    for _ in flow.wait_output(term.master, term.process, term.screen.feed, time.monotonic()+.15):\\n        pass\\n\\n\\ndef edit(term, words, expected='F2 save correction only'):\\n    flow.send(term,b'f',expected)\\n    # Let clear keys drain before a large paste. On Linux, mixing them can leave\\n    # paste bytes unread after Crossterm returns keys from its first read chunk.\\n    frame=term.screen.frames\\n    assert os.write(term.master,b'\\\\x01\\\\x0b')==2\\n    for code in flow.wait_output(term.master,term.process,term.screen.feed,time.monotonic()+15):\\n        if term.screen.ready(frame): break\\n        if code is not None: break\\n    assert term.screen.ready(frame),f'Clear keys did not finish a frame:\\\\n{term.screen.text()}'\\n    paste=b'\\\\x1b[200~'+words.encode()+b'\\\\x1b[201~'\\n    assert os.write(term.master,paste)==len(paste)\\n    flow.wait(term,words.rstrip('\\\\n').split('\\\\n')[-1][:32])\\n\\n\\ndef save_correction(term, words=WORDS):\\n    edit(term,words)\\n    flow.send(term,flow.F2,'F2 find one connection')\\n\\n\\ndef discover(root, repo, size=(100,30)):\\n    term=flow.launch(root,repo,*size,budget=10)\\n    flow.wait(term,'F2 find one connection')\\n    flow.send(term,flow.F2,'p prepare this goal')\\n    return term\\n\\n\\ndef journey(size):\\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-correction-') as directory:\\n        root=Path(directory).resolve();repo=flow.fixture(root)\\n        originals={p:p.read_bytes() for p in (root/'sessions').glob('*/ledger.json')}\\n        term=discover(root,repo,size)\\n        try:\\n            save_correction(term)\\n            stored=json.loads(correction(root).read_text());assert stored['correction']['text']==WORDS\\n            assert correction(root).stat().st_mode & 0o777 == 0o600\\n            capture(term,f'{size[0]}x{size[1]}-correction-disclosure')\\n            assert len(flow.requests(root))==1\\n        finally: term.close()\\n        term=flow.launch(root,repo,*size,budget=10)\\n        try:\\n            flow.wait(term,'F2 find one connection')\\n            assert len(flow.requests(root))==1\\n            flow.send(term,flow.F2,'p prepare this goal')\\n            request=flow.requests(root)[-1]['input']\\n            assert set(request)=={'repo','sources','model','thinking','harness','prompt','correction'}\\n            assert request['correction']==stored['correction']\\n            assert '--no-tools' in flow.requests(root)[-1]['args']\\n            settle(term)\\n            assert 'operator guidance' in term.screen.text(),term.screen.text()\\n            lines=term.screen.text().splitlines()\\n            assert any(line.strip()=='Keep exact words: café.' for line in lines),term.screen.text()\\n            assert term.screen.text().count('Keep exact words: café.')==1\\n            capture(term,f'{size[0]}x{size[1]}-proposal-with-correction')\\n            os.write(term.master,b'\\\\x1b[6~');settle(term)\\n            capture(term,f'{size[0]}x{size[1]}-proposal-scrolled')\\n        finally: term.close()\\n        # A different goal set receives the same exact guidance, without a selected pair.\\n        for i in range(2): flow.update_goal(root,f'goal-{i}',goal=f'TEST later support task {i}')\\n        (root/'mode').write_text('none')\\n        term=flow.launch(root,repo,*size,budget=10)\\n        try:\\n            flow.wait(term,'F2 find one connection');flow.send(term,flow.F2,'No useful connection found')\\n            assert flow.requests(root)[-1]['input']['correction']==stored['correction']\\n            assert [s['goal'] for s in flow.requests(root)[-1]['input']['sources']]==['TEST later support task 0','TEST later support task 1']\\n            assert json.loads(correction(root).read_text())==stored\\n        finally: term.close()\\n        # Restore source words, then save a proposal with its frozen correction.\\n        for p,data in originals.items(): p.write_bytes(data)\\n        for i in range(2): flow.update_goal(root,f'goal-{i}',goal=json.loads(originals[root/'sessions'/f'goal-{i}'/'ledger.json'])['goal'])\\n        (root/'mode').write_text('good')\\n        term=flow.launch(root,repo,*size,budget=10)\\n        try:\\n            flow.wait(term,'F2 find one connection');flow.send(term,flow.F2,'p prepare this goal')\\n            flow.send(term,b'p','F2 save exact words');flow.send(term,flow.F2,'tinkery › shape')\\n            flow.wait(term,\\\"Shape hasn't asked its next question yet.\\\")\\n            capture(term,f'{size[0]}x{size[1]}-shape')\\n        finally: term.close()\\n        record=json.loads(exploration(root).read_text());dest=Path(record['saved'])\\n        ledger=(dest/'ledger.json').read_bytes()\\n        origin=record['pending']['origin']\\n        assert origin['schema']==2 and origin['correction']==stored['correction']\\n        entries=json.loads(ledger)['nodes'][0]['evidence']\\n        evidence=next(e for e in entries if e.get('artifact')=='tinkery:origin/tend-v2')\\n\\n[325 more lines in file. Use offset=121 to continue.]\"}\n==> text 10/11 <==\nbrain_dump.rs:1: //! Think's screen: the writing box, the original, the reading and its one question, review and\nbrain_dump.rs:12:     drafting::{Approach, Job, ModelHost, REQUEST_LIMIT, Request},\nbrain_dump.rs:96:     /// Help (F1), the originals and why cover the right side.\nbrain_dump.rs:100:     original: bool,\nbrain_dump.rs:107:     /// Focus is on the original (or its cards), not the writing box.\nbrain_dump.rs:110:     original_scroll: u16,\nbrain_dump.rs:138:             original: false,\nbrain_dump.rs:145:             original_scroll: 0,\nbrain_dump.rs:356:     /// Populate a fresh unsent draft and retain its separate provenance, never as a source.\nbrain_dump.rs:358:     pub(crate) fn offer_draft(&mut self, draft: crate::think_record::DraftSuggestion) {\nbrain_dump.rs:360:         if self.input.insert(&draft.text).is_err(