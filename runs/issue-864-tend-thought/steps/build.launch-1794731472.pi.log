"A B\"; use IT and use it.'\n   os.write(master,b'\\x1b[200~'+dump.encode()+b'\\x1b[201~');await_text('compound.')\n   send(b'\\x1bOQ','Which UI');assert not root.exists() and not records.exists()\n   # Unsent words hide Review. Help navigation neither sends nor changes that draft.\n   before_calls=(run/'provider-calls').read_bytes()\n   send(b'x\\x1bOP','Right now');assert '1  Review the goal' not in screen.text(),screen.text()\n   os.write(master,b'\\x1bOQ');time.sleep(.1)\n   assert (run/'provider-calls').read_bytes()==before_calls and not root.exists() and not records.exists()\n   send(b'\\x1b','F1 more');assert (run/'provider-calls').read_bytes()==before_calls;os.write(master,b'\\x7f')\n   if literals:\n    await_text('Must: accept \"A  B\".')\n    assert 'Must: accept \"A B\".' in screen.text(),screen.text()\n   review();assert ('made in TEST-repo' in right())==in_repo and ('made in' in right())==in_repo,screen.text();assert \"type confirm to save the goal and its record. You can't edit it after.\" in right() or \"PgDn: read to the end first.\" in right(),screen.text();assert not root.exists() and not records.exists()\n   if literals:\n    assert 'Must: accept \"A  B\".' in screen.text() and 'Must: accept \"A B\".' in screen.text(),screen.text()\n   # A refused Enter says why where the confirm prompt was: scroll first, or type the word.\n   send(b'\\r','Enter.');shown=' '.join(right().split());assert 'Read to the end first: PgDn scrolls. Then type confirm and Enter.' in shown or 'Type confirm, then Enter. Nothing saved.' in shown,screen.text()\n   os.write(master,b'\\x1bOQ');time.sleep(.1);assert not root.exists() and not records.exists(),'Opening/Enter/F2 implied consent'\n   os.write(master,b'\\x1b');absent('You are confirming');assert not root.exists() and not records.exists()\n   review()\n   os.write(master,b'\\x1b[6~'*30);await_text('remain unresolved?')\n   send(b'confirm\\r','Saved.');await_text('Next:')\n   assert 'Next: shape it into a seed in Shape.' in right(),screen.text()\n   assert screen.text().splitlines()[-1].strip()=='s open in tend   esc menu'\n   assert str(root) not in screen.text() and 'seed not written yet' not in screen.text()\n   first_goal=right()\n   sessions=list(root.iterdir());assert len(sessions)==1\n   session=sessions[0].resolve();ledger=helper('read',session);status=helper('status',session)\n   assert ledger['status']=='active' and ledger['operator']=='human'\n   assert not any(k in status for k in ('viewer','snapshot','snapshot_current'))\n   origin=next(n for n in ledger['nodes'] if n['id']==ledger['origin'])\n   assert origin['status']=='settled' and origin['kind']=='decision' and origin['authority']=='user'\n   assert origin['answer']==ledger['goal']=='I judge a PR ready for human review as restaurateur while both the harness and codebase compound.\\nWhy: I retain final judgment.\\nDone when: a PR is ready for human review.\\nMust: human taste.'+('\\nMust: accept \\\"A  B\\\".\\nMust: accept \\\"A B\\\".\\nMust: use IT.\\nMust: use it.' if literals else '')+'\\nMust not: cook.\\nMust not: show cost unless it is way off.\\nMust not: build a dashboard.'\n   context=json.loads(origin['evidence'][-1]['observed'])\n   assert ledger['draft']['outcome']==context['success']==context['goal_parts']['done_when']=='a PR is ready for human review'\n   assert context['constraints']==dict(must=(['human taste', 'accept \\\"A  B\\\"', 'accept \\\"A B\\\"', 'use IT', 'use it'] if literals else ['human taste']),must_not=['cook','show cost unless it is way off','build a dashboard'])\n   assert context['problem']==context['goal_parts']['why']=='I retain final judgment'\n   assert any(e.get('observed')==dump and e.get('checked')=='Tinkery original 1' for e in origin['evidence']);assert 'unresolved' in origin['evidence'][-1]['observed']\n   assert not (session/'seed-contract.md').exists()\n   # The same typed confirm wrote exactly one think record: the words, the turns in order, the goal as saved.\n   written=list(records.iterdir());assert len(written)==1,written\n   record=json.loads(written[0].read_text());record_bytes=written[0].read_bytes()\n   assert written[0].name.endswith('_'+session.name+'.json'),written[0].name\n   assert record['schema']==3 and record['origin']=='live' and record['model']=='test/model' and record['seed_me_session']==session.name\n   assert Path(record['seed_me_session_path']) == session\n   assert (Path(record['repo']).resolve()==repo.resolve()) if in_repo else record['repo'] is None,record['repo']\n   assert 'TEST-repo' not in (run/'provider-requests').read_text(),'the repository reached the provider'\n   assert 'TEST-repo' not in (session/'ledger.json').read_text(),'the repository reached the session ledger'\n   assert record['goal']==ledger['goal'],(record['goal'],ledger['goal'])\n   assert [t['kind'] for t in record['turns']]==['words','asked'],record['turns']\n   assert record['turns'][0]['text']==dump and record['turns'][1]['id']=='open'\n   assert record['checks'] and all(c['decision']=='pass' for c in record['checks'])\n   assert all(c['raw'] is None for c in record['checks']),'a passing check kept the model reply'\n   failed=subprocess.run([str(fixture.BINARY)],input=json.dumps(dict(op='end',path=str(session),status='completed',reason='TEST must refuse incomplete seed')),capture_output=True,text=True, env=subprocess.environment())\n   assert failed.returncode!=0 and 'seed-contract.md' in failed.stderr\n   assert helper('read',session)['status']=='active'\n   saved=(session/'ledger.json').read_bytes()\n   calls=(run/'provider-calls').read_bytes()\n   launches=(cwd/'python-launches').read_bytes() if (cwd/'python-launches').exists() else b''\n   assert not any('init' in args for args in map(ast.literal_eval,launches.decode().splitlines())), 'Saving invoked an external session helper'\n   deadline=time.monotonic()+3\n   owned=descendants()\n   while owned and time.monotonic()<deadline:\n    time.sleep(.02)\n    owned=descendants()\n   assert not owned, subprocess.check_output(['ps','-p',','.join(map(str,owned)),'-o','pid=,command='],text=True, env=subprocess.environment()) if owned else owned\n   os.write(master,b'\\x07confirm\\r\\x1bOQ\\x1bOR\\x1bOS\\x1b[15~\\x1b[17~\\x1b[19~\\x1b[20~\\x0e\\x0f\\x04q')\n   time.sleep(.2)\n   os.write(master,b'c');time.sleep(.1)\n   assert not re.findall(rb'\\x1b\\]52;c;',bytes(raw)), 'Retired continuation prompt was copied'\n   assert descendants()==owned and (run/'provider-calls').read_bytes()==calls\n\n[74 more lines in file. Use offset=156 to continue.]\n==> text 3/6 <==\n\"\"\"Own one guarded terminal process, its screen and descriptors; feature waits stay local.\"\"\"\nimport errno\nimport fcntl\nimport os\nimport select\nimport signal\nimport struct\nimport termios\nimport time\nimport test_launch as subprocess\nfrom vt_screen import Screen\n\n\ndef wait_output(master, process, consume, deadline, *, interval=.02):\n    \"\"\"Yield the observed return code after reading, draining output on exit.\n\n    The absolute monotonic deadline bounds reads and exit draining. Callers own\n    success, frame readiness and diagnostics. EOF and an exited PTY's EIO finish\n    a read pass; other read errors remain failures. No frame is required here.\n    \"\"\"\n    def read_pending(timeout):\n        if not select.select([master], [], [], timeout)[0]:\n            return False\n        try:\n            chunk = os.read(master, 65536)\n        except OSError as error:\n            if error.errno != errno.EIO or process.poll() is None:\n                raise\n            return False\n        if not chunk:\n            return False\n        consume(chunk)\n        return True\n\n    while time.monotonic() < deadline:\n        started = time.monotonic()\n        read_output = read_pending(min(interval, max(0, deadline - started)))\n        returncode = process.poll()\n        if not read_output and returncode is None:\n            remaining = min(started + interval, deadline) - time.monotonic()\n            if remaining > 0:\n                time.sleep(remaining)\n        if returncode is not None:\n            # Exit is not EOF: unread final output can span many small reads.\n            while time.monotonic() < deadline and read_pending(0):\n                pass\n        yield returncode\n        if returncode is not None:\n            return\n\n\nclass TerminalProcess:\n    def __init__(self, argv, *, cwd, env, width, height):\n        self.master, self.slave = os.openpty()\n        self.raw = bytearray()\n        try:\n            self.resize(width, height)\n            self.process = subprocess.Popen(argv, cwd=cwd, env=env,\n                                            stdin=self.slave, stdout=self.slave, stderr=self.slave)\n        except BaseException:\n            os.close(self.master)\n            os.close(self.slave)\n            raise\n\n    def resize(self, width, height):\n        fcntl.ioctl(self.slave, termios.TIOCSWINSZ, struct.pack('HHHH', height, width, 0, 0))\n        self.screen = Screen(width, height)\n        if hasattr(self, 'process'):\n            os.kill(self.process.pid, signal.SIGWINCH)\n\n    def feed(self):\n        chunk = os.read(self.master, 65536)\n        self.raw.extend(chunk)\n        self.screen.feed(chunk)\n\n    def close(self):\n        if self.process.poll() is None:\n            self.process.kill()\n        self.process.wait()\n        os.close(self.master)\n        os.close(self.slave)\n==> text 4/6 <==\n#!/usr/bin/env python3\n\"\"\"Execute the single authoritative AGENTS full-check block in an isolated TEST home.\n\nKeeps the existing installed compiler/cache locations; never installs tools or uses\noperator application roots. No external skill checkout is needed.\n\"\"\"\nimport os\nfrom pathlib import Path\nimport re\nimport sys\nimport tempfile\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'tests'))\nimport test_launch\n\n\ndef block():\n    source = (ROOT / 'AGENTS.md').read_text()\n    markers = ['<!-- full-check:start -->', '<!-- full-check:end -->']\n    if any(source.count(marker) != 1 for marker in markers):\n        raise ValueError('Expected exactly one pair of full-check markers')\n    section = source.split(markers[0], 1)[1].split(markers[1], 1)[0]\n    blocks = re.findall(r'```bash\\n(.*?)\\n```', section, re.S)\n    if len(blocks) != 1 or not blocks[0].strip():\n        raise ValueError('Expected exactly one nonempty documented verification block')\n    return blocks[0] + '\\n'\n\n\ndef main():\n    command = block()\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-full-check-') as directory:\n        home = Path(directory) / 'HOME'\n        home.mkdir()\n        env = dict(os.environ)\n        installed_home = Path(env['HOME'])\n        env.setdefault('CARGO_HOME', str(installed_home / '.cargo'))\n        env.setdefault('RUSTUP_HOME', str(installed_home / '.rustup'))\n        env.pop('SEED_ME_TEST_SKILL', None)\n        # A tink-sdlc build step marks its worker env; label tests run outside that session.\n        env.pop('TINK_SDLC_STEP_SESSION', None)\n        env.update(HOME=str(home), PYTHONDONTWRITEBYTECODE='1', TINKERY_NODE='/tinkery-TEST-no-node')\n        script = Path(directory) / 'full-check.sh'\n        script.write_text(command)\n        print('Exact AGENTS full-check; temporary TEST HOME', flush=True)\n        test_launch.run(['bash', '-euo', 'pipefail', str(script)], cwd=ROOT, env=env, check=True)\n\n\nif __name__ == '__main__':\n    main()\n==> text 5/6 <==\n//! Session discovery for the menu: one owned, read-only worker that never runs in paint.\n//!\n//! The menu and tend read only what this has already landed. Four states are kept apart:\n//! not known (nothing landed, or a newer request is still running), complete (every\n//! record was read), incomplete (some records could not be read) and failed (the root\n//! could not be read at all). A missing root is complete and empty: nothing exists yet.\n\nuse std::{\n    collections::HashSet,\n    fs,\n    path::{Path, PathBuf},\n    sync::{\n        Arc,\n        mpsc::{self, Receiver, TryRecvError},\n    },\n    time::Instant,\n};\n\nuse super::{self as tend, Session};\nuse crate::seed_me::{self, Record};\n\n/// What one scan found.\n#[derive(Debug, Clone, Default, PartialEq)]\npub struct Found {\n    /// Every readable session, newest first.\n    pub sessions: Vec<Session>,\n    /// Records that exist but could not be read; they are never guessed or counted.\n    pub unreadable: usize,\n    /// At most `seed_me::MAX_READ_FAILURES` path/reason samples; the full count is `unreadable`.\n    pub failures: Vec<seed_me::ReadFailure>,\n}\nimpl Found {\n    /// Every record was read, so the list is the whole truth.\n    pub fn complete(&self) -> bool {\n        self.unreadable == 0\n    }\n\n    fn failed(&mut self, failure: seed_me::ReadFailure) {\n        self.unreadable += 1;\n        if self.failures.len() < seed_me::MAX_READ_FAILURES {\n            self.failures.push(failure);\n        }\n    }\n}\n\n/// `Err` means the root itself could not be read.\npub type Outcome = Result<Found, String>;\n/// The blocking read. Injectable so tests can hold it open.\npub type Source = Arc<dyn Fn(&Path) -> Outcome + Send + Sync>;\n\n/// saved sessions, newest first. Each folder is read by [`seed_me::read`].\npub fn scan(root: &Path) -> Outcome {\n    let entries = match fs::read_dir(root) {\n        Ok(entries) => entries,\n        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {\n            return Ok(Found::default());\n        }\n        Err(error) => return Err(format!(\"Cannot read {}: {error}\", root.display())),\n    };\n    let mut found = Found::default();\n    for entry in entries {\n        let entry = match entry {\n            Ok(entry) => entry,\n            Err(error) => {\n                found.failed(seed_me::ReadFailure::new(\n                    root.to_path_buf(),\n                    format!(\"Cannot read a directory entry: {error}\"),\n                ));\n                continue;\n            }\n        };\n        match seed_me::read(&entry.path()) {\n            Record::Session(session) => found.sessions.push(session),\n            Record::NotASession => {}\n            Record::Unreadable(failure) => found.failed(failure),\n        }\n    }\n    found.sessions.sort_by(|a, b| {\n        tend::timestamp(&b.updated)\n            .cmp(&tend::timestamp(&a.updated))\n            .then_with(|| b.updated.cmp(&a.updated))\n            .then_with(|| a.path.cmp(&b.path))\n    });\n    Ok(found)\n}\n\n/// The last result that landed, with how many requests had been made when it started.\npub struct Landed {\n    /// What the read found, or why the root couldn't be read.\n    pub outcome: Outcome,\n    /// Exact attributed session paths for the launch repo; absent outside a repo.\n    pub(crate) repo_paths: Option<HashSet<PathBuf>>,\n    /// Active goals whose record cannot establish a repository or an explicit no-repo origin.\n    pub(crate) repo_unknown: usize,\n    epoch: u64,\n    active: usize,\n}\n\nstruct Scanned {\n    outcome: Outcome,\n    repo_paths: Option<HashSet<PathBuf>>,\n    repo_unknown: usize,\n}\n\n/// One owned worker at a time. Requests made while it runs coalesce into one follow-up.\npub struct Discovery {\n    source: Source,\n    root: PathBuf,\n    requested: u64,\n    running: Option<(u64, PathBuf, Receiver<Scanned>, Instant)>,\n    scope: Option<(PathBuf, Result<PathBuf, String>)>,\n    landed: Option<Landed>,\n    version: u64,\n}\n\nimpl Discovery {\n    /// No read yet; nothing runs until the first [`Discovery::request`].\n    pub fn new(source: Source) -> Self {\n        Self {\n            source,\n            root: PathBuf::new(),\n            requested: 0,\n            running: None,\n            scope: None,\n            landed: None,\n            version: 0,\n        }\n    }\n\n    /// A configured refusal, already available to the views; starts no worker or filesystem read.\n    pub fn unavailable(reason: String) -> Self {\n        let mut discovery = Self::new(Arc::new(scan));\n        discovery.requested = 1;\n        discovery.version = 1;\n        discovery.landed = Some(Landed {\n            outcome: Err(reason),\n            repo_paths: None,\n            repo_unknown: 0,\n            epoch: 1,\n            active: 0,\n        });\n        discovery\n    }\n\n    /// Attribute the next read using existing Think records only; configuration reads nothing.\n    pub(crate) fn scope_to_repo(\n        &mut self,\n        repo: Option<PathBuf>,\n        records: Result<PathBuf, String>,\n    ) {\n        self.scope = repo.map(|repo| (repo, records));\n    }\n\n    /// Ask for a fresh read of `root`. Never blocks; at most one worker exists.\n    pub fn request(&mut self, root: &Path) {\n        self.requested += 1;\n        if self.root != root {\n            // A read of another place says nothing about this one.\n            self.landed = None;\n            self.root = root.to_path_buf();\n        }\n        self.start_if_idle();\n    }\n\n    /// Whether any read has been asked for.\n    pub fn requested(&self) -> bool {\n        self.requested > 0\n    }\n\n    /// Land a finished worker, if any. True when something new can be shown.\n\n[156 more lines in file. Use offset=171 to continue.]\n==> text 6/6 <==\n    label_hits: Vec<(Rect, String)>,\n    pointer_offset: Option<(i32, i32)>,\n}\n\nfn settings() -> Settings {\n    let mut settings = Settings {\n        max_node: 0,\n        ..Settings::default()\n    };\n    settings.filter.show_orphan = true;\n    settings.visual.node_color_mode = NodeColorMode::Uniform;\n    settings.visual.node_fill = NodeFill::None;\n    settings.visual.node_scale = NodeScale::Fixed(10);\n    settings.visual.selection_focus = SelectionFocus::None;\n    settings.visual.label_mode = LabelMode::None;\n    settings.visual.show_legend = false;\n    settings.visual.show_minimap = false;\n    settings.visual.show_looking_glass = false;\n    settings.visual.full_detail = true;\n    settings.interaction.double_click_ms = 0;\n    settings\n}\n\nfn identity(session: &super::Session) -> String {\n    // Debug escaping preserves non-UTF8 path distinctions too.\n    format!(\"{:?}\", session.path)\n}\n\nimpl Tend {\n    /// Prepare path-bound inputs when sessions, scope or needs links change.\n    pub(super) fn prepare_graph(&mut self) {\n        let mut counts = HashMap::new();\n        for session in &self.all_sessions {\n            if let Some(id) = &session.id {\n                *counts.entry(id.as_str()).or_insert(0) += 1;\n            }\n        }\n        let mut nodes: Vec<_> = self\n            .sessions\n            .iter()\n            .map(|s| (identity(s), s.goal.lines().next().unwrap_or(\"\").to_owned()))\n            .collect();\n        nodes.sort_by(|a, b| a.0.cmp(&b.0));\n        let indices: HashMap<_, _> = nodes\n            .iter()\n            .enumerate()\n            .map(|(i, (id, _))| (id.as_str(), i))\n            .collect();\n        let ids: HashMap<_, _> = self\n            .sessions\n            .iter()\n            .filter_map(|s| {\n                let id = s.id.as_deref()?;\n                (counts.get(id) == Some(&1)).then(|| (id, indices[identity(s).as_str()]))\n            })\n            .collect();\n        let edges = self\n            .links\n            .as_ref()\n            .map(|links| {\n\n[435 more lines in file. Use offset=95 to continue.]"}],"details":{"calls":[{"id":"call_6cbf5f07a2584e2ab1515666a87a395d|ctc_0df587760909a640016af96e95f54887d1a595a57711a64074/1","name":"read","args":"{\"path\":\"src/words/tests.rs\",\"limit\":210}","status":"ok","durationMs":1.1239589999895543},{"id":"call_6cbf5f07a2584e2ab1515666a87a395d|ctc_0df587760909a640016af96e95f54887d1a595a57711a64074/2","name":"read","args":"{\"path\":\"tests/goal_confirmation_terminal.py\",\"limit