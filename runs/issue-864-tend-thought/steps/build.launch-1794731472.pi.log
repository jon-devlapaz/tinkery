replace('\\r', \"\\n\")\n}\n\n/// A character offset in the display mapped back to raw bytes; CRLF is one displayed newline.\nfn raw_offset(raw: &str, index: usize) -> usize {\n    let mut chars = raw.char_indices().peekable();\n    for _ in 0..index {\n        if let Some((_, '\\r')) = chars.next()\n            && chars.peek().is_some_and(|(_, c)| *c == '\\n')\n        {\n            chars.next();\n        }\n    }\n    chars.peek().map_or(raw.len(), |(offset, _)| *offset)\n}\n\n#[cfg(test)]\nmod tests;\n==> text 2/7 <==\nshape.rs:9: //! seed with the operator's own words; see [`step`]. F1 lists every other action allowed now by\nshape.rs:21: mod choices;\nshape.rs:22: pub mod command;\nshape.rs:23: mod discovery_help;\nshape.rs:24: mod forms;\nshape.rs:25: mod help;\nshape.rs:26: mod step;\nshape.rs:27: mod words;\nshape.rs:52: use words::Words;\nshape.rs:58: /// The only words that confirm a seed draft, as in Think: anything else may be a correction.\nshape.rs:62: /// Refusals about the typed words; changing the words clears them.\nshape.rs:100: /// A words box opened from F1 over a seed draft.\nshape.rs:120:     /// The operator's words being typed: an answer, or the words that confirm a seed.\nshape.rs:124:     /// An unsaved form over the draft, with its own words and cancel action.\nshape.rs:161:         words: String,\nshape.rs:166:         words: String,\nshape.rs:274:     /// Reenter this same session through its normal asynchronous read, keeping words and context.\nshape.rs:281:     /// Whether keys now type words (an answer, seed confirmation or folder), so letters aren't\nshape.rs:295:     /// Bracketed paste: the words go into the folder, answer or confirmation exactly as pasted.\nshape.rs:302:                 (_, Some(form)) => form.words().insert(text),\n\n[20 matches limit reached. Use limit=40 for more, or refine pattern]\n==> text 3/7 <==\nlib.rs:22: pub mod actions;\nlib.rs:25: pub mod goal;\nlib.rs:26: pub mod measure;\nlib.rs:27: pub mod menu;\nlib.rs:28: pub mod model_setup;\nlib.rs:29: pub mod pi;\nlib.rs:30: pub mod repo;\nlib.rs:32: pub mod seed_me;\nlib.rs:33: pub mod shape;\nlib.rs:35: pub mod taste;\nlib.rs:36: pub mod tend;\nlib.rs:37: pub mod think;\nlib.rs:38: pub mod think_record;\nlib.rs:39: pub mod voice;\nlib.rs:40: pub mod watch;\n==> text 4/7 <==\n#!/usr/bin/env python3\n\"\"\"Run every Python test file in parallel and fail if any file fails.\n\n`TINKERY_TEST_TIER=pr` skips only the slow journeys listed in POST_MERGE; any new\nfile runs in both tiers. The default tier is `full`, which runs every file.\nEvery launch passes the shared guard, so the runner refuses a non-TEST HOME.\nEach file is its own process; a failed file's output is printed whole.\n\"\"\"\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport time\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'tests'))\nimport test_launch\n# Helper modules, not tests.\nHELPERS = {'vt_screen.py', 'session_fixture.py', 'test_launch.py', 'terminal_process.py'}\n# Slow terminal journeys that pull requests skip; pushes to main and nightly runs keep them.\nPOST_MERGE = {\n    'hidden_review_terminal.py',\n    'selection_terminal.py',\n    'shape_answer_terminal.py',\n    'taste_terminal.py',\n    'think_history_terminal.py',\n}\n# Slowest files that still run on pull requests.\nSLOW_PR = {'agent_operation_terminal.py', 'goal_confirmation_terminal.py', 'think_question_terminal.py',\n           'watch_terminal.py', 'approve_terminal.py'}\n\n\ndef selected(tier):\n    if tier not in ('pr', 'full'):\n        raise SystemExit(f'Unknown TINKERY_TEST_TIER {tier!r}; use pr or full.')\n    files = sorted(p for p in (ROOT / 'tests').glob('*.py') if p.name not in HELPERS)\n    missing = POST_MERGE - {p.name for p in files}\n    if missing:\n        raise SystemExit(f'POST_MERGE names missing tests: {sorted(missing)}')\n    # Start the slowest journeys first so they don't set the wall time alone at the end.\n    return sorted((p for p in files if tier == 'full' or p.name not in POST_MERGE),\n                  key=lambda p: p.name not in POST_MERGE | SLOW_PR)\n\n\ndef run(path, env):\n    start = time.monotonic()\n    result = test_launch.run([sys.executable, str(path)], cwd=ROOT, env=env,\n                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)\n    return path, result.returncode, time.monotonic() - start, result.stdout.decode(errors='replace')\n\n\ndef main():\n    tier = os.environ.get('TINKERY_TEST_TIER', 'full')\n    files = selected(tier)\n    # Prepare both executables before workers can use them; even fresh Cargo builds\n    # replace the example executable on macOS.\n    env = dict(os.environ)\n    test_launch.run(['cargo', '+stable', 'build', '--locked', '--quiet',\n                     '--bin', 'tinkery', '--example', 'seed_fixture'], cwd=ROOT,\n                    env=env, check=True)\n    env['TINKERY_TEST_SEED_FIXTURE'] = str(ROOT / 'target/debug/examples/seed_fixture')\n    workers = int(os.environ.get('TINKERY_TEST_JOBS') or min(8, os.cpu_count() or 2))\n    print(f'Python tests: tier {tier}, {len(files)} files, {workers} workers', flush=True)\n    failed = []\n    with ThreadPoolExecutor(workers) as pool:\n        futures = [pool.submit(run, path, env) for path in files]\n        for future in as_completed(futures):\n            path, code, seconds, output = future.result()\n            name = path.relative_to(ROOT)\n            print(f'== {name} {\"ok\" if code == 0 else f\"FAILED ({code})\"} {seconds:.1f}s', flush=True)\n            if code:\n                failed.append(name)\n                print(output, flush=True)\n    if failed:\n        raise SystemExit(f'{len(failed)} Python test file(s) failed: ' + ', '.join(map(str, failed)))\n\n\nif __name__ == '__main__':\n    main()\n==> text 5/7 <==\n\"\"\"The sole process boundary for Python tests: Tinkery never inherits operator HOME.\"\"\"\nimport atexit\nimport os\nfrom pathlib import Path\nimport pwd\nimport subprocess\nimport sys\nimport tempfile\n\n# Keep subprocess result/error types and pipe constants available to test callers.\nCalledProcessError = subprocess.CalledProcessError\nTimeoutExpired = subprocess.TimeoutExpired\nPIPE = subprocess.PIPE\nDEVNULL = subprocess.DEVNULL\nSTDOUT = subprocess.STDOUT\n\n_home = None\n\n\nclass UnsafeTestHome(ValueError):\n    \"\"\"The requested process environment is not an isolated TEST home.\"\"\"\n\n\ndef environment(base=None, *, home=None):\n    \"\"\"Explicitly select a TEST home; by default allocate one for this test process.\n\n    Caller-selected homes must already exist. Preserve tool caches, not application\n    data, when changing HOME so fixture builds need no toolchain installation.\n    \"\"\"\n    global _home\n    env = dict(os.environ if base is None else base)\n    real_home = pwd.getpwuid(os.getuid()).pw_dir\n    env.setdefault('CARGO_HOME', str(Path(real_home) / '.cargo'))\n    env.setdefault('RUSTUP_HOME', str(Path(real_home) / '.rustup'))\n    if home is None:\n        if _home is None:\n            _home = tempfile.TemporaryDirectory(prefix='tinkery-TEST-launch-home-')\n            atexit.register(_home.cleanup)\n        home = _home.name\n    env['HOME'] = str(home)\n    env.setdefault('TINKERY_NODE', '/tinkery-TEST-no-node')\n    return _checked_environment(env, create=True)\n\n\ndef _checked_environment(env, *, create=False):\n    \"\"\"Refuse unsafe HOME before any subprocess API can start an executable.\"\"\"\n    if env is None or not env.get('HOME'):\n        raise UnsafeTestHome('Test launches require an explicit temporary TEST HOME.')\n    home = Path(env['HOME'])\n    if not home.is_absolute():\n        raise UnsafeTestHome('Test HOME must be absolute.')\n    home = home.resolve()\n    real_home = Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()\n    if home == real_home:\n        raise UnsafeTestHome('Refusing to launch with the password-database real home.')\n    temporary_roots = (Path(tempfile.gettempdir()).resolve(), Path('/tmp').resolve(),\n                       Path('/var/tmp').resolve(),\n                       (Path(__file__).resolve().parents[1] / 'target/tmp').resolve())\n    if (not any(home.is_relative_to(root) for root in temporary_roots)\n            or not any('TEST' in part for part in home.parts)):\n        raise UnsafeTestHome('Test HOME must be a temporary TEST folder.')\n    if create:\n        home.mkdir(parents=True, exist_ok=True)\n    if not home.is_dir():\n        raise UnsafeTestHome('Test HOME must be an existing temporary TEST folder.')\n    return dict(env)\n\n\ndef Popen(*args, env=None, **kwargs):\n    \"\"\"Start a process only with a guarded TEST HOME, including PTY launches.\"\"\"\n    return subprocess.Popen(*args, env=_checked_environment(env), **kwargs)\n\n\ndef run(*args, env=None, **kwargs):\n    \"\"\"Run a bounded test command with the same launch guard.\"\"\"\n    return subprocess.run(*args, env=_checked_environment(env), **kwargs)\n\n\ndef check_output(*args, env=None, **kwargs):\n    \"\"\"Capture test output with the same launch guard.\"\"\"\n    return subprocess.check_output(*args, env=_checked_environment(env), **kwargs)\n\n\nif __name__ == '__main__' and len(sys.argv) > 1:\n    raise SystemExit(run(sys.argv[1:], env=dict(os.environ)).returncode)\n==> text 6/7 <==\n            repo: self.repo.clone(),\n            sources,\n            model: self\n                .call\n                .as_ref()\n                .map_or(\"not configured\".into(), |(c, _)| c.model.clone()),\n            thinking: self\n                .call\n                .as_ref()\n                .map_or(String::new(), |(c, _)| c.thinking.clone()),\n            harness: self\n                .call\n                .as_ref()\n                .map_or(String::new(), |(c, _)| c.harness.label().into()),\n            prompt: format!(\"{:x}\", Sha256::digest(PROMPT)),\n            correction,\n        };\n        if serde_json::to_vec(&input).map_err(|e| e.to_string())?.len() > LIMIT {\n            return Err(\"The complete goals exceed 32 KiB. Nothing was truncated or sent.\".into());\n        }\n        Ok(input)\n    }\n    fn read(&self) -> Result<Option<Record>, String> {\n        let path = self.file();\n        let file = match fs::File::open(&path) {\n            Ok(file) => file,\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(None),\n            Err(e) => return Err(format!(\"The latest exploration is unreadable: {e}\")),\n        };\n        if !file.metadata().map_err(|e| e.to_string())?.is_file()\n            || fs::symlink_metadata(&path)\n                .map_err(|e| e.to_string())?\n                .is_symlink()\n        {\n            return Err(\"The exploration is not a regular local file.\".into());\n        }\n        let mut bytes = Vec::new();\n        file.take(RECORD_LIMIT as u64 + 1)\n            .read_to_end(&mut bytes)\n            .map_err(|e| e.to_string())?;\n        if bytes.len() > RECORD_LIMIT {\n            return Err(\"The saved exploration is oversized.\".into());\n        }\n        let record: Record = serde_json::from_slice(&bytes)\n            .map_err(|_| \"The latest exploration is malformed. Preserve it for inspection.\")?;\n        if record.input.repo != self.repo {\n            return Err(\"The exploration belongs to another repository or format.\".into());\n        }\n        if let Some(proposal) = &record.proposal {\n            proposal.validate(&record.input)?;\n        }\n        if let Some(pending) = &record.pending {\n            if self.sessions.canonicalize().ok().as_ref() != Some(&pending.root)\n                || pending.origin.repo != self.repo\n                || pending.origin.sources != record.input.sources\n            {\n                return Err(\"The pending save differs from this launch or exploration.\".into());\n            }\n            let proposal = record\n                .proposal\n                .as_ref()\n                .ok_or(\"The pending save has no proposal.\")?;\n            if pending.origin != proposal.origin(&record.input, &pending.origin.goal)\n                || pending.outcome != proposal.outcome\n            {\n                return Err(\"The pending save differs from the reviewed proposal.\".into());\n            }\n            if let Some(saved) = &record.saved\n                && pending.inspect()?.as_ref().map(|receipt| &receipt.session) != Some(saved)\n            {\n                return Err(\"The completed handoff cannot be verified. Resume the fixed destination before another pass.\".into());\n            }\n        }\n        if record.saved.is_some() && record.pending.is_none() {\n            return Err(\"The saved destination has no confirmation receipt.\".into());\n        }\n        Ok(Some(record))\n    }\n    fn lock(&self) -> Result<fs::File, String> {\n        use std::os::{fd::AsRawFd, unix::fs::OpenOptionsExt};\n        fs::create_dir_all(&self.store).map_err(|e| e.to_string())?;\n        let file = fs::OpenOptions::new()\n            .write(true)\n            .create(true)\n            .truncate(false)\n            .custom_flags(libc::O_NOFOLLOW)\n            .open(self.file().with_extension(\"lock\"))\n            .map_err(|e| e.to_string())?;\n        // SAFETY: File owns this descriptor through the operation; close releases the lock.\n        if unsafe { libc::flock(file.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {\n            return Err(\"Another connection pass or save is active for this repository.\".into());\n        }\n        Ok(file)\n    }\n    fn write(&self, record: &Record) -> Result<(), String> {\n        let bytes = serde_json::to_vec(record).map_err(|e| e.to_string())?;\n        if bytes.len() > RECORD_LIMIT {\n            return Err(\"These edited words exceed the saved exploration limit. Shorten them and retry; the previous result is intact.\".into());\n        }\n        let mut file = tempfile::NamedTempFile::new_in(&self.store).map_err(|e| e.to_string())?;\n\n[144 more lines in file. Use offset=330 to continue.]\n==> text 7/7 <==\n  {\"activation\": {\"cmd\": \"./real-command\", \"cwd\": \".\", \"evidence\": \"Prerequisite exists at <path>; observed <evidence>\"}}\n  ```\n\n  Activating the proposed `cmd` in its `cwd` matches the confirmed seed (evidence adds ``seed-N activated as confirmed: runs `<cmd>` ``) and still must run green; any other command is a departure for the operator. Verify refuses evidence citing a relative file or `dir/` that exists in neither the run nor the checkout, so save cited logs first. A prose prerequisite is not machine-detected: surface it when it becomes true.\n\nReceipts report `seed_checks` (`proven`, `attested`, `pending`, or `not-run` on failure) separately from `checklist_items`. A passing verify's `next_action` still names each pending proposal.\n\n## Implementation and verification\n\nGive each code-writing run its own Git worktree or clone, never just a second branch in one checkout. Ports, databases and credentials need their own isolation when used.\n\nConfigure `_system/verification.json` with nonempty argv arrays and timeouts. A fresh install has no checks and fails until real tests, build and lint are selected; the runner should reject zero tests, since an exit code alone proves no coverage. Optional keys:\n\n- `\"setup\": {\"argv\": [...], \"timeout_seconds\": N}` prepares ignored dependencies, such as `[\"pnpm\", \"install\", \"--frozen-lockfile\"]`. `stage <run> 3` and `5` run it from the committed file in each new worktree; a failure removes the worktree and opens no stage. Keep its output Git-ignored.\n- `\"seed_timeout_seconds\": N` gives each seed `cmd` check, and each activated proposal, N seconds instead of 120. It must be a positive integer.\n- `\"authors\": {\"since\": \"<commit>\", \"allow\": [\"Name <email>\", \"Claude session_* <noreply@anthropic.com>\"]}` makes verify refuse any later commit whose author matches no pattern.\n\n```sh\npython3 _system/scripts/sdlc.py verify fix-example\n```\n\nVerification writes the log (`runs/<slug>/04-test/output/test-log.md`, named in any failure) and a receipt binding the commit, tracked and nonignored untracked files, artifact inputs, policy, test lock and log digest.\n\n- `runs/` is outside the fingerprint: keep source and test infrastructure out of it. Committing run evidence does not stale code.\n- Submodules and untracked nested repositories count by checked-out commit only. Ignored files and external services are outside it: pin them in CI.\n- Generated `tink:rules` blocks in the root `AGENTS.md` are excluded from the candidate fingerprint; all other `AGENTS.md` text counts.\n- Commit before final verification and leave the checkout alone while checks run; if it changes, the error lists up to five paths.\n\nA preexisting log is never passing evidence, and a failed or interrupted run never reuses an older pass.\n\n## Bug reproduction baseline\n\nBefore fixing a bug, show that a meaningful reproduction fails for the expected reason on the unfixed code, and have an independent reviewer accept it. Then record it:\n\n```sh\npython3 _system/scripts/sdlc.py lock-tests fix-example tests/test_regression.py \\\n  --source 'Actual accepted test review reference' \\\n  --failure-evidence 'Actual failing CI job or retained reproduction evidence'\n```\n\nLock fixtures, snapshots, discovery configuration and runner helpers too. Bug runs cannot verify without a lock; changed or missing locked files fail. `--reproduce '<JSON argv>'` runs the reproduction at lock time and refuses the lock if it passes; without it, `status` says the failure was not run locally and CI must confirm it. A mistaken baseline needs an independently reviewed replacement run, linked to the old one; tests are never unlocked silently. Strict protection needs CI to fetch the accepted test revision independently and require its check before merge.\n\n## Tinkery ownership and handoff\n\nSDLC can operate standalone or as Tinkery's external implementation workflow.\nSDLC owns run identity, implementation orchestration, technical review and local\nverification freshness. Tinkery owns the seed and its discovery decisions.\nTinkery owns the intended goal-to-result presentation, not another set of SDLC\napprovals. The operator judges usefulness and authorizes merging. Technical review\nasks whether the change is correct and meets approved scope; Taste asks whether\nthe exact result serves the unchanged operator goal. A model's praise is neither.\n\nFor a Tinkery-originated run:\n\n- **Load:** Load only the explicitly supplied, verified confirmed seed for seed\n  intake; never discover operator sessions to fill a gap. Also read the active\n  contract's immediate inputs, approved brief or spec/plan, checklist, relevant\n  project policy, and repository source and project files needed by the active stage.\n  Carry forward the seed's Problem statement, Proposed outcome (desired user-visible\n  results and success criteria), Acceptance criteria, and Constraints and boundaries\n  (non-negotiables, exclusions and rejected alternatives). Preserve settled checks\n  verbatim and provisional ones as proposals. Preserve Accepted decisions and assumed\n  defaults with their separate authority, plus evidence, uncertainty, open questions\n  and deferrals. Keep the confirmed goal intact. Seed confirmation is not\n  implementation permission. Never infer a goal-to-run connection from matching names,\n  paths or seed bytes.\n- **Hand off:** Identify the run ID and checkout, bound seed reference/digest,\n  candidate commit and PR/result revision. Link each claimed completion condition to\n  evidence for that result; name unresolved conditions and findings. Keep automated\n  proof, manual attestation, independent review and operator acceptance separate. The\n  handoff is human-readable only, not a normalized machine interface. API 1 exposes\n  run_id, the seed_contract binding and verification candidate provenance, but not an\n  explicit PR reference. Use structured status for the seed binding, not this prose.\n  A binding is evidence of intake, not approval, goal identity or release authority.\n  Copying a handoff records no verdict and starts nothing; recheck current state\n  before recording any external decision.\n- **Retain:** Keep the seed copy/binding, approved artifacts, checklist, decision and\n  mark history, verification receipts/logs, review findings and closure references\n  before removing a checkout, with their provenance; name absent facts. Missing, stale,\n  failed, interrupted and conflicting evidence stay distinct. A reader cannot recover\n  records deleted with a worktree.\n\nDo not create a Taste verdict format or a competing acceptance ledger. Goal/run binding,\nthe shared reader and Taste are Tinkery's work. When changing that integration, consult\nTinkery's [constitution](https://github.com/jon-devlapaz/tinkery/blob/main/docs/yohaku.md)\nand [job-record contract](https://github.com/jon-devlapaz/tinkery/blob/main/docs/design/job-records.md);\nproposals grant no implementation authority.\n\n## Who does what at a stage boundary\n\n\n[115 more lines in file. Use offset=180 to continue.]"}],"details":{"calls":[{"id":"call_02c07041a01546b5a1044dae0ebeaeb6|ctc_0df587760909a640016af96e12978887d1b8e0d47b0d1773f7/1","name":"read","args":"{\"path\":\"src/shape/words.rs\",\"offset\":170,\"limit\":90}","status":"ok","durationMs":0.7221669999998994},{"id":"call_02c07041a01546b5a1044dae0ebeaeb6|ctc_0df587760909a640016af96e12978887d1b8e0d47b0d1773f7/2","name":"grep","args":"{\"pattern\":\"words|mod \",\"path\":\"src/shape.rs\",\"limit\":20}","status":"ok","durationMs":9.437375000008615},{"id":"call_02c07041a01546b5a1044dae0ebeaeb6|ctc_0df587760909a640016af96e12978887d1b8e0d47