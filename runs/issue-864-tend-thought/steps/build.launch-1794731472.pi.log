{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":1,"toolCall":{"type":"toolCall","id":"call_0c6bad0713ae407eaed0d806e1d3d1e6|fc_0df587760909a640016af96e29945887d1992f5ba3d50d0631","name":"write","arguments":{"path":"src/tend/thought.rs","content":"//! Exact repository thoughts in Tend's private store. Thoughts never become sessions or model\n//! sources. Only explicit saving publishes words; opening Think returns an unsent copy.\n\nuse crate::{Palette, words::Words};\nuse crossterm::event::{KeyCode, KeyEvent, KeyEventKind, KeyModifiers};\nuse ratatui::{Frame, layout::Rect, widgets::{Paragraph, Wrap}};\nuse serde::{Deserialize, Serialize};\nuse sha2::{Digest, Sha256};\nuse std::{fs, io::{Read, Write}, os::unix::fs::OpenOptionsExt, path::PathBuf};\n\nconst LIMIT: usize = 128 * 1024;\n\n#[derive(Deserialize, Serialize)]\n#[serde(deny_unknown_fields)]\nstruct Thought {\n    schema: u8,\n    repo: PathBuf,\n    words: String,\n}\n\n/// Repository-bound words and their local editor. No goal or seed authority lives here.\npub(crate) struct Garden {\n    root: Result<PathBuf, String>,\n    repo: PathBuf,\n    entries: Result<Vec<String>, String>,\n    selected: usize,\n    editor: Option<Words>,\n    viewing: bool,\n    scroll: u16,\n    notice: String,\n}\n\nimpl Garden {\n    /// Read only thoughts belonging to the captured launch repository; never infer attribution.\n    pub(crate) fn open(root: Result<PathBuf, String>, repo: PathBuf) -> Self {\n        let mut garden = Self {\n            root, repo, entries: Ok(vec![]), selected: 0, editor: None,\n            viewing: false, scroll: 0, notice: String::new(),\n        };\n        garden.entries = garden.read();\n        garden\n    }\n\n    fn prefix(&self) -> String {\n        format!(\"thought-{:x}-\", Sha256::digest(self.repo.as_os_str().as_encoded_bytes()))\n    }\n\n    fn file(&self, words: &str) -> Result<PathBuf, String> {\n        Ok(self.root.as_ref().map_err(Clone::clone)?.join(format!(\n            \"{}{:x}.json\", self.prefix(), Sha256::digest(words.as_bytes())\n        )))\n    }\n\n    fn read_one(&self, path: &PathBuf) -> Result<String, String> {\n        let file = fs::OpenOptions::new().read(true)\n            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)\n            .open(path).map_err(|e| e.to_string())?;\n        if !file.metadata().map_err(|e| e.to_string())?.is_file() {\n            return Err(\"A thought is not a regular local file.\".into());\n        }\n        let mut bytes = vec![];\n        file.take((LIMIT * 6 + 4096) as u64 + 1).read_to_end(&mut bytes)\n            .map_err(|e| e.to_string())?;\n        if bytes.len() > LIMIT * 6 + 4096 {\n            return Err(\"A saved thought is oversized.\".into());\n        }\n        let thought: Thought = serde_json::from_slice(&bytes).map_err(|e| e.to_string())?;\n        if thought.schema != 1 || thought.repo != self.repo || thought.words.is_empty()\n            || thought.words.len() > LIMIT || self.file(&thought.words)? != *path {\n            return Err(\"A thought has invalid words, repository or format.\".into());\n        }\n        Ok(thought.words)\n    }\n\n    fn read(&self) -> Result<Vec<String>, String> {\n        let root = self.root.as_ref().map_err(Clone::clone)?;\n        let files = match fs::read_dir(root) {\n            Ok(files) => files,\n            Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok(vec![]),\n            Err(e) => return Err(e.to_string()),\n        };\n        let mut entries = vec![];\n        for file in files {\n            let path = file.map_err(|e| e.to_string())?.path();\n            if path.file_name().is_some_and(|n| n.to_string_lossy().starts_with(&self.prefix()))\n                && path.extension().is_some_and(|e| e == \"json\") {\n                entries.push(self.read_one(&path)?);\n            }\n        }\n        entries.sort();\n        Ok(entries)\n    }\n\n    fn save(&self, words: &str) -> Result<bool, String> {\n        if words.is_empty() || words.len() > LIMIT {\n            return Err(\"Write a thought of 1 to 131072 bytes. Nothing was saved.\".into());\n        }\n        let root = self.root.as_ref().map_err(Clone::clone)?;\n        fs::create_dir_all(root).map_err(|e| e.to_string())?;\n        let path = self.file(words)?;\n        let thought = Thought { schema: 1, repo: self.repo.clone(), words: words.into() };\n        let bytes = serde_json::to_vec(&thought).map_err(|e| e.to_string())?;\n        let mut temp = tempfile::NamedTempFile::new_in(root).map_err(|e| e.to_string())?;\n        temp.write_all(&bytes).map_err(|e| e.to_string())?;\n        temp.as_file().sync_all().map_err(|e| e.to_string())?;\n        match temp.persist_noclobber(&path) {\n            Ok(_) => {\n                fs::File::open(root).and_then(|f| f.sync_all()).map_err(|e| e.to_string())?;\n                Ok(true)\n            }\n            Err(e) if e.error.kind() == std::io::ErrorKind::AlreadyExists => {\n                if self.read_one(&path)? != words {\n                    return Err(\"The existing thought differs. Nothing was replaced.\".into());\n                }\n                Ok(false)\n            }\n            Err(e) => Err(e.to_string()),\n        }\n    }\n\n    /// Start a local exact-word editor. No save or provider call occurs.\n    pub(crate) fn edit(&mut self) {\n        self.editor = Some(Words::new(\"\"));\n        self.notice.clear();\n    }\n\n    /// Open the saved thought list without granting goal authority.\n    pub(crate) fn view(&mut self) {\n        self.entries = self.read();\n        self.viewing = true;\n        self.scroll = 0;\n    }\n\n    /// Whether this local view owns keyboard and paste input.\n    pub(crate) fn active(&self) -> bool {\n        self.editor.is_some() || self.viewing\n    }\n\n    /// Paste exact received words without saving them.\n    pub(crate) fn paste(&mut self, text: &str) {\n        if let Some(editor) = &mut self.editor { editor.insert(text); }\n    }\n\n    /// Return an explicit unsent Think draft only on `g`; Shape is never a destination.\n    pub(crate) fn key(&mut self, key: KeyEvent) -> Option<String> {\n        if key.kind != KeyEventKind::Press { return None; }\n        if matches!(key.code, KeyCode::Esc | KeyCode::F(10)) {\n            self.editor = None;\n            self.viewing = false;\n            self.notice.clear();\n            return None;\n        }\n        if let Some(editor) = &mut self.editor {\n            if key.code == KeyCode::F(2) && key.modifiers == KeyModifiers::NONE {\n                let words = editor.text().to_owned();\n                match self.save(&words) {\n                    Ok(created) => {\n                        self.entries = self.read();\n                        self.selected = self.entries.as_ref().ok()\n                            .and_then(|entries| entries.iter().position(|w| w == &words)).unwrap_or(0);\n                        self.editor = None;\n                        self.viewing = true;\n                        self.notice = if created { \"Thought saved. No goal confirmed.\" }\n                            else { \"Thought already saved. One entry. No goal confirmed.\" }.into();\n                    }\n                    Err(reason) => self.notice = format!(\"Thought not saved: {reason}\"),\n                }\n            } else { editor.key(key); }\n            return None;\n        }\n        if key.modifiers != KeyModifiers::NONE { return None; }\n        let count = self.entries.as_ref().map_or(0, Vec::len);\n        match key.code {\n            KeyCode::Down | KeyCode::Char('j') => {\n                self.selected = (self.selected + 1).min(count.saturating_sub(1));\n                self.scroll = 0;\n            }\n            KeyCode::Up | KeyCode::Char('k') => {\n                self.selected = self.selected.saturating_sub(1);\n                self.scroll = 0;\n            }\n            KeyCode::PageDown => self.scroll = self.scroll.saturating_add(8),\n            KeyCode::PageUp => self.scroll = self.scroll.saturating_sub(8),\n            KeyCode::Char('g') => return self.entries.as_ref().ok()?.get(self.selected).cloned(),\n            _ => {}\n        }\n        None\n    }\n\n    /// A labelled garden summary. Full words remain in the local read view.\n    pub(crate) fn summary(&self) -> String {\n        match &self.entries {\n            Ok(entries) if entries.is_empty() => \"Thoughts: none · t new thought\".into(),\n            Ok(entries) => format!(\"Thoughts: {} · v read · t new thought\\nThought: {}\",\n                entries.len(), crate::clipped(entries[self.selected.min(entries.len()-1)].lines().next().unwrap_or(\"\"), 60)),\n            Err(_) => \"Thoughts could not be read. Press v for details. t new thought\".into(),\n        }\n    }\n\n    /// Render the exact-word editor or labelled local record. Rendering reads no files.\n    pub(crate) fn render(&mut self, frame: &mut Frame, area: Rect, palette: Palette) {\n        let editing = self.editor.is_some();\n        let heading = format!(\"{}\\nRepository: {}\\n{}\", if editing { \"New thought\" } else { \"Saved thoughts\" },\n            self.repo.display(), if editing { \"F2 saves exact words here. No model call. No goal confirmation.\" }\n            else { \"g opens these words in Think, unsent. Confirm a goal there. No Shape.\" });\n        frame.render_widget(Paragraph::new(heading).style(palette.ink).wrap(Wrap { trim: false }),\n            Rect { height: 4.min(area.height), ..area });\n        let body = Rect::new(area.x, area.y + 5, area.width, area.height.saturating_sub(8));\n        if let Some(editor) = &mut self.editor { editor.render(frame, body, palette, false); }\n        else {\n            let text = match &self.entries {\n                Ok(entries) if entries.is_empty() => \"No thoughts saved.\".into(),\n                Ok(entries) => format!(\"Thought {} of {}\\n{}\", self.selected + 1, entries.len(),\n                    entries[self.selected].chars().map(|c| if c.is_control() && c != '\\n' { '�' } else { c }).collect::<String>()),\n                Err(reason) => format!(\"Thoughts could not be read: {reason}\"),\n            };\n            let p = Paragraph::new(text).style(palette.ink).wrap(Wrap { trim: false });\n            self.scroll = self.scroll.min(p.line_count(body.width).saturating_sub(body.height as usize) as u16);\n            frame.render_widget(p.scroll((self.scroll, 0)), body);\n        }\n        frame.render_widget(Paragraph::new(self.notice.as_str()).style(palette.ink).wrap(Wrap { trim: false }),\n            Rect::new(area.x, area.bottom().saturating_sub(3), area.width, 2));\n        frame.render_widget(Paragraph::new(if editing { \"F2 save thought only   esc cancel\" }\n            else { \"↑↓ thoughts   PgUp/PgDn scroll   g think   esc garden\" }).style(palette.muted),\n            Rect::new(area.x, area.bottom().saturating_sub(1), area.width, 1));\n    }\n}\n"}}}}
