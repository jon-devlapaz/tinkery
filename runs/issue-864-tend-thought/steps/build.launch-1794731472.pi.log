s nothing; views lay it out with [`Note::wrap`].\n\nuse unicode_segmentation::UnicodeSegmentation;\nuse unicode_width::UnicodeWidthStr;\n\n/// Editable raw text with a grapheme caret and selection. Editing has no request-size policy.\n/// Allocation refusal leaves the existing text intact; wrapping never emits terminal controls.\npub struct Note {\n    /// The received text, including original line endings and controls.\n    pub text: String,\n    /// The caret, as a byte offset on a grapheme boundary.\n    pub cursor: usize,\n    /// Fixed end of a selection, as a logical byte offset on a grapheme boundary.\n    /// The moving end is `cursor`. Any edit clears it, so it can never outlive the text\n    /// it indexes; an anchor equal to the cursor is an empty selection.\n    anchor: Option<usize>,\n}\n\n/// A caret movement, from an arrow, Home or End key.\n#[derive(Clone, Copy, PartialEq, Eq, Debug)]\npub enum Motion {\n    /// One grapheme back.\n    Left,\n    /// One grapheme forward.\n    Right,\n    /// One wrapped row up, keeping the column as near as possible.\n    Up,\n    /// One wrapped row down, keeping the column as near as possible.\n    Down,\n    /// The start of the line.\n    Home,\n    /// The end of the line.\n    End,\n}\n\nimpl Note {\n    /// A box holding `text` as given, caret at the end, nothing selected.\n    pub fn new(text: &str) -> Self {\n        Self {\n            text: text.to_owned(),\n            cursor: text.len(),\n            anchor: None,\n        }\n    }\n\n    /// The nonempty selection as ordered logical byte offsets, if any.\n    pub fn selection(&self) -> Option<(usize, usize)> {\n        let anchor = self.anchor.filter(|a| *a != self.cursor)?;\n        let (start, end) = (anchor.min(self.cursor), anchor.max(self.cursor));\n        (self.boundary(start) && self.boundary(end)).then_some((start, end))\n    }\n\n    fn boundary(&self, index: usize) -> bool {\n        index == self.text.len()\n            || (index < self.text.len()\n                && self.text.grapheme_indices(true).any(|(i, _)| i == index))\n    }\n\n    /// Nearest grapheme boundary at or before `index` (clamped to the text).\n    fn floor(&self, index: usize) -> usize {\n        if index >= self.text.len() {\n            return self.text.len();\n        }\n        self.text\n            .grapheme_indices(true)\n            .take_while(|(i, _)| *i <= index)\n            .last()\n            .map_or(0, |(i, _)| i)\n    }\n\n    /// Keep the caret and anchor on grapheme boundaries before any edit or move, so a\n    /// stale offset can never slice inside a character.\n    fn settle(&mut self) {\n        self.cursor = self.floor(self.cursor);\n        self.anchor = self.anchor.map(|a| self.floor(a));\n    }\n\n    /// The selected text, if anything is selected.\n    pub fn selected_text(&self) -> Option<&str> {\n        let (start, end) = self.selection()?;\n        self.text.get(start..end)\n    }\n\n    /// Selects everything, caret at the end.\n    pub fn select_all(&mut self) {\n        self.anchor = (!self.text.is_empty()).then_some(0);\n        self.cursor = self.text.len();\n    }\n\n    /// Drop the selection but keep the text and the caret where it is.\n    pub fn collapse(&mut self) {\n        self.anchor = None;\n    }\n\n    /// Start a mouse drag at `index` (a grapheme boundary).\n    pub fn begin_drag(&mut self, index: usize) {\n        self.cursor = index;\n        self.anchor = Some(index);\n        self.settle();\n    }\n\n    /// Extend a drag started by [`begin_drag`]. False when an edit or a collapse has\n    /// since cleared the anchor: the drag is over and must not select anything.\n    pub fn drag_to(&mut self, index: usize) -> bool {\n        if self.anchor.is_none() {\n            return false;\n        }\n        self.cursor = index;\n\n[280 more lines in file. Use offset=111 to continue.]\n==> text 2/7 <==\n//! Shape's in-memory editor: textarea motions, selection and wrapping, with original line endings\n//! retained separately. It owns no save, folder or agent policy.\n\nuse crate::Palette;\nuse crossterm::event::{KeyCode, KeyEvent, KeyModifiers};\nuse ratatui::{\n    Frame,\n    layout::Rect,\n    style::Modifier,\n    widgets::{Paragraph, Wrap},\n};\nuse ratatui_textarea::{CursorMove, TextArea, WrapMode};\n\n#[derive(Clone)]\nstruct State {\n    raw: String,\n    editor: TextArea<'static>,\n}\n\n/// An editable box whose displayed newlines do not normalize the operator's stored words.\npub(super) struct Words {\n    state: State,\n    undo: Vec<State>,\n    redo: Vec<State>,\n    yank: String,\n}\n\nimpl Words {\n    pub(super) fn new(raw: &str) -> Self {\n        let mut editor = TextArea::default();\n        editor.set_max_histories(0);\n        editor.set_wrap_mode(WrapMode::WordOrGlyph);\n        editor.insert_str(display(raw));\n        Self {\n            state: State {\n                raw: raw.into(),\n                editor,\n            },\n            undo: Vec::new(),\n            redo: Vec::new(),\n            yank: String::new(),\n        }\n    }\n\n    pub(super) fn text(&self) -> &str {\n        &self.state.raw\n    }\n\n    #[cfg(test)]\n    pub(super) fn is_empty(&self) -> bool {\n        self.text().is_empty()\n    }\n\n    pub(super) fn clear(&mut self) {\n        *self = Self::new(\"\");\n    }\n\n    fn offset(&self, (row, col): (usize, usize)) -> usize {\n        self.state.editor.lines()[..row]\n            .iter()\n            .map(|l| l.chars().count() + 1)\n            .sum::<usize>()\n            + col\n    }\n\n\n[170 more lines in file. Use offset=66 to continue.]\n==> text 3/7 <==\n    /// Retain a captured absolute root or a default-root refusal. Never creates a directory.\n    pub fn new(root: Result<PathBuf, String>) -> Self {\n        let root = root.and_then(|root| {\n            if root.is_absolute() {\n                Ok(root)\n            } else {\n                Err(\"Links need an absolute folder; pass --link-root PATH.\".into())\n            }\n        });\n        Self {\n            root,\n            populated: Cell::new(false),\n        }\n    }\n\n    /// Read strictly: bad JSON, schema, version, entries or IO yield a refusal, never empty links.\n    pub fn read(&self) -> Read {\n        let root = match &self.root {\n            Ok(root) => root,\n            Err(reason) => return Read::Unreadable(reason.clone()),\n        };\n        let bytes = match fs::read(root.join(\"needs.json\")) {\n            Ok(bytes) => bytes,\n            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {\n                return if self.populated.get() {\n                    Read::Unreadable(\n                        \"Cannot read links: previously loaded needs.json is missing.\".into(),\n                    )\n                } else {\n                    Read::Missing\n                };\n            }\n            Err(error) => return Read::Unreadable(format!(\"Cannot read needs.json: {error}\")),\n        };\n        if serde_json::from_slice::<serde_json::Value>(&bytes).is_err() {\n            return Read::Unreadable(\"Cannot read links: needs.json is not valid JSON.\".into());\n        }\n        let file: File = match serde_json::from_slice(&bytes) {\n            Ok(file) => file,\n            Err(_) => {\n                return Read::Unreadable(\n                    \"Cannot read links: needs.json has invalid entries or fields.\".into(),\n                );\n            }\n        };\n        if file.version != 1 {\n            return Read::Unreadable(\n                \"Cannot read links: needs.json has an unsupported version.\".into(),\n            );\n        }\n        let mut entries = BTreeSet::new();\n        for link in file.needs {\n            if !valid_id(&link.goal) || !valid_id(&link.needs) || link.goal == link.needs {\n                return Read::Unreadable(\n                    \"Cannot read links: needs.json has an invalid needs link.\".into(),\n                );\n            }\n            if !entries.insert(link) {\n                return Read::Unreadable(\n                    \"Cannot read links: needs.json has a duplicate needs link.\".into(),\n                );\n            }\n        }\n        self.populated.set(!entries.is_empty());\n        Read::Readable(Links { entries })\n    }\n\n    /// Set the requested intent (`linked` adds); return links and whether they changed.\n    /// Matching files stay intact. Refuses invalid ids, self-links and unreadable stores unchanged,\n    /// including a missing previously populated file. Waits at most two seconds for a sibling lock\n    /// across re-reading and atomic replacement. Refuses changes to files we cannot write.\n    /// Returns the resulting links; IO failures are explicit and no partial file is published.\n    pub fn set(&self, goal: &str, needs: &str, linked: bool) -> Result<(Links, bool), String> {\n        if !valid_id(goal) || !valid_id(needs) {\n            return Err(\"Cannot link goals without nonempty, control-free session ids.\".into());\n        }\n        if goal == needs {\n            return Err(\"A goal cannot need itself.\".into());\n        }\n        self.read().into_links()?;\n        let root = self.root.as_ref().map_err(Clone::clone)?;\n        let lock = (|| -> std::io::Result<std::fs::File> {\n            fs::create_dir_all(root)?;\n            let lock = fs::OpenOptions::new()\n                .read(true)\n                .write(true)\n                .create(true)\n                .truncate(false)\n                .open(root.join(\"needs.lock\"))?;\n            let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);\n            loop {\n                match lock.try_lock() {\n                    Ok(()) => break,\n                    Err(std::fs::TryLockError::WouldBlock) => {\n                        if std::time::Instant::now() >= deadline {\n                            return Err(std::io::Error::new(\n                                std::io::ErrorKind::TimedOut,\n                                \"another Tinkery is saving links\",\n                            ));\n                        }\n                        std::thread::sleep(std::time::Duration::from_millis(10));\n                    }\n                    Err(std::fs::TryLockError::Error(error)) => return Err(error),\n                }\n            }\n            Ok(lock)\n        })()\n        .map_err(|error| format!(\"Cannot save needs.json: {error}\"))?;\n        let mut links = self.read().into_links()?;\n        let link = Link {\n            goal: goal.into(),\n            needs: needs.into(),\n        };\n        if links.contains(goal, needs) == linked {\n            return Ok((links, false));\n        }\n        if linked {\n            links.entries.insert(link);\n        } else {\n            links.entries.remove(&link);\n        }\n        let file = File {\n            version: 1,\n            needs: links.entries.iter().cloned().collect(),\n        };\n        let write = || -> Result<(), String> {\n            let bytes = serde_json::to_vec(&file).map_err(|error| error.to_string())?;\n            match fs::metadata(root.join(\"needs.json\")) {\n                Ok(metadata) => {\n                    if metadata.permissions().readonly() {\n                        return Err(\"The existing links file is read-only.\".into());\n                    }\n                    // Opening without truncation checks this process's permissions, including ACLs.\n                    fs::OpenOptions::new()\n                        .write(true)\n                        .open(root.join(\"needs.json\"))\n                        .map_err(|error| error.to_string())?;\n                }\n                Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}\n                Err(error) => return Err(error.to_string()),\n            }\n            let mut temp =\n                tempfile::NamedTempFile::new_in(root).map_err(|error| error.to_string())?;\n            temp.write_all(&bytes).map_err(|error| error.to_string())?;\n            temp.as_file()\n                .sync_all()\n                .map_err(|error| error.to_string())?;\n            temp.persist(root.join(\"needs.json\"))\n                .map_err(|error| error.to_string())?;\n            Ok(())\n        };\n        write().map_err(|error| format!(\"Cannot save needs.json: {error}\"))?;\n        self.populated.set(!links.entries.is_empty());\n        drop(lock);\n        Ok((links, true))\n\n[353 more lines in file. Use offset=315 to continue.]\n==> text 4/7 <==\n            shaping: Shaping::default(),\n            handoff: Handoff::default(),\n            host,\n            voice: None,\n            real,\n            notice: \"Nothing saved. Submit when ready; no guess before then.\".into(),\n            local_checks: vec![],\n            copy: None,\n            exit: Exit::Stay,\n        }\n    }\n    /// Populate a fresh unsent draft and retain its separate provenance, never as a source.\n    /// Menu supplies a new visit; subsequent edits are submitted only by the normal F2 path.\n    pub(crate) fn offer_draft(&mut self, draft: crate::think_record::DraftSuggestion) {\n        assert!(self.conversation.is_empty() && self.input.text.is_empty());\n        if self.input.insert(&draft.text).is_err() {\n            self.refuse(layout::LIMIT_TEXT);\n            return;\n        }\n        self.conversation.offer_draft(draft);\n        self.notice = \"Tinkery's guess · edit freely; F2 sends your words. Nothing saved.\".into();\n    }\n    /// What think asks of whoever opened it, read after each tick.\n    pub fn exit(&self) -> &Exit {\n        &self.exit\n    }\n    /// What has been said and read so far.\n    pub fn conversation(&self) -> &Conversation {\n        &self.conversation\n    }\n\n[1381 more lines in file. Use offset=375 to continue.]\n==> text 5/7 <==\n//! Architecture checks: the design limits in `docs/design/architecture.md`, read from the source.\n//!\n//! Each limit records today's truth and may only get stricter. A check fails when the code gets\n//! worse than its limit, and also when it gets better, so the limit is lowered in the same PR and\n//! the gain can't quietly slip back. Test code is not checked: anything behind `#[cfg(test)]` is\n//! skipped, except the count of tests that reach into Think's private conversation state.\n\nuse std::{\n    fs,\n    path::{Path, PathBuf},\n};\n\nuse syn::{Attribute, Item, UseTree, spanned::Spanned, visit::Visit};\n\n/// Most fields `BrainDump` may have. Since #37 it holds its parts (the conversation, screen,\n/// shaping call and handoff) rather than their fields.\nconst BRAIN_DUMP_FIELDS: usize = 13;\n/// Most `pub` fields `BrainDump` may have. The menu reads `exit()` and `saved()` instead.\nconst BRAIN_DUMP_PUB_FIELDS: usize = 0;\n/// Most non-test source lines longer than [`LONG_LINE`] characters. Since #38 the model prompts\n/// live in their own files; what remains is help and display text.\nconst LONG_LINES: usize = 5;\nconst LONG_LINE: usize = 200;\n/// Most calls to the test-only accessors on Think's `Conversation`. Tests that poke private state\n/// break on refactors that keep behavior; new tests drive Think through its real input instead.\nconst CONVERSATION_TEST_ACCESS: usize = 77;\nconst CONVERSATION_TEST_ACCESSORS: &[&str] = &[\n    \"sources_mut\",\n    \"fragments_mut\",\n    \"settled_mut\",\n    \"set_last_failure\",\n    \"set_changed_lines\",\n    \"set_board\",\n    \"set_applied\",\n    \"skipped_mut\",\n    \"set_scope_pending\",\n    \"ask_counts_mut\",\n    \"ask_counts\",\n];\n\n/// Every top-level module and its area. Each phase has its own module; the menu is the only one\n/// that knows every phase; `shared` is code any phase may use.\n/// A new module must be listed here, so a new phase can't count as shared code by default.\nconst MODULES: &[(&str, &str)] = &[\n    (\"actions\", \"shared\"),\n    (\"approve\", \"approve\"),\n    (\"calendar\", \"shared\"),\n    (\"goal\", \"shared\"),\n    (\"measure\", \"measure\"),\n    (\"menu\", \"menu\"),\n    (\"model_setup\", \"shared\"),\n    (\"pi\", \"shared\"),\n    (\"repo\", \"shared\"),\n    (\"sdlc\", \"shared\"),\n    (\"seed_me\", \"shared\"),\n    (\"shape\", \"shape\"),\n    (\"tend\", \"tend\"),\n    (\"think\", \"think\"),\n    (\"think_record\", \"shared\"),\n    (\"voice\", \"shared\"),\n    (\"watch\", \"watch\"),\n    (\"worker\", \"shared\"),\n    (\"taste\", \"taste\"),\n];\n\n#[test]\nfn every_top_level_module_has_an_area() {\n    let lib = syn::parse_file(&fs::read_to_string(root().join(\"src/lib.rs\")).unwrap()).unwrap();\n    let declared: Vec<_> = lib\n        .items\n        .iter()\n        .filter_map(|item| match item {\n            Item::Mod(m) if !is_test(&m.attrs) => Some(m.ident.to_string()),\n            _ => None,\n        })\n        .collect();\n    let unlisted: Vec<_> = declared\n        .iter()\n        .filter(|d| !MODULES.iter().any(|(m, _)| m == d))\n        .collect();\n    assert!(\n        unlisted.is_empty(),\n        \"src/lib.rs declares modules MODULES doesn't list; add each with its area: {unlisted:?}\"\n    );\n    let missing: Vec<_> = MODULES\n        .iter()\n        .filter(|(m, _)| !declared.iter().any(|d| d == m))\n        .collect();\n    assert!(\n        missing.is_empty(),\n        \"MODULES lists modules src/lib.rs no longer declares: {missing:?}\"\n    );\n}\n\n/// The area a module path (without `crate`) belongs to. Items at the crate root are shared.\nfn area(path: &[String]) -> &'static str {\n    path.first()\n        .and_then(|first| MODULES.iter().find(|(m, _)| m == first))\n        .map_or(\"shared\", |(_, area)| area)\n}\n\n/// May code in area `from` name code in area `to`? Only the menu knows every phase; anything\n/// may use shared code; shared code names no phase.\nfn allowed(from: &str, to: &str) -> bool {\n    from == to || from == \"menu\" || to == \"shared\"\n}\n\n#[test]\nfn phases_never_reach_each_other() {\n    let mut violations = vec![];\n    for (file, module) in production_files() {\n        let from = area(&module);\n        for target in references(&file, &module) {\n            let to = area(&target);\n            if !allowed(from, to) {\n                violations.push(format!(\n                    \"{} ({from}) uses {} ({to})\",\n                    rel(&file),\n                    target.join(\"::\")\n                ));\n            }\n        }\n    }\n    assert!(\n        violations.is_empty(),\n        \"A phase reaches into another phase. Go through shared code or the menu instead:\\n{}\",\n        violations.join(\"\\n\")\n    );\n}\n\n/// Lints `src/lib.rs` must deny for the whole library. `missing_docs` makes every reachable item\n/// carry an interface comment; `unreachable_pub` makes an item that isn't reachable say so with\n/// `pub(super)` or `pub(crate)` instead of `pub`. Together: every `pub` item is documented.\nconst DENIED_LINTS: &[&str] = &[\"missing_docs\", \"unreachable_pub\"];\n\n#[test]\nfn every_public_item_has_an_interface_comment() {\n    let lib = syn::parse_file(&fs::read_to_string(root().join(\"src/lib.rs\")).unwrap()).unwrap();\n    let denied: Vec<String> = lib\n        .attrs\n        .iter()\n        .filter(|a| a.path().is_ident(\"deny\"))\n        .filter_map(|a| a.meta.require_list().ok())\n        .flat_map(|l| {\n            l.tokens\n                .to_string()\n                .split(',')\n                .map(|lint| lint.trim().to_owned())\n                .collect::<Vec<_>>()\n        })\n        .collect();\n    let missing: Vec<_> = DENIED_LINTS\n        .iter()\n        .filter(|lint| !denied.iter().any(|d| d == *lint))\n        .collect();\n    assert!(\n        missing.is_empty(),\n        \"src/lib.rs must keep `#![deny({})]`; missing: {missing:?}\",\n        DENIED_LINTS.join(\", \")\n    );\n\n[326 more lines in file. Use offset=161 to continue.]\n==> text 6/7 <==\n\"\"\"One explicit connection and durable Shape handoff, using real PTYs and a fake provider.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport time\nimport test_launch as subprocess\nfrom terminal_process import TerminalProcess, wait_output\n\nREPO = Path(__file__).resolve().parents[1]\nF2 = b'\\x1bOQ'\nF10 = b'\\x1b[21~'\n\n\ndef wait(term, text):\n    for code in wait_output(term.master, term.process, term.screen.feed, time.monotonic()+15):\n        if not term.screen.synchronized and text in term.screen.text():\n            return term.screen.text()\n        if code is not None:\n            break\n    raise AssertionError(f'Missing {text!r}:\\n{term.screen.text()}')\n\n\ndef send(term, keys, text):\n    os.write(term.master, keys)\n    return wait(term, text)\n\n\ndef fixture(root):\n    repo = root/'repo'\n    (repo/'.git').mkdir(parents=True)\n    records = root/'records'; records.mkdir()\n    sessions = root/'sessions'; sessions.mkdir()\n    for index, goal in enumerate(['TEST find repeated support requests\\nKeep their original words.', 'TEST make documentation easier to find\\nMeasure missed answers.']):\n        name = f'goal-{index}'\n        folder = sessions/name; folder.mkdir()\n        (folder/'ledger.json').write_text(json.dumps(dict(schema_version=1, session_id=name, status='active', goal=goal, updated_at='2026-11-14T00:00:00Z')))\n        (records/f'{name}.json').write_text(json.dumps(dict(schema=3, tinkery='TEST', origin='simulated',\n            model=None, thinking=None, prompt_hash=None, started='2026-11-14T00:00:00Z', confirmed='2026-11-14T00:00:00Z',\n            seed_me_session=name, seed_me_session_path=str(folder), seed_me_session_id=name,\n            turns=[], checks=[], goal=goal, repo=str(repo))))\n    provider = root/'fake-pi'\n    provider.write_text(f'''#!{sys.executable}\nimport json,sys,time\nfrom pathlib import Path\nroot=Path({str(root)!r})\nvalue=json.load(sys.stdin)\nwith (root/'requests').open('a') as f: f.write(json.dumps(dict(input=value,args=sys.argv))+'\\\\n')\nmode=(root/'mode').read_text() if (root/'mode').exists() else 'good'\nif mode=='slow': time.sleep(30)\nsources=value['sources'][:2]\nproposal=dict(sources=[dict(id=s['id'],quote=s['goal']) for s in sources], relationship='TEST support gaps can guide documentation.',\n goal='TEST connect support gaps to documentation.', outcome='TEST one linked support example.', question='TEST was an answer easier to find?', assumptions=['TEST both goals concern the same users.'])\nif mode=='bad': proposal['sources'][0]['quote']='not an exact source quote'\nprint(json.dumps(dict(connection=None if mode=='none' else proposal)))\n''')\n    provider.chmod(0o755)\n    return repo\n\n\ndef launch(root, repo, width, height, budget=2):\n    env=subprocess.environment({**os.environ, 'TERM':'xterm-256color','NO_COLOR':'1','TINKERY_NODE':'/tinkery-TEST-no-node'})\n    term=TerminalProcess([str(REPO/'target/debug/tinkery'),'--operator','agent','--home','--shape-pi','--model','test/model',\n        '--shape-budget',str(budget),'--pi-command',str(root/'fake-pi'),'--seed-session-root',str(root/'sessions'),\n        '--record-root',str(root/'records'),'--link-root',str(root/'links')],cwd=repo,env=env,width=width,height=height)\n    wait(term,'1  think');send(term,b'2','this repo');send(term,b'f','Find connections')\n    return term\n\n\ndef requests(root):\n    return [json.loads(line) for line in (root/'requests').read_text().splitlines()] if (root/'requests').exists() else []\n\n\ndef journey(width,height):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-connection-') as directory:\n        root=Path(directory).resolve();repo=fixture(root)\n        originals={p:p.read_bytes() for p in (root/'sessions').glob('*/ledger.json')}\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'F2 find one connection')\n            assert not requests(root)\n            send(term,F2,'p prepare this goal')\n            assert len(requests(root))==1\n            assert '--no-tools' in requests(root)[0]['args']\n            send(term,b'\\x1b','this repo')\n        finally: term.close()\n        # Kill and relaunch the application. The result is durable, not a second request.\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'p prepare this goal');assert len(requests(root))==1\n            send(term,b'p','F2 save exact words')\n            os.write(term.master,b' EDITED')\n            send(term,F2,'tinkery › shape')\n            assert len(requests(root))==1\n        finally: term.close()\n        stored=list((root/'links').glob('connection-*.json'));assert len(stored)==1\n        record=json.loads(stored[0].read_text());saved=Path(record['saved'])\n        ledger=json.loads((saved/'ledger.json').read_text())\n        assert 'EDITED' in ledger['goal']\n        assert record['pending']['origin']['goal']==ledger['goal']\n        assert all(p.read_bytes()==b for p,b in originals.items())\n        # Emulate loss of only the final exploration update after real publication.\n        record['saved']=None;stored[0].write_text(json.dumps(record))\n        term=launch(root,repo,width,height)\n        try:\n            assert 'EDITED' in wait(term,'F2 resume saving')\n            send(term,F2,'tinkery › shape')\n            assert len(requests(root))==1\n            assert len(list((root/'sessions').iterdir()))==3\n        finally: term.close()\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'F2 find a fresh connection')\n            send(term,F2,'p prepare this goal')\n            assert len(requests(root))==2\n        finally: term.close()\n\n\ndef refusal(mode, expected, budget=2, unknown=False):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-connection-refusal-') as directory:\n        root=Path(directory).resolve();repo=fixture(root);(root/'mode').write_text(mode)\n        if unknown: (root/'records'/'goal-1.json').unlink()\n        term=launch(root,repo,100,30,budget)\n        try:\n            if unknown: wait(term,expected)\n            else:\n                wait(term,\"F2 find one connection\")\n                send(term,F2,expected)\n            assert len(requests(root))==(0 if unknown or budget==0 else 1)\n            assert len(list((root/'sessions').iterdir()))==2\n        finally: term.close()\n\n\ndef update_goal(root, name, **changes):\n    path=root/'sessions'/name/'ledger.json'\n    value=json.loads(path.read_text());value.update(changes);path.write_text(json.dumps(value))\n    if 'goal' in changes:\n        path=root/'records'/f'{name}.json'\n        value=json.loads(path.read_text());value['goal']=changes['goal'];path.write_text(json.dumps(value))\n\n\ndef input_refusals():\n    cases=[('one','at least two'),('many','at most 20'),('large','32 KiB'),('incomplete','incomplete'),('duplicate','unknown or invalid')]\n    for case, expected in cases:\n        with tempfile.TemporaryDirectory(prefix='tinkery-TEST-input-') as directory:\n            root=Path(directory).resolve();repo=fixture(root)\n            if case=='one': update_goal(root,'goal-1',status='stopped')\n            elif case=='large': update_goal(root,'goal-0',goal='TEST '+('x'*33000))\n            elif case=='incomplete': (root/'sessions'/'goal-1'/'ledger.json').write_text('broken')\n            elif case=='duplicate': update_goal(root,'goal-1',session_id='goal-0')\n            elif case=='many':\n                for i in range(2,21):\n                    name=f'goal-{i}';folder=root/'sessions'/name;folder.mkdir()\n                    ledger=json.loads((root/'sessions'/'goal-0'/'ledger.json').read_text());ledger['session_id']=name\n                    (folder/'ledger.json').write_text(json.dumps(ledger))\n                    record=json.loads((root/'records'/'goal-0.json').read_text())\n                    record.update(seed_me_session=name,seed_me_session_id=name,seed_me_session_path=str(folder))\n                    (root/'records'/f'{name}.json').write_text(json.dumps(record))\n            term=launch(root,repo,100,30)\n            try:\n                wait(term,expected);os.write(term.master,F2);time.sleep(.1)\n                assert not requests(root)\n            finally: term.close()\n\n\ndef cancellation_and_dismissal():\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-cancel-') as directory:\n        root=Path(directory).resolve();repo=fixture(root);(root/'mode').write_text('slow')\n        term=launch(root,repo,100,30)\n        try:\n            wait(term,'F2 find one connection');send(term,F2,'Working')\n            deadline=time.monotonic()+5\n            while not requests(root) and time.monotonic()<deadline: time.sleep(.01)\n            send(term,b'\\x1b','this repo');time.sleep(.2)\n            assert len(requests(root))==1\n            assert not list((root/'links').glob('connection-*.json'))\n        finally: term.close()\n        (root/'mode').write_text('good')\n        term=launch(root,repo,100,30)\n        try:\n            wait(term,'F2 find one connection');send(term,F2,'p prepare this goal')\n            send(term,b'd','Dismissed.')\n        finally: term.close()\n        term=launch(root,repo,100,30)\n        try:\n            wait(term,'Dismissed.');os.write(term.master,F2);time.sleep(.1)\n            assert len(requests(root))==2\n            assert len(list((root/'sessions').iterdir()))==2\n        finally: term.close()\n\n[99 more lines in file. Use offset=191 to continue.]\n==> text 7/7 <==\n        let (configured, budget) = self\n            .call\n            .as_ref()\n            .ok_or(\"Choose a drafting model and allowance before finding connections.\")?;\n        let mut call = configured.clone();\n        call.read_only_tools = false;\n        call.folder = None;\n        let reply = call.complete(\n            budget,\n            Request::Connection,\n            serde_json::to_vec(input).map_err(|e| e.to_string())?,\n            pi_prompt(),\n            stop,\n        )?;\n        if reply.len() > LIMIT {\n            return Err(\"The connection reply is oversized.\".into());\n        }\n        #[derive(Deserialize)]\n        #[serde(deny_unknown_fields)]\n        struct Reply {\n            connection: Option<Proposal>,\n        }\n        let value: serde_json::Value =\n            serde_json::from_str(&reply).map_err(|_| \"The connection reply is not valid JSON.\")?;\n        if !value\n            .as_object()\n            .is_some_and(|o| o.len() == 1 && o.contains_key(\"connection\"))\n        {\n            return Err(\"The connection reply must contain exactly one connection field.\".into());\n        }\n        let reply: Reply = serde_json::from_value(value)\n            .map_err(|_| \"The connection reply is not valid structured data.\")?;\n        if let Some(proposal) = &reply.connection {\n            proposal.validate(input)?;\n        }\n        if &self.snapshot()? != input {\n            return Err(\n                \"The goal inputs changed during discovery. No new result was saved.\".into(),\n            );\n        }\n        let record = Record {\n            schema: 2,\n            input: input.clone(),\n            proposal: reply.connection,\n            dismissed: false,\n            pending: None,\n            saved: None,\n        };\n        self.write(&record)?;\n        Ok(record)\n    }\n    fn dismiss(&self, shown: &Record) -> Result<Record, String> {\n        let _lock = self.lock()?;\n        let mut record = self.read()?.ok_or(\"The exploration is missing.\")?;\n        if &record != shown || record.pending.is_some() {\n            return Err(\"The exploration changed or has a pending save. Reopen it.\".into());\n        }\n        record.dismissed = true;\n        self.write(&record)?;\n        Ok(record)\n    }\n    fn save(&self, shown: &Record, words: &str) -> Result<(Record, seed_me::Receipt), String> {\n        let _lock = self.lock()?;\n        let mut record = self.read()?.ok_or(\"The exploration is missing.\")?;\n        if &record != shown {\n            return Err(\"The exploration changed. Reopen it before saving.\".into());\n        }\n        if record.pending.is_none() {\n            if record.dismissed {\n                return Err(\"This connection was dismissed.\".into());\n            }\n            if self.snapshot()? != record.input {\n                return Err(\"The source inputs changed. Find a fresh connection.\".into());\n            }\n            let proposal = record\n                .proposal\n                .as_ref()\n                .ok_or(\"There is no proposed goal to save.\")?;\n            record.pending = Some(Pending::prepare(\n                &self.sessions,\n                proposal.origin(&record.input, words),\n                proposal.outcome.clone(),\n                self.actor.clone(),\n            )?);\n            self.write(&record)?;\n        }\n        let pending = record.pending.as_ref().expect(\"prepared above\");\n        let receipt = pending.resume(|| {\n            let mut current = self.snapshot()?;\n            // A legacy pending handoff keeps its original prompt across this format upgrade.\n            if record.schema == 1 {\n                current.prompt.clone_from(&record.input.prompt);\n            }\n            if current == record.input {\n                Ok(())\n            } else {\n                Err(\"The source inputs changed before publication.\".into())\n            }\n        })?;\n        record.saved = Some(receipt.session.clone());\n        self.write(&record)?;\n        Ok((record, receipt))\n    }\n    fn cancel(&self, shown: &Record) -> Result<Record, String> {\n        let _lock = self.lock()?;\n        let mut record = self.read()?.ok_or(\"The exploration is missing.\")?;\n        if &record != shown {\n       