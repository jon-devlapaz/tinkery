n        {\n            editor.insert_str(text);\n        }\n    }\n\n    /// Handle explicit review actions. True returns to Tend without starting anything.\n    pub(crate) fn key(&mut self, key: KeyEvent) -> bool {\n        if key.kind != KeyEventKind::Press {\n            return false;\n        }\n        if matches!(key.code, KeyCode::Esc | KeyCode::F(10)) {\n            if self.editor.take().is_some() {\n                return false;\n            }\n            self.stop.store(true, Ordering::Relaxed);\n            return true;\n        }\n        if self.running.is_some() {\n            return false;\n        }\n        if let Some((editor, kind)) = &mut self.editor {\n            if matches!(kind, EditKind::Correction { .. }) && key.code == KeyCode::Tab {\n                self.editor_context = !self.editor_context;\n                return false;\n\n[413 more lines in file. Use offset=181 to continue.]\n\n[Full output: /var/folders/sk/r2ns7lvn2ygcsj7bhd0mvnyw0000gn/T/pi-codemode-d134540e096bad36.txt (read with offset/limit)]"}],"details":{"calls":[{"id":"call_44ba6cda36564618b03906859c3b9210|ctc_0df587760909a640016af96de1fbc887d1b8f8b604ae5329c6/1","name":"read","args":"{\"path\":\"src/tend/mod.rs\"}","status":"ok","durationMs":1.2199589999981981},{"id":"call_44ba6cda36564618b03906859c3b9210|ctc_0df587760909a640016af96de1fbc887d1b8f8b604ae5329c6/2","name":"read","args":"{\"path\":\"src/tend/garden.rs\"}","status":"ok","durationMs":0.8768749999981083},{"id":"call_44ba6cda36564618b03906859c3b9210|ctc_0df587760909a640016af96de1fbc887d1b8f8b604ae5329c6/3","name":"read","args":"{\"path\":\"src/tend/discovery.rs\"}","status":"ok","durationMs":0.5905000000020664},{"id":"call_44ba6cda36564618b03906859c3b9210|ctc_0df587760909a640016af96de1fbc887d1b8f8b604ae5329c6/4","name":"read","args":"{\"path\":\"src/menu.rs\"}","status":"ok","durationMs":1.4530420000010054},{"id":"call_44ba6cda36564618b03906859c3b9210|ctc_0df587760909a640016af96de1fbc887d1b8f8b604ae5329c6/5","name"