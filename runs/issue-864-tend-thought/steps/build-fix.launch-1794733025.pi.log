m,flow.F2,'32 KiB')\\n            assert len(flow.requests(root))==1\\n            assert len(json.loads(correction(root).read_text())['correction']['text'])==2048\\n            os.write(term.master,flow.F2);settle(term);assert len(flow.requests(root))==1\\n        finally: term.close()\\n    for case in ['v1-extra','v2-missing','unknown','pending-missing']:\\n        with tempfile.TemporaryDirectory(prefix='tinkery-TEST-correction-format-') as directory:\\n            root=Path(directory).resolve();repo=flow.fixture(root)\\n            term=discover(root,repo)\\n            try:\\n                save_correction(term);flow.send(term,flow.F2,'p prepare this goal')\\n                flow.send(term,b'p','F2 save exact words');flow.send(term,flow.F2,'tinkery › shape')\\n            finally: term.close()\\n            path=exploration(root);record=json.loads(path.read_text())\\n            if case=='v1-extra': record['schema']=1\\n            elif case=='v2-missing': del record['input']['correction']\\n            elif case=='unknown': record['schema']=99\\n            else: del record['pending']['origin']['correction']\\n            path.write_text(json.dumps(record));before=path.read_bytes()\\n            term=flow.launch(root,repo,100,30,budget=0)\\n            try:\\n                flow.wait(term,'latest exploration is malformed');settle(term)\\n                assert path.read_bytes()==before\\n                assert len(flow.requests(root))==2\\n            finally: term.close()\\n    print('complete input limit and four strict exploration/receipt format refusals passed')\\n\\n\\nif __name__=='__main__':\\n    subprocess.run(['cargo','+stable','build','--locked','--quiet'],cwd=flow.REPO,env=subprocess.environment(),check=True)\\n    for size in [(80,24),(100,30)]:\\n        journey(size)\\n        capture_context_and_exact_replacement(size)\\n    exact_trailing_newline()\\n    long_repository_capture()\\n    edits_and_conflicts()\\n    malformed_and_legacy()\\n    disclosure_matches_request()\\n    failed_write_keeps_words()\\n    stale_goal_and_pending()\\n    input_limit_and_format_refusals()\\n    print('Correction journeys passed. Fake responses prove transfer mechanics, not usefulness or relevance.')\\n\"}\n==> text 4/7 <==\n{\"path\":\"tests/test_launch.py\",\"content\":\"\\\"\\\"\\\"The sole process boundary for Python tests: Tinkery never inherits operator HOME.\\\"\\\"\\\"\\nimport atexit\\nimport os\\nfrom pathlib import Path\\nimport pwd\\nimport subprocess\\nimport sys\\nimport tempfile\\n\\n# Keep subprocess result/error types and pipe constants available to test callers.\\nCalledProcessError = subprocess.CalledProcessError\\nTimeoutExpired = subprocess.TimeoutExpired\\nPIPE = subprocess.PIPE\\nDEVNULL = subprocess.DEVNULL\\nSTDOUT = subprocess.STDOUT\\n\\n_home = None\\n\\n\\nclass UnsafeTestHome(ValueError):\\n    \\\"\\\"\\\"The requested process environment is not an isolated TEST home.\\\"\\\"\\\"\\n\\n\\ndef environment(base=None, *, home=None):\\n    \\\"\\\"\\\"Explicitly select a TEST home; by default allocate one for this test process.\\n\\n    Caller-selected homes must already exist. Preserve tool caches, not application\\n    data, when changing HOME so fixture builds need no toolchain installation.\\n    \\\"\\\"\\\"\\n    global _home\\n    env = dict(os.environ if base is None else base)\\n    real_home = pwd.getpwuid(os.getuid()).pw_dir\\n    env.setdefault('CARGO_HOME', str(Path(real_home) / '.cargo'))\\n    env.setdefault('RUSTUP_HOME', str(Path(real_home) / '.rustup'))\\n    if home is None:\\n        if _home is None:\\n            _home = tempfile.TemporaryDirectory(prefix='tinkery-TEST-launch-home-')\\n            atexit.register(_home.cleanup)\\n        home = _home.name\\n    env['HOME'] = str(home)\\n    env.setdefault('TINKERY_NODE', '/tinkery-TEST-no-node')\\n    return _checked_environment(env, create=True)\\n\\n\\ndef _checked_environment(env, *, create=False):\\n    \\\"\\\"\\\"Refuse unsafe HOME before any subprocess API can start an executable.\\\"\\\"\\\"\\n    if env is None or not env.get('HOME'):\\n        raise UnsafeTestHome('Test launches require an explicit temporary TEST HOME.')\\n    home = Path(env['HOME'])\\n    if not home.is_absolute():\\n        raise UnsafeTestHome('Test HOME must be absolute.')\\n    home = home.resolve()\\n    real_home = Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()\\n    if home == real_home:\\n        raise UnsafeTestHome('Refusing to launch with the password-database real home.')\\n    temporary_roots = (Path(tempfile.gettempdir()).resolve(), Path('/tmp').resolve(),\\n                       Path('/var/tmp').resolve(),\\n                       (Path(__file__).resolve().parents[1] / 'target/tmp').resolve())\\n    if (not any(home.is_relative_to(root) for root in temporary_roots)\\n            or not any('TEST' in part for part in home.parts)):\\n        raise UnsafeTestHome('Test HOME must be a temporary TEST folder.')\\n    if create:\\n        home.mkdir(parents=True, exist_ok=True)\\n    if not home.is_dir():\\n        raise UnsafeTestHome('Test HOME must be an existing temporary TEST folder.')\\n    return dict(env)\\n\\n\\ndef Popen(*args, env=None, **kwargs):\\n    \\\"\\\"\\\"Start a process only with a guarded TEST HOME, including PTY launches.\\\"\\\"\\\"\\n    return subprocess.Popen(*args, env=_checked_environment(env), **kwargs)\\n\\n\\ndef run(*args, env=None, **kwargs):\\n    \\\"\\\"\\\"Run a bounded test command with the same launch guard.\\\"\\\"\\\"\\n    return subprocess.run(*args, env=_checked_environment(env), **kwargs)\\n\\n\\ndef check_output(*args, env=None, **kwargs):\\n    \\\"\\\"\\\"Capture test output with the same launch guard.\\\"\\\"\\\"\\n    return subprocess.check_output(*args, env=_checked_environment(env), **kwargs)\\n\\n\\nif __name__ == '__main__' and len(sys.argv) > 1:\\n    raise SystemExit(run(sys.argv[1:], env=dict(os.environ)).returncode)\\n\"}\n==> text 5/7 <==\n{\"path\":\"scripts/full-check.py\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"Execute the single authoritative AGENTS full-check block in an isolated TEST home.\\n\\nKeeps the existing installed compiler/cache locations; never installs tools or uses\\noperator application roots. No external skill checkout is needed.\\n\\\"\\\"\\\"\\nimport os\\nfrom pathlib import Path\\nimport re\\nimport sys\\nimport tempfile\\n\\nROOT = Path(__file__).resolve().parents[1]\\nsys.path.insert(0, str(ROOT / 'tests'))\\nimport test_launch\\n\\n\\ndef block():\\n    source = (ROOT / 'AGENTS.md').read_text()\\n    markers = ['<!-- full-check:start -->', '<!-- full-check:end -->']\\n    if any(source.count(marker) != 1 for marker in markers):\\n        raise ValueError('Expected exactly one pair of full-check markers')\\n    section = source.split(markers[0], 1)[1].split(markers[1], 1)[0]\\n    blocks = re.findall(r'```bash\\\\n(.*?)\\\\n```', section, re.S)\\n    if len(blocks) != 1 or not blocks[0].strip():\\n        raise ValueError('Expected exactly one nonempty documented verification block')\\n    return blocks[0] + '\\\\n'\\n\\n\\ndef main():\\n    command = block()\\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-full-check-') as directory:\\n        home = Path(directory) / 'HOME'\\n        home.mkdir()\\n        env = dict(os.environ)\\n        installed_home = Path(env['HOME'])\\n        env.setdefault('CARGO_HOME', str(installed_home / '.cargo'))\\n        env.setdefault('RUSTUP_HOME', str(installed_home / '.rustup'))\\n        env.pop('SEED_ME_TEST_SKILL', None)\\n        # A tink-sdlc build step marks its worker env; label tests run outside that session.\\n        env.pop('TINK_SDLC_STEP_SESSION', None)\\n        env.update(HOME=str(home), PYTHONDONTWRITEBYTECODE='1', TINKERY_NODE='/tinkery-TEST-no-node')\\n        script = Path(directory) / 'full-check.sh'\\n        script.write_text(command)\\n        print('Exact AGENTS full-check; temporary TEST HOME', flush=True)\\n        test_launch.run(['bash', '-euo', 'pipefail', str(script)], cwd=ROOT, env=env, check=True)\\n\\n\\nif __name__ == '__main__':\\n    main()\\n\"}\n==> text 6/7 <==\nthought.rs:1: //! Exact repository thoughts in Tend's private store. Thoughts never become sessions or model\nthought.rs:43:     /// Read only thoughts belonging to the captured launch repository; never infer attribution.\nthought.rs:252:                 \"Thoughts: {} · v read · t new thought\\nThought: {}\",\nthought.rs:262:             Err(_) => \"Thoughts could not be read. Press v for details. t new thought\".into(),\nthought.rs:274:                 \"Saved thoughts\"\nthought.rs:304:                 Ok(entries) if entries.is_empty() => \"No thoughts saved.\".into(),\nthought.rs:339:                 \"↑↓ thoughts   PgUp/PgDn scroll   g think   esc garden\"\nmod.rs:68:     pub(super) thoughts: Option<thought::Garden>,\nmod.rs:109:             thoughts: None,\nmod.rs:304:                 .thoughts\nmod.rs:433:             \"t thought   v thoughts   f connections   a toggle goals   esc back\"\nmod.rs:440:         \"arrows move   enter open   t thought   v read   f connect   l link   esc back\"\nmod.rs:471:         && let Some(thoughts) = &tend.thoughts\nmod.rs:472:         && !thoughts.summary().is_empty()\nmod.rs:475:             Paragraph::new(thoughts.summary()).style(palette.ink),\nconnection/panel.rs:469:                     keys = \"F2 find one connection   ↑↓ scroll sources   esc back\";\n==> text 7/7 <==\n//! Shape without a screen: one command saves a goal, and one command takes one explicit step.\n//!\n//! For an agent or a script, a key bar is friction, so the same ledger and step run from named\n//! actions. Each call is one explicit action under the launch's declared authority and call\n//! budget; nothing loops, retries or confirms on its own. Confirming names the SHA-256 of the\n//! draft bytes the caller read, which is this interface's \"read to the end\". It adds no rule:\n//! the ledger refuses what it refuses on screen.\n\nuse std::path::{Path, PathBuf};\nuse std::sync::atomic::AtomicBool;\n\nuse sha2::{Digest, Sha256};\n\nuse super::step::{self, Agent, Done, Why, Work};\nuse crate::seed_me::{\n    self,\n    answering::{self, Refusal},\n    ledger::AnswerAction,\n    shaping::{self, Shaped},\n};\nuse crate::think_record::GoalConfirmation;\n\nconst STALE: &str = \"Another writer changed this session first; nothing more was saved.\";\n\n/// The one thing a `seed step` call does.\n#[derive(Debug, Clone, PartialEq, Eq)]\npub enum Action {\n    /// Look into the next question, or draft the seed, when nothing is being asked.\n    Look,\n    /// Save these words as the answer to the current question, then look.\n    Answer(String),\n    /// Accept the current question's recorded suggestion, then look.\n    Delegate,\n    /// Confirm the draft whose exact bytes have this SHA-256.\n    Confirm(String),\n}\n\n/// Save `goal` as a new session's confirmed goal under `root`, attributed as `confirmation`\n/// declares, and return the session. The words are kept exactly, as the goal and as its one\n/// original; `origin` says where they came from. The record says a command saved the goal and\n/// nobody was shown it. Calls no model and confirms no seed.\npub fn new_goal(\n    root: PathBuf,\n    goal: &str,\n    origin: &str,\n    confirmation: &GoalConfirmation,\n) -> Result<PathBuf, String> {\n    if goal.trim().is_empty() {\n        return Err(\"The goal is empty; nothing was saved.\".into());\n    }\n    // A goal that states its own check keeps it; the ledger reads the same `Done when:` line.\n    let outcome = goal\n        .lines()\n        .find_map(|line| line.trim().strip_prefix(\"Done when:\"))\n        .map_or(\"\", str::trim);\n    let declared = match confirmation.actor()? {\n        crate::think_record::Actor::Agent(_) => \"agent\",\n        crate::think_record::Actor::Operator => \"human\",\n    };\n    let receipt = seed_me::Config::new(Some(root)).confirm_as(\n        seed_me::Affirmed {\n            goal: goal.to_owned(),\n            outcome: outcome.to_owned(),\n            options: Vec::new(),\n            originals: vec![seed_me::Original {\n                id: 1,\n                in_reply_to: None,\n                text: goal.to_owned(),\n            }],\n            context: serde_json::json!({\"origin\": origin, \"entry\": \"tinkery seed new\"}).to_string(),\n            source: format!(\n                \"Goal saved by the command `tinkery seed new` from {origin}, launched with \\\n                 --operator {declared} (a declaration, not verified identity). No goal was \\\n                 displayed and nobody typed confirm. Goal only, not seed or implementation approval.\"\n            ),\n        },\n        confirmation,\n    )?;\n    Ok(receipt.session)\n}\n\n/// What Shape would show for `session`, as JSON for a caller without a screen: the goal exactly as\n/// recorded, the ledger version, and the one current thing (question, draft with the SHA-256\n/// that `Action::Confirm` names, ready seed, or a plain other state). Read-only.\npub fn show(session: &Path) -> Result<serde_json::Value, String> {\n    let shaping = shaping::read(session)?;\n    let now = match &shaping.stage {\n        Shaped::Question {\n            id,\n            title,\n            ask,\n            found,\n            suggestion,\n            options,\n            against,\n            hard,\n            ..\n        } => serde_json::json!({\n            \"stage\": \"question\", \"id\": id, \"label\": title, \"question\": ask, \"found\": found,\n            \"suggestion\": suggestion, \"options\": options, \"against\": against, \"hard_to_undo\": hard,\n        }),\n        Shaped::Review {\n            id,\n            title,\n            answer,\n            found,\n            ..\n        } => serde_json::json!({\n            \"stage\": \"review\", \"id\": id, \"label\": title, \"answer\": answer, \"found\": found,\n            \"next\": \"A flagged answer needs the operator's reason; open Shape's screen.\",\n        }),\n        Shaped::Waiting => serde_json::json!({\"stage\": \"waiting\", \"next\": \"seed step DIR look\"}),\n        Shaped::Drafted { revision, text } => serde_json::json!({\n            \"stage\": \"draft\", \"revision\": revision,\n            \"sha256\": text.as_ref().map(|text| format!(\"{:x}\", Sha256::digest(text.as_bytes()))),\n            \"text\": text, \"needs_check\": shaping.checks.iter().find(|check| check.gap().is_some()).map(|check| check.statement()), \"signoff\": shaping.signoff,\n            \"risks\": shaping.review_lines(false).collect::<Vec<_>>(),\n        }),\n        Shaped::Ready { revision, ended } => {\n            serde_json::json!({\"stage\": \"ready\", \"revision\": revision, \"ended\": ended})\n        }\n        other => serde_json::json!({\"stage\": \"other\", \"what\": format!(\"{other:?}\")}),\n    };\n    Ok(serde_json::json!({\n        \"goal\": shaping.goal, \"version\": shaping.version, \"open\": shaping.open, \"now\": now,\n    }))\n}\n\n/// Take `action` on `session` from a fresh read, through the same step the screen runs. Returns\n/// what the caller must read that the ledger does not hold: the folder a model step reads,\n/// assumed defaults and a withheld suggestion. Confirming calls no model and needs no `agent`;\n/// every other action refuses without one. An action that does not fit where the seed stands\n/// changes nothing.\npub fn step(\n    session: &Path,\n    agent: Option<&Agent>,\n    confirmation: &GoalConfirmation,\n    action: Action,\n) -> Result<Vec<String>, String> {\n    let (shaping, base) = shaping::read_with_base(session)?;\n    let expected = shaping\n        .version\n        .ok_or(\"This session's ledger version is unknown; nothing was changed.\")?;\n    if let Action::Confirm(sha256) = &action {\n        let Shaped::Drafted {\n            revision: Some(revision),\n            text: Some(seed),\n        } = &shaping.stage\n        else {\n            return Err(\"There is no draft to confirm; read `tinkery seed show DIR`. Nothing was confirmed.\".into());\n        };\n        if format!(\"{:x}\", Sha256::digest(seed.as_bytes())) != *sha256 {\n            return Err(\n                \"That SHA-256 is not the current draft's; read the draft again. Nothing was confirmed.\"\n                    .into(),\n            );\n        }\n        // The source names the real act: a command, not typed words.\n        let source = format!(\"tinkery seed step confirm {sha256}\");\n        return match answering::confirm_seed(\n            session,\n            expected,\n            revision,\n            seed,\n            &source,\n            Some(confirmation),\n        ) {\n            Ok(()) => Ok(Vec::new()),\n            Err(Refusal::Stale) => Err(STALE.into()),\n            Err(Refusal::Refused(reason) | Refusal::Rejected(reason)) => Err(reason),\n\n[75 more lines in file. Use offset=171 to continue.]\n\n[Full output: /var/folders/sk/r2ns7lvn2ygcsj7bhd0mvnyw0000gn/T/pi-codemode-231e6909453fd9bb.txt (read with offset/limit)]"}],"details":{"calls":[{"id":"call_ffb0cab185d34b2399751625d5372ee5|ctc_0cb7c24900cb2122016af973fad85c87d18faba6c82c0f5767/1","name":"read","args":"{\"path\":\"src/tend/thought.rs\"}","status":"ok","durationMs":0.8250000000007276},{"id":"call_ffb0cab185d34b2399751625d5372ee5|ctc_0cb7c24900cb2122016af973fad85c87d18faba6c82c0f5767/2","name":"read","args":"{\"path\":\"tests/tend_thought_terminal.py\"}","status":"ok","durationMs":0.5557919999992009},{"id":"call_ffb0cab185d34b2399751625d5372ee5|ctc_0cb7c24900cb2122016af973fad85c87d18faba6c82c0f5767/3","name":"read","args":"{\"path\":\"tests/tend_correction_terminal.py\"}","status":"ok","durationMs":0.6304999999993015},{"id":"call_ffb0cab185d34b2399751625d5372ee5|ctc_0cb7c24900cb2122016af973fad85c87d18faba6c82c0f5767/4","name":"read","args":"{\"path\":\"test