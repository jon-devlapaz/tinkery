ffers the way back to all goals.\n        if tend.connection_scope() {\n            \"t thought   v thoughts   f connections   a toggle goals   esc back\"\n        } else if tend.can_toggle_scope() {\n            \"a toggle goals   esc back\"\n        } else {\n            \"esc back\"\n        }\n    } else if tend.connection_scope() {\n        \"arrows move   enter open   t thought   v read   f connect   l link   esc back\"\n    } else {\n        \"↑↓←→ move   enter open   l link   esc back\"\n    };\n    frame.render_widget(\n        Paragraph::new(keys).style(palette.muted),\n        Rect::new(\n            2,\n            frame.area().height.saturating_sub(1),\n            frame.area().width.saturating_sub(4),\n            1,\n        ),\n    );\n    if tend.can_toggle_scope() {\n        frame.render_widget(\n            Paragraph::new(if tend.show_all {\n                \"all · a this repo\"\n            } else {\n                \"this repo · a all\"\n            })\n            .style(palette.muted),\n            Rect {\n                height: 1.min(area.height),\n                ..area\n            },\n        );\n    }\n    let mut area = tend.scope_body(area);\n    if !tend.detail\n        && !tend.is_linking()\n        && tend.connection_scope()\n        && let Some(thoughts) = &tend.thoughts\n        && !thoughts.summary().is_empty()\n    {\n        frame.render_widget(\n            Paragraph::new(thoughts.summary()).style(palette.ink),\n            Rect {\n                height: 2.min(area.height),\n                ..area\n            },\n        );\n        area.y = area.y.saturating_add(3);\n        area.height = area.height.saturating_sub(3);\n    }\n    let stale_empty =\n        tend.sessions.is_empty() && tend.unreadable == 0 && tend.error.is_none() && !tend.current;\n    if tend.pending || tend.want.is_some() || stale_empty {\n        let status = if tend.still_reading {\n            \"Still reading your sessions. Esc goes back.\"\n        } else {\n            \"Reading your sessions. Esc goes back.\"\n        };\n        frame.render_widget(Paragraph::new(status).style(palette.muted), area);\n        return;\n    }\n    if tend.error.is_some() {\n        frame.render_widget(\n            Paragraph::new(\"Saved session unavailable. F1 then h for details.\").style(palette.ink),\n            area,\n        );\n        return;\n    }\n    if tend.sessions.is_empty() {\n        frame.render_widget(\n            Paragraph::new(if let Some(message) = tend.repo_empty_message() {\n\n[216 more lines in file. Use offset=505 to continue.]\n==> text 2/4 <==\n            assert flow.requests(root)[-1]['input']['correction']==stored['correction']\n            assert [s['goal'] for s in flow.requests(root)[-1]['input']['sources']]==['TEST later support task 0','TEST later support task 1']\n            assert json.loads(correction(root).read_text())==stored\n        finally: term.close()\n        # Restore source words, then save a proposal with its frozen correction.\n        for p,data in originals.items(): p.write_bytes(data)\n        for i in range(2): flow.update_goal(root,f'goal-{i}',goal=json.loads(originals[root/'sessions'/f'goal-{i}'/'ledger.json'])['goal'])\n        (root/'mode').write_text('good')\n        term=flow.launch(root,repo,*size,budget=10)\n        try:\n            flow.wait(term,'F2 find one connection');flow.send(term,flow.F2,'p prepare this goal')\n            flow.send(term,b'p','F2 save exact words');flow.send(term,flow.F2,'tinkery › shape')\n            flow.wait(term,\"Shape hasn't asked its next question yet.\")\n            capture(term,f'{size[0]}x{size[1]}-shape')\n        finally: term.close()\n        record=json.loads(exploration(root).read_text());dest=Path(record['saved'])\n        ledger=(dest/'ledger.json').read_bytes()\n        origin=record['pending']['origin']\n        assert origin['schema']==2 and origin['correction']==stored['correction']\n        entries=json.loads(ledger)