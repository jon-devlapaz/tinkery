e_graph_bounds(state.simulation.get_graph());\n        state.is_settled = true;\n        state.alpha = 0.0;\n        state.viewport.center_x = 0.0;\n        state.viewport.center_y = 0.0;\n        state.viewport.zoom = 100.0 / (height * world_per_row);\n        state.viewport.auto_fit_zoom = state.viewport.zoom;\n        if let Some(previous) = &self.state {\n            let previous = previous.read();\n            if resized {\n                state.viewport.zoom *= previous.viewport.scale();\n                state.viewport.center_x = previous.viewport.center_x;\n                state.viewport.center_y = previous.viewport.center_y;\n            } else {\n                state.viewport = previous.viewport.clone();\n            }\n        }\n        self.state = Some(Arc::new(RwLock::new(state)));\n        self.error = None;\n        self.followed = None;\n        self…5465 tokens truncated… decisions: vec![],\nthink/brain_dump/host.rs:121:             uncertain: false,\nthink/brain_dump/host.rs-122-             framings: vec![Framing {\nthink/brain_dump/host.rs-123-                 text: String::new(),\nthink/brain_dump/host.rs-124-                 supports: request\nthink/brain_dump_tests.rs-47-         deferred: vec![],\nthink/brain_dump_tests.rs-48-         unresolved_notes: vec![],\nthink/brain_dump_tests.rs-49-         decisions: vec![],\nthink/brain_dump_tests.rs:50:         uncertain: false,\nthink/brain_dump_tests.rs-51-         framings: vec![Framing {\nthink/brain_dump_tests.rs-52-             text: format!(\nthink/brain_dump_tests.rs-53-                 \"Model reading {} originals: make reading comfortable.\",\nthink/brain_dump_tests.rs-309-         .push_str(\" This is an unresolved note, without a question mark.\");\nthink/brain_dump_tests.rs-310-     assert!(bad.validate(&r).is_ok());\nthink/brain_dump_tests.rs-311-     let mut bad = g.clone();\nthink/brain_dump_tests.rs:312:     bad.uncertain = true;\nthink/brain_dump_tests.rs-313-     assert!(\nthin