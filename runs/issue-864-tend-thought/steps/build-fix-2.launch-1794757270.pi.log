\"\"\nfrom pathlib import Path\nimport sys\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT/'tests'))\nimport test_launch\n\nTHOUGHT = ROOT/'src/tend/thought.rs'\nCONNECTION = ROOT/'src/tend/connection.rs'\nFAULTS = [\n    ('confirmed-goal', THOUGHT, '        let path = self.file(words)?;', '''        crate::shape::command::new_goal(\n            root.parent().unwrap().join(\"sessions\"),\n            words,\n            \"TEST faulty thought confirmation\",\n            &crate::think_record::GoalConfirmation::terminal(Some(\"agent\"))?,\n        )?;\n        let path = self.file(words)?;''', 'A thought changed goal sessions'),\n    ('changed-words', THOUGHT, '            words: words.into(),',\n     '            words: words.trim().into(),', 'Saved words differ from typed words'),\n    ('provider-source', CONNECTION, '        sources.sort_by(|a, b| a.id.cmp(&b.id));', '''        for entry in fs::read_dir(&self.store).map_err(|e| e.to_string())? {\n            let path = entry.map_err(|e| e.to_string())?.path();\n            if path.file_name().unwrap().to_string_lossy().starts_with(\"thought-\") {\n                let thought: serde_json::Value = serde_json::from_slice(&fs::read(path).unwrap()).unwrap();\n                if thought[\"repo\"] == serde_json::json!(self.repo) {\n                    sources.push(Source { id: \"TEST-thought\".into(),\n                        goal: thought[\"words\"].as_str().unwrap().into(), repo: self.repo.clone(),\n                        status: \"active\".into() });\n                }\n            }\n        }\n        sources.sort_by(|a, b| a.id.cmp(&b.id));''', 'A thought reached the provider request'),\n]\n\n\ndef main():\n    env = test_launch.environment()\n    output = ROOT/'target/thought-probes'\n    output.mkdir(parents=True, exist_ok=True)\n    originals = {p: p.read_text() for p in [THOUGHT, CONNECTION]}\n\n    def build():\n        test_launch.run(['cargo', '+stable', 'build', '--locked', '--quiet'], cwd=ROOT, env=env, check=True)\n\n    try:\n        for name, path, old, new, expected in FAULTS:\n            source = originals[path]\n            if source.count(old) != 1:\n                raise SystemExit(f'{name}: mutation no longer matches exactly once')\n            path.write_text(source.replace(old, new))\n            try:\n                build()\n                result = test_launch.run([sys.executable, 'tests/tend_thought_terminal.py'], cwd=ROOT, env=env,\n                                        capture_output=True, text=True, timeout=180)\n                log = result.stdout + result.stderr\n                (output/f'{name}.log').write_text(log)\n                if result.returncode == 0 or expected not in log:\n                    raise SystemExit(f'{name}: protection did not fail for the expected reason\\n{log}')\n                print(f'{name}: rejected ({expected})', flush=True)\n            finally:\n                path.write_text(source)\n    finally:\n        for path, source in originals.items():\n            path.write_text(source)\n        build()\n    test_launch.run([sys.executable, 'tests/tend_thought_terminal.py'], cwd=ROOT, env=env, check=True)\n\n\nif __name__ == '__main__':\n    main()\n\n\n[Full output: /var/folders/sk/r2ns7lvn2ygcsj7bhd0mvnyw0000gn/T/pi-codemode-d858f2e1f68784c2.txt (read with offset/limit)]"}],"details":{"calls":[{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/1","name":"read","args":"{\"path\":\"tests/tend_connection_terminal.py\",\"offset\":1,\"limit\":150}","status":"ok","durationMs":0.5774170000004233},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/2","name":"read","args":"{\"path\":\"tests/tend_thought_terminal.py\",\"offset\":1,\"limit\":95}","status":"ok","durationMs":0.373249999996915},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/3","name":"read","args":"{\"path\":\"src/tend/graph.rs\"}","status":"ok","durationMs":0.437207999995735},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/4","name":"grep","args":"{\"pattern\":\"sync_all|uncertain\",\"path\":\"src\",\"context\":3,\"limit\":35}","status":"ok","durationMs":13.603792000001704},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/5","name":"grep","args":"{\"pattern\":\"thought|help|key bar\",\"path\":\"docs/design/shape-and-handoff.md\",\"context\":2}","status":"ok","durationMs":6.264707999995153},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/6","name":"grep","args":"{\"pattern\":\"Design score|diagnostic|Change amplification|6\\\\.\",\"path\":\"docs/design/architecture.md\",\"context\":3}","status":"ok","durationMs":5.839708999999857},{"id":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4/7","name":"read","args":"{\"path\":\"scripts/probe-thoughts.py\"}","status":"ok","durationMs":0.3437919999996666}],"fullOutputPath":"/var/folders/sk/r2ns7lvn2ygcsj7bhd0mvnyw0000gn/T/pi-codemode-d858f2e1f68784c2.txt"}},"isError":false,"durationMs":52}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_a04c3f9cc2014ef3a9c4d939cfd4799a|ctc_0e8cd1afdc37c664016af9d2b924a887d1aae86a80c9342ae4","toolName":"codemode","content":[{"type":"text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"text","text":"Warning: truncated output (original token count: 15465)\nTotal output lines: 1194\n\n==> text 1/7 <==\n\"\"\"One explicit connection and durable Shape handoff, using real PTYs and a fake provider.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport sys\nimport tempfile\nimport time\nimport test_launch as subprocess\nfrom terminal_process import TerminalProcess, wait_output\n\nREPO = Path(__file__).resolve().parents[1]\nF2 = b'\\x1bOQ'\nF10 = b'\\x1b[21~'\n\n\ndef wait(term, text):\n    for code in wait_output(term.master, term.process, term.screen.feed, time.monotonic()+15):\n        if not term.screen.synchronized and text in term.screen.text():\n            return term.screen.text()\n        if code is not None:\n            break\n    raise AssertionError(f'Missing {text!r}:\\n{term.screen.text()}')\n\n\ndef send(term, keys, text):\n    os.write(term.master, keys)\n    return wait(term, text)\n\n\ndef fixture(root):\n    repo = root/'repo'\n    (repo/'.git').mkdir(parents=True)\n    records = root/'records'; records.mkdir()\n    sessions = root/'sessions'; sessions.mkdir()\n    for index, goal in enumerate(['TEST find repeated support requests\\nKeep their original words.', 'TEST make documentation easier to find\\nMeasure missed answers.']):\n        name = f'goal-{index}'\n        folder = sessions/name; folder.mkdir()\n        (folder/'ledger.json').write_text(json.dumps(dict(schema_version=1, session_id=name, status='active', goal=goal, updated_at='2026-11-14T00:00:00Z')))\n        (records/f'{name}.json').write_text(json.dumps(dict(schema=3, tinkery='TEST', origin='simulated',\n            model=None, thinking=None, prompt_hash=None, started='2026-11-14T00:00:00Z', confirmed='2026-11-14T00:00:00Z',\n            seed_me_session=name, seed_me_session_path=str(folder), seed_me_session_id=name,\n            turns=[], checks=[], goal=goal, repo=str(repo))))\n    provider = root/'fake-pi'\n    provider.write_text(f'''#!{sys.executable}\nimport json,sys,time\nfrom pathlib import Path\nroot=Path({str(root)!r})\nvalue=json.load(sys.stdin)\nwith (root/'requests').open('a') as f: f.write(json.dumps(dict(input=value,args=sys.argv))+'\\\\n')\nmode=(root/'mode').read_text() if (root/'mode').exists() else 'good'\nif mode=='slow': time.sleep(30)\nsources=value['sources'][:2]\nproposal=dict(sources=[dict(id=s['id'],quote=s['goal']) for s in sources], relationship='TEST support gaps can guide documentation.',\n goal='TEST connect support gaps to documentation.', outcome='TEST one linked support example.', question='TEST was an answer easier to find?', assumptions=['TEST both goals concern the same users.'])\nif mode=='bad': proposal['sources'][0]['quote']='not an exact source quote'\nprint(json.dumps(dict(connection=None if mode=='none' else proposal)))\n''')\n    provider.chmod(0o755)\n    return repo\n\n\ndef launch(root, repo, width, height, budget=2):\n    env=subprocess.environment({**os.environ, 'TERM':'xterm-256color','NO_COLOR':'1','TINKERY_NODE':'/tinkery-TEST-no-node'})\n    term=TerminalProcess([str(REPO/'target/debug/tinkery'),'--operator','agent','--home','--shape-pi','--model','test/model',\n        '--shape-budget',str(budget),'--pi-command',str(root/'fake-pi'),'--seed-session-root',str(root/'sessions'),\n        '--record-root',str(root/'records'),'--link-root',str(root/'links')],cwd=repo,env=env,width=width,height=height)\n    wait(term,'1  think');send(term,b'2','this repo');send(term,b'f','Find connections')\n    return term\n\n\ndef requests(root):\n    return [json.loads(line) for line in (root/'requests').read_text().splitlines()] if (root/'requests').exists() else []\n\n\ndef journey(width,height):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-connection-') as directory:\n        root=Path(directory).resolve();repo=fixture(root)\n        originals={p:p.read_bytes() for p in (root/'sessions').glob('*/ledger.json')}\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'F2 find one connection')\n            assert not requests(root)\n            send(term,F2,'p prepare this goal')\n            assert len(requests(root))==1\n            assert '--no-tools' in requests(root)[0]['args']\n            send(term,b'\\x1b','this repo')\n        finally: term.close()\n        # Kill and relaunch the application. The result is durable, not a second request.\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'p prepare this goal');assert len(requests(root))==1\n            send(term,b'p','F2 save exact words')\n            os.write(term.master,b' EDITED')\n            send(term,F2,'tinkery › shape')\n            assert len(requests(root))==1\n        finally: term.close()\n        stored=list((root/'links').glob('connection-*.json'));assert len(stored)==1\n        record=json.loads(stored[0].read_text());saved=Path(record['saved'])\n        ledger=json.loads((saved/'ledger.json').read_text())\n        assert 'EDITED' in ledger['goal']\n        assert record['pending']['origin']['goal']==ledger['goal']\n        assert all(p.read_bytes()==b for p,b in originals.items())\n        # Emulate loss of only the final exploration update after real publication.\n        record['saved']=None;stored[0].write_text(json.dumps(record))\n        term=launch(root,repo,width,height)\n        try:\n            assert 'EDITED' in wait(term,'F2 resume saving')\n            send(term,F2,'tinkery › shape')\n            assert len(requests(root))==1\n            assert len(list((root/'sessions').iterdir()))==3\n        finally: term.close()\n        term=launch(root,repo,width,height)\n        try:\n            wait(term,'F2 find a fresh connection')\n            send(term,F2,'p prepare this goal')\n            assert len(requests(root))==2\n        finally: term.close()\n\n\ndef refusal(mode, expected, budget=2, unknown=False):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-connection-refusal-') as directory:\n        root=Path(directory).resolve();repo=fixture(root);(root/'mode').write_text(mode)\n        if unknown: (root/'records'/'goal-1.json').unlink()\n        term=launch(root,repo,100,30,budget)\n        try:\n            if unknown: wait(term,expected)\n            else:\n                wait(term,\"F2 find one connection\")\n                send(term,F2,expected)\n            assert len(requests(root))==(0 if unknown or budget==0 else 1)\n            assert len(list((root/'sessions').iterdir()))==2\n        finally: term.close()\n\n\ndef update_goal(root, name, **changes):\n    path=root/'sessions'/name/'ledger.json'\n    value=json.loads(path.read_text());value.update(changes);path.write_text(json.dumps(value))\n    if 'goal' in changes:\n        path=root/'records'/f'{name}.json'\n        value=json.loads(path.read_text());value['goal']=changes['goal'];path.write_text(json.dumps(value))\n\n\ndef input_refusals():\n    cases=[('one','at least two'),('many','at most 20'),('large','32 KiB'),('incomplete','incomplete'),('duplicate','unknown or invalid')]\n    for case, expected in cases:\n        with tempfile.TemporaryDirectory(prefix='tinkery-TEST-input-') as directory:\n            root=Path(directory).resolve();repo=fixture(root)\n            if case=='one': update_goal(root,'goal-1',status='stopped')\n            elif case=='large': update_goal(root,'goal-0',goal='TEST '+('x'*33000))\n            elif case=='incomplete': (root/'sessions'/'goal-1'/'ledger.json').write_text('broken')\n\n[139 more lines in file. Use offset=151 to continue.]\n==> text 2/7 <==\n\"\"\"Raw thoughts through real terminals and private TEST roots. All providers are local stubs.\"\"\"\nimport json\nimport os\nfrom pathlib import Path\nimport tempfile\n\nimport test_launch as subprocess\nfrom terminal_process import TerminalProcess\nimport tend_connection_terminal as flow\n\nREPO = Path(__file__).resolve().parents[1]\nWORDS = '  TEST raw thought café 👩‍💻\\r\\nKeep\\tthese words.\\rLast line.  \\n'\n\n\ndef launch(root, repo, size, provider=False):\n    args = [str(REPO/'target/debug/tinkery'), '--operator', 'agent', '--home',\n            '--seed-session-root', str(root/'sessions'), '--record-root', str(root/'records'),\n            '--link-root', str(root/'links')]\n    if provider:\n        args += ['--shape-pi', '--model', 'test/model', '--shape-budget', '8',\n                 '--pi-command', str(root/'fake-pi')]\n    term = TerminalProcess(args, cwd=repo, env=subprocess.environment({**os.environ, 'TERM': 'xterm-256color',\n        'NO_COLOR': '1', 'TINKERY_NODE': '/tinkery-TEST-no-node'}), width=size[0], height=size[1])\n    flow.wait(term, '1  think')\n    flow.send(term, b'2', 'this repo')\n    return term\n\n\ndef paste(term, words):\n    os.write(term.master, b'\\x1b[200~'+words.encode()+b'\\x1b[201~')\n    flow.wait(term, 'Last line.' if words == WORDS else words.splitlines()[0].strip())\n\n\ndef saved(root):\n    return sorted((root/'links').glob('thought-*.json'))\n\n\ndef no_goal(root, original):\n    assert {p: p.read_bytes() for p in (root/'sessions').rglob('*') if p.is_file()} == original, 'A thought changed goal sessions'\n    assert len(list((root/'records').glob('*.json'))) == 2, 'A thought wrote a goal confirmation record'\n    for path in saved(root):\n        value = json.loads(path.read_bytes())\n        assert set(value) == {'schema', 'repo', 'words'}, 'A thought acquired goal authority'\n        assert path.stat().st_mode & 0o777 == 0o600\n\n\ndef journey(size):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-thought-') as directory:\n        root = Path(directory).resolve()\n        repo = flow.fixture(root)\n        original = {p: p.read_bytes() for p in (root/'sessions').rglob('*') if p.is_file()}\n        term = launch(root, repo, size)\n        try:\n            screen = term.screen.text()\n            assert 't new thought' in screen, screen\n            assert '↑↓←→ move   enter open   f connections   l link   esc back' in screen, screen\n            flow.send(term, b't', 'F2 save thought only')\n            screen = term.screen.text()\n            assert str(repo) in ''.join(screen.split()) and 'No model call.' in screen, screen\n            paste(term, WORDS)\n            assert not saved(root)\n            flow.send(term, flow.F2, 'Thought saved. No goal confirmed.')\n            assert len(saved(root)) == 1\n            assert json.loads(saved(root)[0].read_bytes())['words'].encode() == WORDS.encode(), 'Saved words differ from typed words'\n            no_goal(root, original)\n            flow.send(term, b's', 'Saved thoughts')\n            assert 'tinkery › shape' not in term.screen.text()\n            flow.send(term, b'\\x1b', 'Thoughts: 1')\n            assert 'Thought: ' in term.screen.text()\n        finally:\n            term.close()\n        term = launch(root, repo, size)\n        try:\n            flow.wait(term, 'Thoughts: 1')\n            flow.send(term, b'v', 'Thought 1 of 1')\n            flow.send(term, b'\\x1b', 'Thoughts: 1')\n            flow.send(term, b't', 'F2 save thought only')\n            paste(term, WORDS)\n            flow.send(term, flow.F2, 'Thought already saved. One entry.')\n            assert len(saved(root)) == 1\n            flow.send(term, b'\\x1b', 'Thoughts: 1')\n            flow.send(term, b't', 'F2 save thought only')\n            paste(term, 'TEST cancelled thought')\n            flow.send(term, b'\\x1b', 'Thoughts: 1')\n            assert len(saved(root)) == 1\n            assert not flow.requests(root)\n            no_goal(root, original)\n        finally:\n            term.close()\n        other = root/'other'\n        (other/'.git').mkdir(parents=True)\n        term = launch(root, other, size)\n        try:\n            flow.send(term, b'v', 'No thoughts saved.')\n            flow.send(term, b'\\x1b', 'this repo')\n\n[117 more lines in file. Use offset=96 to continue.]\n==> text 3/7 <==\n//! Graf adapter: identity-safe topology, static positions, viewport and pointer mechanics.\n//! Tend owns selection policy and linking; this starts no physics worker and writes nothing.\n\nuse super::Tend;\nuse crate::Palette;\nuse crate::clipped;\nuse crossterm::event::{MouseButton, MouseEvent, MouseEventKind};\nuse graf::{\n    FeatureFlags, GraphAction, GraphMouseState, GraphState, LabelMode, NodeColorMode, NodeFill,\n    NodeScale, NodeSpec, Settings, ThemeColors, apply_action, draw_graph_view, handle_graph_mouse,\n    settings::SelectionFocus,\n};\nuse parking_lot::RwLock;\nuse ratatui::{\n    Frame,\n    layout::{Position, Rect},\n    style::{Color, Modifier},\n    widgets::Paragraph,\n};\nuse std::{collections::HashMap, sync::Arc};\nuse unicode_width::UnicodeWidthStr;\n\ntype Topology = (Vec<(String, String)>, Vec<(usize, usize)>);\n\n#[derive(Default)]\npub(super) struct GraphView {\n    topology: Topology,\n    pending: Option<Topology>,\n    appearance: Option<(Color, Color, String)>,\n    pub(super) state: Option<Arc<RwLock<GraphState>>>,\n    mouse: GraphMouseState,\n    area: Rect,\n    followed: Option<String>,\n    pub(super) error: Option<String>,\n    label_hits: Vec<(Rect, String)>,\n    pointer_offset: Option<(i32, i32)>,\n}\n\nfn settings() -> Settings {\n    let mut settings = Settings {\n        max_node: 0,\n        ..Settings::default()\n    };\n    settings.filter.show_orphan = true;\n    settings.visual.node_color_mode = NodeColorMode::Uniform;\n    settings.visual.node_fill = NodeFill::None;\n    settings.visual.node_scale = NodeScale::Fixed(10);\n    settings.visual.selection_focus = SelectionFocus::None;\n    settings.visual.label_mode = LabelMode::None;\n    settings.visual.show_legend = false;\n    settings.visual.show_minimap = false;\n    settings.visual.show_looking_glass = false;\n    settings.visual.full_detail = true;\n    settings.interaction.double_click_ms = 0;\n    settings\n}\n\nfn identity(session: &super::Session) -> String {\n    // Debug escaping preserves non-UTF8 path distinctions too.\n    format!(\"{:?}\", session.path)\n}\n\nimpl Tend {\n    /// Prepare path-bound inputs when sessions, scope or needs links change.\n    pub(super) fn prepare_graph(&mut self) {\n        let mut counts = HashMap::new();\n        for session in &self.all_sessions {\n            if let Some(id) = &session.id {\n                *counts.entry(id.as_str()).or_insert(0) += 1;\n            }\n        }\n        let mut nodes: Vec<_> = self\n            .sessions\n            .iter()\n            .map(|s| (identity(s), s.goal.lines().next().unwrap_or(\"\").to_owned()))\n            .collect();\n        nodes.sort_by(|a, b| a.0.cmp(&b.0));\n        let indices: HashMap<_, _> = nodes\n            .iter()\n            .enumerate()\n            .map(|(i, (id, _))| (id.as_str(), i))\n            .collect();\n        let ids: HashMap<_, _> = self\n            .sessions\n            .iter()\n            .filter_map(|s| {\n                let id = s.id.as_deref()?;\n                (counts.get(id) == Some(&1)).then(|| (id, indices[identity(s).as_str()]))\n            })\n            .collect();\n        let edges = self\n            .links\n            .as_ref()\n            .map(|links| {\n                links\n                    .pairs()\n                    .filter_map(|(a, b)| Some((*ids.get(a)?, *ids.get(b)?)))\n                    .collect()\n            })\n            .unwrap_or_default();\n        self.graph.pending = Some((nodes, edges));\n    }\n\n    pub(super) fn sync_graph(&mut self, body: Rect) {\n        self.graph.sync(Rect::new(\n            body.x,\n            body.y,\n            body.width,\n            body.height.saturating_sub(3),\n        ));\n    }\n\n    pub(crate) fn step_selection(&mut self, forward: bool) {\n        self.selected = if forward {\n            (self.selected + 1).min(self.sessions.len().saturating_sub(1))\n        } else {\n            self.selected.saturating_sub(1)\n        };\n        self.graph.followed = None;\n    }\n\n    pub(crate) fn adjust_view(&mut self, key: char) {\n        if let Some(state) = &self.graph.state {\n            let direction = match key {\n                'K' => Some((0.0, 1.0)),\n                'J' => Some((0.0, -1.0)),\n                'H' => Some((-1.0, 0.0)),\n                'L' => Some((1.0, 0.0)),\n                _ => None,\n            };\n            if let Some((x, y)) = direction {\n                let mut state = state.write();\n                let step = 20.0 / state.viewport.zoom;\n                state.viewport.pan_by(x * step, y * step);\n            } else if let Some(action) = match key {\n                '+' | '=' => Some(GraphAction::ZoomIn),\n                '-' => Some(GraphAction::ZoomOut),\n                _ => None,\n            } {\n                let _ = apply_action(state, action, &settings());\n            }\n        }\n    }\n}\n\nimpl GraphView {\n    fn sync(&mut self, area: Rect) {\n        let resized = self.area.width != area.width || self.area.height != area.height;\n        self.area = area;\n        let pending = self.pending.take();\n        if self.state.is_some()\n            && !resized\n            && pending\n                .as_ref()\n                .is_none_or(|inputs| *inputs == self.topology)\n        {\n            return;\n        }\n        if let Some(inputs) = pending {\n            self.topology = inputs;\n        }\n        let topology = &self.topology;\n        let settings = settings();\n        let specs: Vec<_> = topology\n            .0\n            .iter()\n            .map(|(id, title)| NodeSpec {\n                id: id.clone(),\n                title: title.clone(),\n           