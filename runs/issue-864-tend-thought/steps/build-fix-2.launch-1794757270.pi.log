on<String> {\n        if self.area.is_empty() {\n            self.release();\n            return None;\n        }\n        if !matches!(\n            event.kind,\n            MouseEventKind::Down(MouseButton::Left)\n                | MouseEventKind::Up(MouseButton::Left)\n                | MouseEventKind::Drag(MouseButton::Left)\n                | MouseEventKind::ScrollUp\n                | MouseEventKind::ScrollDown\n        ) {\n            return None;\n        }\n        let state = self.state.as_ref()?;\n        let mut label_node = None;\n        if matches!(event.kind, MouseEventKind::Down(MouseButton::Left)) {\n            self.pointer_offset = None;\n            if let Some((_, id)) = self\n                .label_hits\n                .iter()\n                .find(|(rect, _)| rect.contains(Position::new(event.column, event.row)))\n            {\n                let state = state.read();\n                let graph = state.simulation.get_graph();\n                if let Some(index) = graph.node_indices().find(|&i| graph[i].data.id == *id) {\n                    label_node = Some(index);\n                    let node = &graph[index];\n                    let (x, y) = state.viewport.world_to_screen(\n                        f64::from(node.location.x),\n                        f64::from(node.location.y),\n                        self.area,\n                    );\n                    self.pointer_offset = Some((\n                        x.round() as i32 - i32::from(event.column),\n                        y.round() as i32 - i32::from(event.row),\n                    ));\n                }\n\n[257 more lines in file. Use offset=273 to continue.]\n==> text 4/5 <==\n//! Tend's garden framing: selected-line needs, read notes and explicit refusals.\n//! Graf owns the graph drawing and pointer geometry; this preserves Tend's quiet footer.\n\nuse super::{Tend, records};\nuse crate::Palette;\nuse ratatui::{\n    Frame,\n    layout::Rect,\n    text::{Line, Span},\n    widgets::Paragraph,\n};\n\npub(super) fn render(\n    frame: &mut Frame,\n    tend: &mut Tend,\n    body: Rect,\n    palette: Palette,\n    now: Option<u64>,\n) {\n    tend.sync_graph(body);\n    let selected = format!(\"{:?}\", tend.sessions[tend.selected].path);\n    let source_index = (0..tend.sessions.len())\n        .find(|&i| tend.source_marked(i))\n        .unwrap_or(tend.selected);\n    let source = format!(\"{:?}\", tend.sessions[source_index].path);\n    let linking = tend.is_linking();\n    tend.graph.draw(frame, palette, &selected, &source, linking);\n    let (goal, status) = tend.selected_line(usize::from(body.width), now);\n    frame.render_widget(\n        Paragraph::new(Line::from(vec![\n            Span::styled(goal, palette.ink),\n            Span::styled(status, palette.muted),\n        ])),\n        Rect::new(body.x, body.bottom().saturating_sub(2), body.width, 1),\n    );\n    render_note(frame, tend, body, palette);\n    frame.render_widget(\n        Paragraph::new(&*tend.notice).style(palette.muted),\n        Rect::new(body.x, body.bottom().saturating_sub(1), body.width, 1),\n    );\n\n[27 more lines in file. Use offset=41 to continue.]\n==> text 5/5 <==\n\"\"\"Own one guarded terminal process, its screen and descriptors; feature waits stay local.\"\"\"\nimport errno\nimport fcntl\nimport os\nimport select\nimport signal\nimport struct\nimport termios\nimport time\nimport test_launch as subprocess\nfrom vt_screen import Screen\n\n\ndef wait_output(master, process, consume, deadline, *, interval=.02):\n    \"\"\"Yield the observed return code after reading, draining output on exit.\n\n    The absolute monotonic deadline bounds reads and exit draining. Callers own\n    success, frame readiness and diagnostics. EOF and an exited PTY's EIO finish\n    a read pass; other read errors remain failures. No frame is required here.\n    \"\"\"\n    def read_pending(timeout):\n        if not select.select([master], [], [], timeout)[0]:\n            return False\n        try:\n            chunk = os.read(master, 65536)\n        except OSError as error:\n            if error.errno != errno.EIO or process.poll() is None:\n                raise\n            return False\n        if not chunk:\n            return False\n        consume(chunk)\n        return True\n\n    while time.monotonic() < deadline:\n        started = time.monotonic()\n        read_output = read_pending(min(interval, max(0, deadline - started)))\n        returncode = process.poll()\n        if not read_output and returncode is None:\n            remaining = min(started + interval, deadline) - time.monotonic()\n            if remaining > 0:\n                time.sleep(remaining)\n        if returncode is not None:\n            # Exit is not EOF: unread final output can span many small reads.\n            while time.monotonic() < deadline and read_pending(0):\n                pass\n        yield returncode\n        if returncode is not None:\n            return\n\n\nclass TerminalProcess:\n    def __init__(self, argv, *, cwd, env, width, height):\n        self.master, self.slave = os.openpty()\n        self.raw = bytearray()\n        try:\n            self.resize(width, height)\n            self.process = subprocess.Popen(argv, cwd=cwd, env=env,\n                                            stdin=self.slave, stdout=self.slave, stderr=self.slave)\n        except BaseException:\n            os.close(self.master)\n            os.close(self.slave)\n            raise\n\n    def resize(self, width, height):\n        fcntl.ioctl(self.slave, termios.TIOCSWINSZ, struct.pack('HHHH', height, width, 0, 0))\n        self.screen = Screen(width, height)\n        if hasattr(self, 'process'):\n            os.kill(self.process.pid, signal.SIGWINCH)\n\n    def feed(self):\n        chunk = os.read(self.master, 65536)\n        self.raw.extend(chunk)\n        self.screen.feed(chunk)\n\n    def close(self):\n        if self.process.poll() is None:\n            self.process.kill()\n        self.process.wait()\n        os.close(self.master)\n        os.close(self.slave)\n"}],"details":{"calls":[{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/1","name":"bash","args":"{\"command\":\"tail -85 runs/issue-864-tend-thought/03-build/output/full-check-fix-2.log; git status --short\",\"timeout\":30}","status":"ok","durationMs":31.28266700002132},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/2","name":"read","args":"{\"path\":\"src/menu.rs\",\"offset\":1070,\"limit\":40}","status":"ok","durationMs":0.651624999998603},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/3","name":"read","args":"{\"path\":\"src/tend/graph.rs\",\"offset\":230,\"limit\":43}","status":"ok","durationMs":0.5160000000032596},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/4","name":"read","args":"{\"path\":\"src/tend/garden.rs\",\"offset\":1,\"limit\":40}","status":"ok","durationMs":0.2889590000268072},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/5","name":"read","args":"{\"path\":\"tests/terminal_process.py\",\"offset\":1,\"limit\":90}","status":"ok","durationMs":0.4330000000190921}]},"isError":false,"durationMs":56,"timestamp":1794757642143,"nestedCalls":{"calls":[{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/1","name":"bash","status":"ok","arguments":{"command":"tail -85 runs/issue-864-tend-thought/03-build/output/full-check-fix-2.log; git status --short","timeout":30},"durationMs":31},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409f15087d1abfa839610786273/2","name":"read","status":"ok","arguments":{"path":"src/menu.rs","offset":1070,"limit":40},"durationMs":1},{"id":"call_e19e095bb7904099a0b97f16a78f1865|ctc_0e8cd1afdc37c664016af9d409