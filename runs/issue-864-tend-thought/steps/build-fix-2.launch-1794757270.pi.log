{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_ae045dd1626c46da917fdaecc76090b9|ctc_0e8cd1afdc37c664016af9d2b43d4887d19c0ffe62e930abf0","toolName":"codemode","content":[{"type":"text","text":"Script failed\nWall time 0.0 seconds\nOutput:\n"},{"type":"text","text":"Warning: truncated output (original token count: 12470)\nTotal output lines: 1177\n\n==> text 1/3 <==\n//! Tend: the saved goals garden and one goal's detail, read from saved sessions.\n//!\n//! Shows what discovery has landed, says plainly when that is unknown, incomplete or failed,\n//! and offers explicit needs links and saved Think history; it never edits a session,\n//! starts an agent or guesses a stage. Everything about session files comes from `seed_me`.\n\npub(crate) mod connection;\npub mod discovery;\nmod garden;\nmod graph;\npub(crate) mod history;\nmod linking;\npub mod needs;\npub(crate) mod thought;\npub use discovery::{Discovery, Found, Outcome, Source, scan};\n\nuse crate::clipped;\npub use crate::seed_me::{Session, Stage};\nuse crate::{\n    Palette,\n    goal::confirmed::{SavedGoal, render_saved_goal},\n};\nuse ratatui::{\n    Frame,\n    layout::Rect,\n    widgets::{Paragraph, Wrap},\n};\nuse std::{\n    collections::HashSet,\n    path::{Path, PathBuf},\n    time::{Duration, Instant, SystemTime, UNIX_EPOCH},\n};\nuse unicode_width::UnicodeWidthStr;\n\n/// How long a read may be pending before the quiet line says it is still going. A normal\n/// read takes milliseconds (about 70 ms for 5,000 sessions on the measured machine), so\n/// this only shows when something is actually slow, such as a cold or network disk.\npub(super) const STILL_READING_AFTER: Duration = Duration::from_secs(3);\n\npub(super) struct Tend {\n    pub sessions: Vec<Session>,\n    pub error: Option<String>,\n    /// Nothing has landed yet: unknown, never \"no sessions\".\n    pub pending: bool,\n    /// The read this view waits on has run past [`STILL_READING_AFTER`]. Only the pending\n    /// line reads it, and only its wording changes.\n    pub still_reading: bool,\n    /// The list shown reflects every read asked for. An older empty list is not proof\n    /// that nothing was saved since.\n    pub current: bool,\n    /// A saved session to open in detail once a read that can contain it lands.\n    pub want: Option<(PathBuf, Option<PathBuf>)>,\n    /// Records the last read could not parse; the list may be missing them.\n    pub unreadable: usize,\n    /// Readable ended sessions omitted from the garden.\n    pub ended: usize,\n    /// The discovery version last applied.\n    pub seen: u64,\n    pub selected: usize,\n    pub detail: bool,\n    pub scroll: u16,\n    /// Rows of goal on screen at the last detail draw, for PgUp/PgDn.\n    pub page: u16,\n    pub how: bool,\n    pub help_scroll: u16,\n    pub notice: String,\n    pub history: Option<history::View>,\n    pub(super) thoughts: Option<thought::Garden>,\n    graph: graph::GraphView,\n    last_press: Option<(PathBuf, Instant)>,\n    pub(super) needs: needs::Store,\n    links: Result<needs::Links, String>,\n    all_sessions: Vec<Session>,\n    /// Only exact recorded repo matches; absent outside a repository.\n    pub(super) repo_paths: Option<HashSet<PathBuf>>,\n    /// Active goals with unknown repository attribution, not known non-matches.\n    pub(super) repo_unknown: usize,\n    show_all: bool,\n    /// The source path stays fixed while selection picks the other goal.\n    linking: Option<PathBuf>,\n    link_error: Option<String>,\n}\nimpl Tend {\n    /// Whether automatic discovery is requested from this repository's garden.\n    pub(super) fn connection_scope(&self) -> bool {\n        self.repo_paths.is_some() && !self.show_all\n    }\n\n    /// A pending view with a captured links destination or refusal; reads no links and writes nothing.\n    pub(super) fn new(link_root: Result<PathBuf, String>) -> Self {\n        Self {\n            sessions: vec![],\n            error: None,\n            pending: true,\n            still_reading: false,\n            current: false,\n            want: None,\n            unreadable: 0,\n            ended: 0,\n            seen: 0,\n            selected: 0,\n            detail: false,\n            scroll: 0,\n            page: 1,\n            how: false,\n            help_scroll: 0,\n            notice: String::new(),\n            history: None,\n            thoughts: None,\n            graph: graph::GraphView::default(),\n            last_press: None,\n            needs: needs::Store::new(link_root),\n            links: Ok(needs::Links::default()),\n            all_sessions: vec![],\n            repo_paths: None,\n            repo_unknown: 0,\n            show_all: false,\n            linking: None,\n            link_error: None,\n        }\n    }\n    /// Note how long the read this view waits on has been running (`None`: no worker).\n    /// Wording only: it starts nothing and leaves every key as it was.\n    pub(super) fn note_wait(&mut self, waited: Option<Duration>) {\n        self.still_reading = waited.is_some_and(|waited| waited >= STILL_READING_AFTER);\n    }\n    /// Take a landed read. Selection follows the session's path, not its position.\n    /// A wanted session is opened only from a read that contains it (or that began\n    /// after it was asked for); until then the view stays pending.\n    pub(super) fn apply(&mut self, outcome: &Outcome, fresh: bool, version: u64) {\n        let wanted_at = match (&self.want, outcome) {\n            (Some((path, canonical)), Ok(found)) => found\n                .sessions\n                .iter()\n                .position(|s| s.path == *path || canonical.as_ref().is_some_and(|c| s.path == *c)),\n            _ => None,\n        };\n        if self.want.is_some() && wanted_at.is_none() && !fresh {\n            return;\n        }\n        self.cancel_link();\n        self.links = self.needs.read().into_links();\n        if self.notice.is_empty() {\n            self.link_error = self.links.as_ref().err().cloned();\n        }\n        self.seen = version;\n        self.pending = false;\n        match outcome {\n            Err(error) => {\n                self.error = Some(error.clone());\n                self.sessions.clear();\n                self.all_sessions.clear();\n                self.unreadable = 0;\n                self.ended = 0;\n                self.want = None;\n            }\n            Ok(found) => {\n                let keep = self.current().map(|s| s.path.clone());\n                self.error = None;\n                self.unreadable = found.unreadable;\n                self.all_sessions = found.sessions.clone();\n                if let Some(index) = wanted_at\n                    && self\n                        .repo_paths\n                        .as_ref()\n                        .is_some_and(|paths| !paths.contains(&found.sessions[index].path))\n                {\n                    // An explicit receipt/Shape return must still open its exact goal.\n                    self.show_all = true;\n                }\n                self.filter_sessions();\n                if let Some(index) = wanted_at {\n                    let path = &found.sessions[index].path;\n                    let active = self.sessions.iter().position(|s| s.path == *path);\n                    self.selected = active.unwrap_or(0);\n                    self.detail = active.is_some();\n                    self.scroll = 0;\n                    self.want = None;\n                } else if let Some((path, _)) = self.want.take() {\n                    self.error = Some(format!(\"Saved session is unavailable: {}\", path.display()));\n                    self.sessions.clear();\n                } else {\n                    self.selected = keep\n                        .and_then(|k| self.sessions.iter().position(|s| s.path == k))\n                        .unwrap_or(self.selected)\n                        .min(self.sessions.len().saturating_sub(1));\n                }\n            }\n        }\n        self.prepare_graph();\n    }\n    fn filter_sessions(&mut self) {\n        let visible = |s: &&Session| {\n            self.show_all\n                || self\n                    .repo_paths\n                    .as_ref()\n                    .is_none_or(|paths| paths.contains(&s.path))\n        };\n        self.ended = self\n            .all_sessions\n            .iter()\n            .filter(visible)\n            .filter(|s| s.stage.ended())\n            .count();\n        self.sessions = self\n            .all_sessions\n            .iter()\n            .filter(visible)\n            .filter(|s| !s.stage.ended())\n            .cloned()\n            .collect();\n    }\n\n    fn repo_empty_message(&self) -> Option<String> {\n        if self.repo_paths.is_none() || self.show_all {\n            return None;\n        }\n        if self.repo_unknown > 0 {\n            let goals = if self.repo_unknown == 1 {\n                \"goal has\"\n            } else {\n                \"goals have\"\n            };\n            Some(format!(\n                \"{} {goals} no readable repo record. Press a for all goals.\",\n                self.repo_unknown\n            ))\n        } else if self.unreadable == 0 {\n            Some(\"No active goals are recorded for this repo. Press a for all goals.\".into())\n        } else {\n            Some(format!(\n                \"{} couldn't be read; this repo may have active goals. Press a for all goals.\",\n                records(self.unreadable)\n            ))\n        }\n    }\n\n    fn scope_body(&self, area: Rect) -> Rect {\n        if self.can_toggle_scope() {\n            Rect::new(\n                area.x,\n                area.y.saturating_add(1),\n                area.width,\n                area.height.saturating_sub(1),\n            )\n        } else {\n            area\n        }\n    }\n\n    fn can_toggle_scope(&self) -> bool {\n        self.repo_paths.is_some()\n            && !self.pending\n            && (self.current || !self.sessions.is_empty() || self.unreadable > 0)\n            && !self.detail\n            && self.want.is_none()\n            && self.error.is_none()\n            && !self.is_linking()\n    }\n\n    /// Change only the visible garden, retaining global needs and exact selection when possible.\n    pub(super) fn toggle_scope(&mut self) {\n        if !self.can_toggle_scope() {\n            return;\n        }\n        let keep = self.current().map(|s| s.path.clone());\n        self.show_all = !self.show_all;\n        self.filter_sessions();\n        self.prepare_graph();\n        self.selected = keep\n            .and_then(|path| self.sessions.iter().position(|s| s.path == path))\n            .unwrap_or(0);\n        self.last_press = None;\n        self.graph.release();\n        self.notice.clear();\n    }\n\n    /// Whether the saved-goal garden is showing, rather than detail or a discovery state.\n    pub(super) fn garden_showing(&self) -> bool {\n        !self.detail\n            && !self.pending\n            && self.want.is_none()\n            && self.error.is_none()\n            && !self.sessions.is_empty()\n    }\n    pub(super) fn release_pointer(&mut self) {\n        self.graph.release();\n    }\n    /// Forward pointer mechanics to graf; only Tend can select, link or open a saved goal.\n    pub(super) fn pointer(\n        &mut self,\n        event: crossterm::event::MouseEvent,\n        body: Rect,\n        now: Instant,\n    ) {\n        if !self.garden_showing() {\n            self.graph.release();\n            return;\n        }\n        let mut body = self.scope_body(body);\n        if self.connection_scope()\n            && self\n                .thoughts\n                .as_ref()\n                .is_some_and(|t| !t.summary().is_empty())\n        {\n            body.y = body.y.saturating_add(3);\n            body.height = body.height.saturating_sub(3);\n        }\n        self.sync_graph(body);\n        if matches!(event.kind, crossterm::event::MouseEventKind::Drag(_)) {\n            self.last_press = None;\n        }\n        let Some(id) = self.graph.pointer(event) else {\n            return;\n        };\n        let Some(index) = self\n            .sessions\n            .iter()\n            .position(|s| format!(\"{:?}\", s.path) == id)\n        else {\n            return;\n        };\n        if self.linking.is_some() {\n            self.selected = index;\n            self.commit_link();\n            self.graph.release();\n            return;\n        }\n        let path = self.sessions[index].path.clone();\n        let double = self.last_press.as_ref().is_some_and(|(last, at)| {\n            *last == path\n                && now\n                    .checked_duration_since(*at)\n                    .is_some_and(|elapsed| elapsed <= Duration::from_millis(500))\n        });\n        self.selected = index;\n        self.last_press = Some((path, now));\n        if double {\n            self.detail = true;\n            self.scroll = 0;\n            self.notice.clear();\n            self.last_press = None;\n            self.graph.release();\n        }\n    }\n    pub(super) fn current(&self) -> Option<&Session> {\n        self.sessions.get(self.selected)\n    }\n    pub(super) fn help_text(&self) -> String {\n        if self.how {\n            let session = self.current().map_or(String::new(), |s| {\n                format!(\n                    \"\\nSession: {}\\nStatus: {}\",\n                    s.path.display(),\n                    s.stage.label()\n                )\n            });\n            return format!(\n                \"How it works\\nh or Esc returns to Help · PgUp/PgDn scroll\\n{session}\\n{}\\n{}\\n{}\\n\\nNothing starts on its own.\",\n                self.error.as_deref().unwrap_or(\"\"),\n                self.link_error.as_deref().unwrap_or(\"\"),\n                self.graph.error.as_deref().unwrap_or(\"\")\n            );\n        }\n        let copy = if self.detail && self.current().is_some_and(|s| s.stage.can_shape()) {\n            \"\\ns shape: answer its questions and confirm its seed\"\n        } else {\n            \"\"\n        };\n        let needs = self.needs_text();\n        let needs = if needs.is_empty() {\n            String::new()\n        } else {\n            format!(\"\\n\\n{}\", needs.trim_start_matches(\" · \"))\n        };\n        let scope = if self.can_toggle_scope() {\n            \"\\na toggles this repo / all goals\"\n        } else {\n            \"\"\n        };\n        format!(\n            \"Right now\\n{}{}{scope}\\nEsc back · F10 menu\\n\\nF1 close · h how it works · PgUp/PgDn scroll{needs}\\n\\nNothing runs by itself. A saved goal is not seed or implementation approval.\",\n            if self.detail {\n                \"Read the saved goal. ↑↓ / j k or PgUp/PgDn scroll.\\nr opens its Think history.\"\n            } else if self.linking.is_some() {\n                \"Arrows / j k pick · Enter links or unlinks · Esc cancels.\"\n            } else if self.garden_showing() {\n                concat!(\n                    \"Arrows / j k move · Enter or a double click opens the saved goal.\\n\",\n                    \"l link or unlink\\n\",\n                    \"Up / Left / k previous · Down / Right / j next (newest first).\\n\",\n                    \"+ / - zoom · H J K L pan · drag a goal to move it.\\n\",\n                    \"Drag empty space to pan · scroll to zoom\",\n                )\n            } else {\n                \"Esc returns to the menu.\"\n            },\n            copy\n        )\n    }\n}\n\nfn row(session: &Session, width: usize, now: Option<u64>) -> (String, String) {\n    let suffix = format!(\n        \"{} · {}\",\n        session.stage.label(),\n        now.map_or_else(\n            || \"time unknown\".into(),\n            |now| relative_time(&session.updated, now)\n        )\n    );\n    let budget = width.saturating_sub(suffix.width() + 2);\n    let title = clipped(session.goal.lines().next().unwrap_or(\"\"), budget);\n    let gap = width.saturating_sub(title.width() + suffix.width());\n    (format!(\"{title}{}\", \" \".repeat(gap)), suffix)\n}\n\npub(super) fn render(frame: &mut Frame, tend: &mut Tend, area: Rect, palette: Palette) {\n    let linking_keys = format!(\"↑↓←→ pick   enter {}   esc cancel\", tend.link_verb());\n    let keys = if tend.linking.is_some() {\n        linking_keys.as_str()\n    } else if tend.detail {\n        if tend.current().is_some_and(|s| s.stage.can_shape()) {\n            \"s shape   r history   esc back   F10 menu\"\n        } else {\n            \"r history   esc back   F10 menu\"\n        }\n    } else if !tend.garden_showing() {\n        // An empty repo view still offers the way back to all goals.\n        if tend.connection_scope() {\n            \"f connections   a toggle goals   esc back\"\n        } else if tend.can_toggle_scope() {\n            \"a toggle goals   esc back\"\n        } else {\n            \"esc back\"\n        }\n    } else if tend.connection_scope() {\n        \"↑↓←→ move   enter open   f connections   l link   esc back\"\n    } else {\n        \"↑↓←→ move   enter open   l link   esc back\"\n    };\n    frame.render_widget(\n        Paragraph::new(keys).style(palette.muted),\n        Rect::new(\n            2,\n            frame.area().height.saturating_sub(1),\n            frame.area().width.saturating_sub(4),\n            1,\n        ),\n    );\n    if tend.can_toggle_scope() {\n        frame.render_widget(\n            Paragraph::new(if tend.show_all {\n                \"all · a this repo\"\n            } else {\n                \"this repo · a all\"\n            })\n            .style(palette.muted),\n            Rect {\n                height: 1.min(area.height),\n                ..area\n            },\n        );\n    }\n    let mut area = tend.scope_body(area);\n    if !tend.detail\n        && !tend.is_linking()\n        && tend.connection_scope()\n        && let Some(thoughts) = &tend.thoughts\n        && !thoughts.summary().is_empty()\n    {\n        frame.render_widget(\n            Paragraph::new(thoughts.summary()).style(palette.ink),\n            Rect {\n                height: 2.min(area.height),\n                ..area\n            },\n        );\n        area.y = area.y.saturating_add(3);\n        area.height = area.height.saturating_sub(3);\n    }\n    let stale_empty =\n        tend.sessions.is_empty() && tend.unreadable == 0 && tend.error.is_none() && !tend.current;\n    if tend.pending || tend.want.is_some() || stale_empty {\n        let status = if tend.still_reading {\n            \"Still reading your sessions. Esc goes back.\"\n        } else {\n            \"Reading your sessions. Esc goes back.\"\n        };\n        frame.render_widget(Paragraph::new(status).style(palette.muted), area);\n        return;\n    }\n    if tend.error.is_some() {\n        frame.render_widget(\n            Paragraph::new(\"Saved session unavailable. F1 then h for details.\").style(palette.ink),\n            area,\n        );\n        return;\n    }\n    if tend.sessions.is_empty() {\n        frame.render_widget(\n            Paragraph::new(if let Some(message) = tend.repo_empty_message() {\n                message\n            } else if tend.unreadable > 0 {\n                format!(\n                    \"{} couldn't be read, so nothing can be listed. Esc goes back.\",\n                    records(tend.unreadable)\n                )\n            } else if tend.ended > 0 {\n                format!(\n                    \"No active goals. {} ended not shown. Confirm a goal in think to start one.\",\n                    tend.ended\n                )\n            } else {\n                \"No saved sessions yet. Confirm a goal in think to start one.\".into()\n            })\n            .style(palette.muted)\n            .wrap(Wrap { trim: false }),\n            area,\n        );\n        if tend.ended > 0 || tend.links.is_err() || tend.repo_unknown > 0 && tend.unreadable > 0 {\n            garden::render_note(frame, tend, area, palette);\n        }\n        return;\n    }\n    if tend.detail {\n        let session = &tend.sessions[tend.selected];\n        tend.page = render_saved_goal(\n            frame,\n            &mut tend.scroll,\n            area,\n            palette,\n            SavedGoal {\n                goal: &session.goal,\n                next: session.stage.next(),\n                notice: &tend.notice,\n                saved: false,\n            },\n        );\n        return;\n    }\n    let now = SystemTime::now()\n        .duration_since(UNIX_EPOCH)\n        .ok()\n        .map(|d| d.as_secs());\n    garden::render(frame, tend, area, palette, now);\n}\nfn records(n: usize) -> String {\n    if n == 1 {\n        \"1 saved record\".into()\n    } else {\n        format!(\"{n} saved records\")\n    }\n}\n\npub(super) fn timestamp(value: &str) -> Option<u64> {\n    let number = |a, b| value.get(a..b)?.parse::<i64>().ok(…2470 tokens truncated…e, turns=[], checks=[], goal=label)\n            if name != 'legacy':\n                record['repo'] = str(root / ('TEST-repo-a' if name == 'a' else 'TEST-repo-b')) if name != 'outside' else None\n            (root / 'TEST-records' / f'{name}.json').write_text(json.dumps(record))\n        if incomplete:\n            for index in range(unreadable):\n                broken = root / 'TEST-sessions' / f'TEST-unreadable-{index}'\n                broken.mkdir()\n                (broken / 'ledger.json').write_text('not JSON')\n        if place == 'broken':\n            (root / 'TEST-records' / 'TEST-broken.json').write_text('not JSON')\n        host = root / 'TEST-never-pi'\n        host.write_text('#!/bin/sh\\ntouch \"' + str(root / 'TEST-provider-ran') + '\"\\nexit 86\\n')\n        host.chmod(0o755)\n        before = {str(p): p.read_bytes() for folder in ['TEST-sessions', 'TEST-records']\n                  for p in (root / folder).rglob('*') if p.is_file()}\n        cwd = root / {'inside': 'TEST-repo-a', 'broken': 'TEST-repo-a', 'empty': 'TEST-repo-empty', 'incomplete': 'TEST-repo-a', 'incomplete-all': 'TEST-repo-a'}.get(place, '.')\n        terminal = Terminal(root, cwd, width, height, no_color)\n        try:\n            terminal.wait(lambda screen: '1  think' in screen)\n            terminal.send(b'2', 'this repo · a all' if not outside else 'esc back')\n            if incomplete:\n                screen = terminal.wait(lambda screen: 'saved record' in screen)\n                assert_incomplete(screen, unreadable)\n                if not outside:\n                    assert 'Press a for all goals.' in ' '.join(line.strip() for line in screen.splitlines()), screen\n                    screen = terminal.send(b'a', 'all · a this repo')\n                    if place == 'incomplete':\n                        terminal.selected(LABELS[1])\n                    else:\n                        assert_incomplete(screen, unreadable)\n                    screen = terminal.send(b'a', 'this repo · a all')\n                    assert_incomplete(screen, unreadable)\n            elif place in ('empty', 'broken'):\n                empty_message = f'{5 if place == \"broken\" else 2} goals have no readable repo record.'\n                screen = terminal.wait(lambda screen: empty_message in screen)\n                assert 'No active goals' not in screen, screen\n                terminal.send(b'a', 'all · a this repo')\n            elif place == 'inside':\n                screen = terminal.selected(LABELS[0])\n                assert all(label not in screen for label in LABELS[1:]), screen\n                os.write(terminal.master, b'j')\n                terminal.selected(LABELS[0])\n                # The scope row must not shift pointer hits away from the painted label.\n                row, line = next((row, line) for row, line in enumerate(screen.splitlines()[4:-4], 4)\n                                 if LABELS[0] in line)\n                column = line.index(LABELS[0]) + 2\n                click = (f'\\x1b[<0;{column+1};{row+1}M\\x1b[<0;{column+1};{row+1}m').encode()\n                os.write(terminal.master, click * 2)\n                terminal.wait(lambda screen: 'r history' in screen)\n                terminal.send(b'\\x1b', 'this repo · a all')\n                terminal.send(b'a', 'all · a this repo')\n            else:\n                assert 'this repo' not in terminal.screen.text()\n                os.write(terminal.master, b'a')\n            if incomplete:\n                assert not (root / 'TEST-provider-ran').exists()\n                assert not (root / 'TEST-links').exists()\n                assert {str(p): p.read_bytes() for folder in ['TEST-sessions', 'TEST-records']\n                        for p in (root / folder).rglob('*') if p.is_file()} == before\n                terminal.send(b'\\x1b', '1  think')\n                os.write(terminal.master, b'q')\n                terminal.wait_exit()\n                assert terminal.process.returncode == 0\n                print(json.dumps(dict(width=width, height=height, no_color=no_color,\n                    journey='repo-scope/' + place, unreadable=unreadable, provider_calls=0, fixtures='temporary TEST roots')))\n                return\n            terminal.selected(LABELS[0])\n            # Navigate every goal rather than requiring all labels to fit at once.\n            for label in LABELS[1:]:\n                os.write(terminal.master, b'j')\n                terminal.selected(label)\n            os.write(terminal.master, b'j')\n            terminal.selected(LABELS[-1])\n            for label in reversed(LABELS[:-1]):\n                os.write(terminal.master, b'k')\n                terminal.selected(label)\n            if place == 'inside':\n                terminal.send(b'l', 'enter link')\n                terminal.send(b'j', 'TEST A goal needs TEST B goal')\n                os.write(terminal.master, b'a')  # Linking keeps its exact source/target.\n                terminal.send(b'\\r', KEYS)\n                terminal.wait(lambda screen: 'needs TEST B goal · not ready' in screen)\n                links = root / 'TEST-links' / 'needs.json'\n                expected = dict(version=1, needs=[dict(goal='a', needs='b')])\n                assert json.loads(links.read_text()) == expected\n                saved_links = links.read_bytes()\n                terminal.send(b'a', 'this repo · a all')\n                screen = terminal.selected(LABELS[0])\n                assert 'needs TEST B goal · not ready' in screen, screen\n                assert LABELS[1] not in '\\n'.join(screen.splitlines()[4:-4]), screen\n                assert all(label not in screen for label in LABELS[2:]), screen\n                # Detail and help do not toggle; Shape's s remains a separate action.\n                terminal.send(b'\\r', 'r history')\n                os.write(terminal.master, b'a')\n                terminal.send(b'\\x1b', 'this repo · a all')\n                terminal.send(b'\\x1bOP', 'Right now')\n                os.write(terminal.master, b'a')\n                terminal.send(b'\\x1b', 'this repo · a all')\n                assert links.read_bytes() == saved_links\n            elif place in ('empty', 'broken'):\n                terminal.send(b'a', empty_message)\n            assert not (root / 'TEST-provider-ran').exists()\n            assert {str(p): p.read_bytes() for folder in ['TEST-sessions', 'TEST-records']\n                    for p in (root / folder).rglob('*') if p.is_file()} == before\n            if place != 'inside':\n                assert not (root / 'TEST-links').exists()\n            terminal.send(b'\\x1b', '1  think')\n            os.write(terminal.master, b'q')\n            terminal.wait_exit()\n            assert terminal.process.returncode == 0\n            print(json.dumps(dict(width=width, height=height, no_color=no_color,\n                journey='repo-scope/' + place, provider_calls=0, fixtures='temporary TEST roots')))\n        finally:\n            terminal.close()\n\n\nif __name__ == '__main__':\n    for size in [(80, 24), (100, 30)]:\n        for no_color in [False, True]:\n            for place in ['incomplete-outside', 'incomplete-all']:\n                for unreadable in [1, 2]:\n                    journey(*size, no_color, place, unreadable)\n            for place in ['incomplete', 'inside', 'outside', 'empty', 'broken']:\n                journey(*size, no_color, place)\n==> text 3/3 <==\n\"\"\"Tend journeys with synthetic sessions and explicit TEST links; no model calls.\"\"\"\nfrom terminal_process import wait_output\nimport base64, fcntl, json, os, re, select, struct, tempfile, termios, time\nimport test_launch as subprocess\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom vt_screen import Screen\n\nREPO = Path(__file__).resolve().parents[1]\nGOAL = ('I can read a calm dark theme while preserving every confirmed goal line and keeping a clear next step with manual control.\\n'\n        'Why: I work at night.\\nDone when: Nothing strands me.\\n'\n        'Must: Keep manual control.\\nMust not: Run agents.')\n\n\nGARDEN_KEYS = '↑↓←→ move   enter open   l link   esc back'\nLINK_KEYS = '↑↓←→ pick   enter link   esc cancel'\nUNLINK_KEYS = '↑↓←→ pick   enter unlink   esc cancel'\nLABELS = ['Calm theme', 'Clear next step', 'Manual control', 'Keep originals',\n          'Quiet garden', 'Readable goals', 'Local records']\n\n\ndef journey(width, height, kind='garden'):\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-tend-') as directory:\n        root = Path(directory).resolve()\n        sessions = root / 'TEST-sessions'\n        now = datetime.now(timezone.utc)\n        count = (30 if kind == 'whole-graph' else {160: 8, 320: 16}.get(width, 7)) + 1\n        labels = LABELS + [f'Garden goal {i+1:02}' for i in range(len(LABELS), count)]\n        states = [('saved', 'active', None), ('drafted', 'active', 'status: draft'),\n                  ('ready', 'active', 'status: confirmed for intake'),\n                  ('ended', 'completed', 'status: confirmed for intake')]\n        states += [(f'goal-{i:02}', 'active', None) for i in range(4, count)]\n        if kind == 'linked-rings':\n            states = states[:2] + states[3:4]\n            labels = labels[:2] + labels[3:4]\n            count = len(states)\n        for i, (name, status, seed) in enumerate(states):\n            path = sessions / name\n            path.mkdir(parents=True)\n            (path / 'ledger.json').write_text(json.dumps(dict(session_id=name, status=status, goal=labels[i]+'\\n'+GOAL,\n                updated_at=(now-timedelta(hours=i)).isoformat())))\n            if seed: (path / 'seed-contract.md').write_text(seed+'\\n# Synthetic fixture only\\n')\n        ended_goal = labels.pop(next(i for i, (_, status, _) in enumerate(states) if status == 'completed'))\n        count -= 1\n        if kind == 'unreadable':\n            broken = sessions / 'unreadable'\n            broken.mkdir()\n            (broken / 'ledger.json').write_text('not JSON')\n        before = {str(p): p.read_bytes() for p in sessions.rglob('*') if p.is_file()}\n        host = root / 'never-run-pi'\n        host.write_text('#!/bin/sh\\necho unexpected > provider-was-run\\nexit 86\\n')\n        host.chmod(0o755)\n        def launch():\n            master, slave = os.openpty()\n            fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', height, width, 0, 0))\n            process = subprocess.Popen([str(REPO/'target/debug/tinkery'), '--home', '--shape-pi', '--record-root', str(root / 'TEST-records'),\n                '--model', 'test/model', '--seed-session-root', str(sessions),\n                '--link-root', str(root / 'TEST-links'),\n                '--pi-command', str(host)], stdin=slave, stdout=slave, stderr=slave, cwd=root,\n                env=subprocess.environment({**os.environ, 'TERM': 'xterm-256color', 'TINKERY_NODE': '/tinkery-TEST-no-node'}))\n            return process, master, slave, Screen(width, height), bytearray()\n\n        process, master, slave, screen, raw = launch()\n\n        def feed():\n            data = os.read(master, 65536)\n            raw.extend(data)\n            screen.feed(data)\n\n        def wait(predicate, after=0):\n            deadline = time.monotonic()+5\n            def consume_wait_output(chunk):\n                raw.extend(chunk)\n                screen.feed(chunk)\n            for returncode in wait_output(master, process, consume_wait_output, deadline):\n                if predicate() and screen.ready(after): return\n                if returncode is not None: break\n            raise AssertionError(screen.text())\n\n        def send(data, text):\n            os.write(master, data)\n            wait(lambda: text in screen.text())\n\n        def copies():\n            return re.findall(rb'\\x1b\\]52;c;([^\\x07\\x1b]+)(?:\\x07|\\x1b\\\\)', bytes(raw))\n\n        def ordinary():\n            assert str(root) not in screen.text() and 'any harness' not in screen.text(), screen.text()\n\n        def garden_lines():\n            return screen.text().splitlines()[3:height-4]\n\n        def position(label):\n            found = [(line.index(label), row+3) for row, line in enumerate(garden_lines()) if label in line]\n            assert len(found) == 1, (label, screen.text())\n            return found[0]\n\n        def selected(index):\n            lines = screen.text().splitlines()\n            return (lines[-1].strip() == GARDEN_KEYS\n                    and sum(line.count('› ') for line in garden_lines()) == 1\n                    and any('› '+labels[index] in line for line in garden_lines())\n                    and lines[height-3].startswith('  '+labels[index]))\n\n        def move(key, index):\n            os.write(master, key)\n            wait(lambda: selected(index))\n\n        def click(column, row):\n            return (f'\\x1b[<0;{column+1};{row+1}M'\n                    f'\\x1b[<0;{column+1};{row+1}m').encode()\n\n        try:\n            wait(lambda: '1  think' in screen.text())\n            send(b'2', GARDEN_KEYS)\n            wait(lambda: selected(0))\n            assert ended_goal not in screen.text(), screen.text()\n            assert screen.text().splitlines()[height-4].strip().startswith('1 ended not shown'), screen.text()\n            visible = [label for label in labels if any(label in line for line in garden_lines())]\n            assert any('\\u2801' <= char <= '\\u28ff' for line in garden_lines() for char in line), screen.text()\n            assert 'page ' not in screen.text(), screen.text()\n            if width == 100 and kind == 'garden':\n                print('TEST Tend 100×30 screen:\\n'+screen.text())\n            line = screen.text().splitlines()[height-3]\n            assert 'goal saved · ' in line, line\n            assert 'Why:' not in screen.text() and 'Done when:' not in screen.text()\n            assert 'I can read' not in screen.text(), screen.text()\n            ordinary()\n            if kind == 'held-lock':\n                link_root = root / 'TEST-links'\n                link_root.mkdir()\n                link_file = link_root / 'needs.json'\n                saved = b'{\"version\":1,\"needs\":[]}'\n                link_file.write_bytes(saved)\n                with (link_root / 'needs.lock').open('w') as lock:\n                    fcntl.flock(lock, fcntl.LOCK_EX)\n                    send(b'l', LINK_KEYS)\n                    send(b'j', 'Calm theme needs Clear next step')\n                    start = time.monotonic()\n                    send(b'\\r', \"Links couldn't be saved, so nothing changed. F1 then h for details.\")\n                    assert time.monotonic()-start < 3\n                    send(b'\\x1bOP', 'Right now')\n                    send(b'h', 'another Tinkery is saving links')\n                    send(b'\