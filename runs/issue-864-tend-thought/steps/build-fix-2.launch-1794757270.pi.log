test callers.\nCalledProcessError = subprocess.CalledProcessError\nTimeoutExpired = subprocess.TimeoutExpired\nPIPE = subprocess.PIPE\nDEVNULL = subprocess.DEVNULL\nSTDOUT = subprocess.STDOUT\n\n_home = None\n\n\nclass UnsafeTestHome(ValueError):\n    \"\"\"The requested process environment is not an isolated TEST home.\"\"\"\n\n\ndef environment(base=None, *, home=None):\n    \"\"\"Explicitly select a TEST home; by default allocate one for this test process.\n\n    Caller-selected homes must already exist. Preserve tool caches, not application\n    data, when changing HOME so fixture builds need no toolchain installation.\n    \"\"\"\n    global _home\n    env = dict(os.environ if base is None else base)\n    real_home = pwd.getpwuid(os.getuid()).pw_dir\n    env.setdefault('CARGO_HOME', str(Path(real_home) / '.cargo'))\n    env.setdefault('RUSTUP_HOME', str(Path(real_home) / '.rustup'))\n    if home is None:\n        if _home is None:\n            _home = tempfile.TemporaryDirectory(prefix='tinkery-TEST-launch-home-')\n            atexit.register(_home.cleanup)\n        home = _home.name\n    env['HOME'] = str(home)\n    env.setdefault('TINKERY_NODE', '/tinkery-TEST-no-node')\n    return _checked_environment(env, create=True)\n\n\ndef _checked_environment(env, *, create=False):\n    \"\"\"Refuse unsafe HOME before any subprocess API can start an executable.\"\"\"\n    if env is None or not env.get('HOME'):\n        raise UnsafeTestHome('Test launches require an explicit temporary TEST HOME.')\n    home = Path(env['HOME'])\n    if not home.is_absolute():\n        raise UnsafeTestHome('Test HOME must be absolute.')\n    home = home.resolve()\n    real_home = Path(pwd.getpwuid(os.getuid()).pw_dir).resolve()\n    if home == real_home:\n        raise UnsafeTestHome('Refusing to launch with the password-database real home.')\n    temporary_roots = (Path(tempfile.gettempdir()).resolve(), Path('/tmp').resolve(),\n                       Path('/var/tmp').resolve(),\n                       (Path(__file__).resolve().parents[1] / 'target/tmp').resolve())\n    if (not any(home.is_relative_to(root) for root in temporary_roots)\n            or not any('TEST' in part for part in home.parts)):\n        raise UnsafeTestHome('Test HOME must be a temporary TEST folder.')\n    if create:\n        home.mkdir(parents=True, exist_ok=True)\n    if not home.is_dir():\n        raise UnsafeTestHome('Test HOME must be an existing temporary TEST folder.')\n    return dict(env)\n\n\ndef Popen(*args, env=None, **kwargs):\n    \"\"\"Start a process only with a guarded TEST HOME, including PTY launches.\"\"\"\n    return subprocess.Popen(*args, env=_checked_environment(env), **kwargs)\n\n\ndef run(*args, env=None, **kwargs):\n    \"\"\"Run a bounded test command with the same launch guard.\"\"\"\n    return subprocess.run(*args, env=_checked_environment(env), **kwargs)\n\n\ndef check_output(*args, env=None, **kwargs):\n    \"\"\"Capture test output with the same launch guard.\"\"\"\n    return subprocess.check_output(*args, env=_checked_environment(env), **kwargs)\n\n\nif __name__ == '__main__' and len(sys.argv) > 1:\n    raise SystemExit(run(sys.argv[1:], env=dict(os.environ)).returncode)\n==> text 2/6 <==\n#!/usr/bin/env python3\n\"\"\"Execute the single authoritative AGENTS full-check block in an isolated TEST home.\n\nKeeps the existing installed compiler/cache locations; never installs tools or uses\noperator application roots. No external skill checkout is needed.\n\"\"\"\nimport os\nfrom pathlib import Path\nimport re\nimport sys\nimport tempfile\n\nROOT = Path(__file__).resolve().parents[1]\nsys.path.insert(0, str(ROOT / 'tests'))\nimport test_launch\n\n\ndef block():\n    source = (ROOT / 'AGENTS.md').read_text()\n    markers = ['<!-- full-check:start -->', '<!-- full-check:end -->']\n    if any(source.count(marker) != 1 for marker in markers):\n        raise ValueError('Expected exactly one pair of full-check markers')\n    section = source.split(markers[0], 1)[1].split(markers[1], 1)[0]\n    blocks = re.findall(r'```bash\\n(.*?)\\n```', section, re.S)\n    if len(blocks) != 1 or not blocks[0].strip():\n        raise ValueError('Expected exactly one nonempty documented verification block')\n    return blocks[0] + '\\n'\n\n\ndef main():\n    command = block()\n    with tempfile.TemporaryDirectory(prefix='tinkery-TEST-full-check-') as directory:\n        home = Path(directory) / 'HOME'\n        home.mkdir()\n        env = dict(os.environ)\n        installed_home = Path(env['HOME'])\n        env.setdefault('CARGO_HOME', str(installed_home / '.cargo'))\n        env.setdefault('RUSTUP_HOME', str(installed_home / '.rustup'))\n        env.pop('SEED_ME_TEST_SKILL', None)\n        # A tink-sdlc build step marks its worker env; label tests run outside that session.\n        env.pop('TINK_SDLC_STEP_SESSION', None)\n        env.update(HOME=str(home), PYTHONDONTWRITEBYTECODE='1', TINKERY_NODE='/tinkery-TEST-no-node')\n        script = Path(directory) / 'full-check.sh'\n        script.write_text(command)\n        print('Exact AGENTS full-check; temporary TEST HOME', flush=True)\n        test_launch.run(['bash', '-euo', 'pipefail', str(script)], cwd=ROOT, env=env, check=True)\n\n\nif __name__ == '__main__':\n    main()\n==> text 3/6 <==\n                        y.round() as i32 - i32::from(event.row),\n                    ));\n                }\n            }\n        }\n        if matches!(\n            event.kind,\n            MouseEventKind::Down(MouseButton::Left)\n                | MouseEventKind::Drag(MouseButton::Left)\n                | MouseEventKind::Up(MouseButton::Left)\n        ) && let Some((x, y)) = self.pointer_offset\n        {\n            event.column = (i32::from(event.column) + x).clamp(0, i32::from(u16::MAX)) as u16;\n            event.row = (i32::from(event.row) + y).clamp(0, i32::from(u16::MAX)) as u16;\n        }\n        if matches!(event.kind, MouseEventKind::Up(MouseButton::Left)) {\n            self.pointer_offset = None;\n        }\n        // Tend's identity-aware, injected clock owns double clicks, not graf's OpenFile.\n        self.mouse.last_click_time = None;\n        let _ = handle_graph_mouse(state, event, self.area, &mut self.mouse, &settings(), false);\n        if let Some(index) = label_node {\n            let mut state = state.write();\n            state.selection.select_only(index);\n            state.dragging_node = Some(index);\n            self.mouse.is_panning = false;\n        }\n        if !matches!(event.kind, MouseEventKind::Down(MouseButton::Left))\n            || !self.area.contains(Position::new(event.column, event.row))\n        {\n            return None;\n        }\n        let guard = state.read();\n        let index = guard.selection.primary?;\n        Some(guard.simulation.get_graph()[index].data.id.clone())\n    }\n\n    pub(super) fn release(&mut self) {\n        self.mouse = GraphMouseState::default();\n        self.pointer_offset = None;\n        if let Some(state) = &self.state {\n            let mut state = state.write();\n            state.dragging_node = None;\n            state.drag_target = None;\n        }\n    }\n\n    pub(super) fn draw(\n        &mut self,\n        frame: &mut Frame,\n        palette: Palette,\n        selected: &str,\n        source: &str,\n        linking: bool,\n    ) {\n        let Some(shared) = self.state.clone() else {\n            frame.render_widget(\n                Paragraph::new(\"Goals couldn't be drawn. F1 then h for details; Esc goes back.\")\n                    .style(palette.muted),\n                self.area,\n            );\n            return;\n        };\n        let mut state = shared.write();\n        let graph = state.simulation.get_graph();\n        let selected_index = graph.node_indices().find(|&i| graph[i].data.id == selected);\n        let source_index = graph.node_indices().find(|&i| graph[i].data.id == source);\n        if self.followed.as_deref() != Some(selected) {\n            if let Some(index) = selected_index {\n                let node = &graph[index];\n                let (x, y) = state.viewport.world_to_screen(\n                    f64::from(node.location.x),\n                    f64::from(node.location.y),\n                    self.area,\n                );\n                if x < f64::from(self.area.x + 3)\n                    || x >= f64::from(self.area.right().saturating_sub(3))\n                    || y < f64::from(self.area.y + 1)\n                    || y >= f64::from(self.area.bottom().saturating_sub(1))\n                {\n                    let (x, y) = (node.location.x, node.location.y);\n                    state.viewport.center_on_node(x, y);\n                }\n            }\n            self.followed = Some(selected.to_owned());\n        }\n        state.selection.clear();\n        if let Some(index) = source_index {\n            state.selection.select_only(index);\n        }\n        let mut settings = settings();\n        settings.visual.colors.node_color = Some(palette.ink.fg.unwrap_or(Color::Reset));\n        settings.visual.colors.edge_color = Some(palette.muted.fg.unwrap_or(Color::Reset));\n        settings.visual.colors.selection_ring_color = Some(palette.jade.fg.unwrap_or(Color::Reset));\n        settings.visual.colors.background_color = Some(palette.ink.bg.unwrap_or(Color::Reset));\n        let theme = ThemeColors::resolve(&settings);\n        {\n            let mut cache = state.render_cache.lock();\n            let ink = palette.ink.fg.unwrap_or(Color::Reset);\n            let jade = palette.jade.fg.unwrap_or(Color::Reset);\n            let appearance_changed =\n                self.appearance\n                    .as_ref()\n                    .is_none_or(|(old_ink, old_jade, old_source)| {\n                        *old_ink != ink || *old_jade != jade || old_source != source\n                    });\n            if cache.topology_dirty || appearance_changed {\n                cache.rebuild_topology(state.simulation.get_graph(), &settings, &theme, false);\n                if let Some(index) = source_index {\n                    cache.node_own_color.insert(index, jade);\n                }\n                self.appearance = Some((ink, jade, source.to_owned()));\n            }\n        }\n        draw_graph_view(\n            frame,\n            self.area,\n            &state,\n            &settings,\n            &theme,\n            &FeatureFlags {\n                show_legend: false,\n                grid: false,\n                show_minimap: false,\n                show_status_bar: false,\n            },\n        );\n        // Canvas shapes carry colour, not weight. Apply the selection's weight to its ring cells.\n        let cache = state.render_cache.lock();\n        if let Some(node) = cache.nodes.iter().find(|n| n.is_selected) {\n            let aspect = f64::from(self.area.width) / f64::from(self.area.height.max(1));\n            let xb = state.viewport.x_bounds(aspect);\n            let yb = state.viewport.y_bounds(aspect);\n            let project = |x: f64, y: f64| {\n                (\n                    f64::from(self.area.x)\n                        + (x - xb[0]) / (xb[1] - xb[0])\n                            * f64::from(self.area.width.saturating_sub(1)),\n                    f64::from(self.area.y)\n                        + (yb[1] - y) / (yb[1] - yb[0])\n                            * f64::from(self.area.height.saturating_sub(1)),\n                )\n            };\n            let r = node.radius + 1.5;\n            let (left, top) = project(node.x - r, node.y + r);\n            let (right, bottom) = project(node.x + r, node.y - r);\n            for y in top.floor().max(f64::from(self.area.y)) as u16\n                ..=bottom.ceil().min(f64::from(self.area.bottom() - 1)) as u16\n            {\n                for x in left.floor().max(f64::from(self.area.x)) as u16\n                    ..=right.ceil().min(f64::from(self.area.right() - 1)) as u16\n                {\n                    frame.buffer_mut()[(x, y)].modifier.insert(Modifier::BOLD);\n                }\n            }\n        }\n        drop(cache);\n        self.labels(frame, &state, palette, source, selected, linking);\n    }\n\n\n[100 more lines in file. Use offset=430 to continue.]\n==> text 4/6 <==\ncorrection.rs-145-         };\ncorrection.rs-146-         let bytes = serde_json::to_vec(&stored).map_err(|e| e.to_string())?;\ncorrection.rs-147-         let mut file = tempfile::NamedTempFile::new_in(&self.store).map_err(|e| e.to_string())?;\ncorrection.rs-148-         file.write_all(&bytes).map_err(|e| e.to_string())?;\ncorrection.rs:149:         file.as_file().sync_all().map_err(|e| e.to_string())?;\ncorrection.rs-150-         file.persist(self.correction_file())\ncorrection.rs-151-             .map_err(|e| e.to_string())?;\ncorrection.rs:152:         fs::File::open(&self.store).and_then(|f| f.sync_all()).map_err(|e| format!(\"Correction replaced, but persistence is uncertain. Reopen before another change: {e}\"))\ncorrection.rs-153-     }\ncorrection.rs-154- }\n==> text 5/6 <==\n## Design score\n\nJohn Ousterhout's *A Philosophy of Software Design* supplies these eight questions.\nStructural PRs name the rows they move.\n\n| # | Question |\n| --- | --- |\n| 1 | Can each module be described in one sentence? |\n| 2 | Are interfaces simpler than implementations? |\n| 3 | Can an implementation change without touching callers? |\n| 4 | Do interface comments describe the abstraction? |\n| 5 | Is design discussion part of review? |\n| 6 | Does each module hide an important decision? |\n| 7 | Can a newcomer see the boundaries without reading code? |\n| 8 | Is design improvement part of ordinary work? |\n\n## Limits enforced by `tests/architecture.rs`\n\n| Limit | Today |\n| --- | --- |\n| Phase reaches across phases | none allowed |\n| `BrainDump` fields / `pub` fields | 13 / 0 |\n| Long non-test source lines | See `LONG_LINE` and `LONG_LINES` in [the owning check](../../tests/architecture.rs) |\n| Test calls to `Conversation`'s test-only accessors | 77 |\n| Library files without a `//!` comment, `pub` items without a doc comment | none allowed |\n\nChecks fail whenever code differs from a limit, even by improving it. Lower improved\nlimits in the same PR.\n==> text 6/6 <==\n            os.write(term.master, b'\\x1b[6~'*30)\n            flow.wait(term, 'confirm')\n            flow.send(term, b'confirm\\r', 'Saved.')\n            records = [json.loads(p.read_bytes()) for p in (root/'records').glob('*.json')]\n            record = next(r for r in records if r['origin'] == 'live')\n            assert record['turns'][0]['text'].encode() == WORDS.encode()\n            assert record['repo'] == str(repo)\n            assert len(list((root/'sessions').iterdir())) == 3\n            assert saved(root)[0].read_bytes() == thought\n        finally:\n            term.close()\n\n\nif __name__ == '__main__':\n    for size in [(80, 24), (100, 30)]:\n        journey(size)\n        unwritable(size)\n        promotion(size)\n        unreadable(size)\n    print('Thought journeys passed at 80x24 and 100x30 without colour. Local stubs only.')\n"}],"details":{"calls":[{"id":"call_a2b7c6d44c20440c9b93777ce7170e73|ctc_0e8cd1afdc37c664016af9d2d3fb2887d1bfb8dae57afc6e40/1","name":"read","args":"{\"path\":\"tests/test_launch.py\",\"offset\":1,\"limit\":110}","status":"ok","durationMs":0.5204579999990528},{"id":"call_a2b7c6d44c20440c9b93777ce7170e73|ctc_0e8cd1afdc37c664016af9d2d3fb2887d1bfb8dae57afc6e40/2","name":"read","args":"{\"path\":\"scripts/full-check.py\",\"offset\":1,\"limit\":85}","status":"ok","durationMs":0.3406250000043656},{"id":"call_a2b7c6d44c20440c9b93777ce7170e73|ctc_0e8cd1afdc37c664016af9d2d3fb2887d1bfb8dae57afc6e40/3","name":"read","args":"{\"path\":\"src/tend/graph.rs\",\"offset\":270,\"limit\":160}","status":"ok","durationMs":0.46349999999802094},{"id":"call_a2b7c6d44c20440c9b93777ce7170e73|ctc_0e8cd1afdc37c6